#!/usr/bin/env python3
"""Safely enter a project-specific OMP session on a remote development box.

Committed history and uncommitted working snapshots travel through negotiated
Git object transport. Every transfer is guarded by the exact HEAD and tree
recorded after the last successful synchronization.
"""

from __future__ import annotations

import argparse

import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
from urllib.parse import parse_qsl, urlsplit

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
from ompup.environment import (  # noqa: E402
    CONFIG_ROOT,
    bootstrap_auth,
    build_release,
    cleanup_release,
    ensure_environment,
    environment_status,
    format_environment_status,
    load_environment_config,
    preserved_environment_status,
    select_hosts,
    sync_environment,
)

from ompup.hosts import (  # noqa: E402
    HostChoice,
    HostProbe,
    HostSelectionError,
    choose_host,
    find_host,
    format_probe,
    load_hosts,
    pin_host,
    pinned_host,
    probe_hosts,
    project_profile,
    resolve_project,
    unpin_host,
)

VERSION = "0.6.0"
LEGACY_HOST = os.environ.get("OMPUP_HOST", "")
REMOTE_ROOT = os.environ.get("OMPUP_REMOTE_ROOT", "Projects").strip("/")
LAUNCH_OVERRIDE = os.environ.get("OMPUP_CMD", "")
LAUNCH = ""
REMOTE = ""
SSH_CONTROL_PATH = ""
PRESERVED_DIRS = {
    "node_modules",
    ".venv",
    "venv",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    "target",
    "dist",
    "build",
    ".next",
    ".turbo",
    ".cache",
}
SENSITIVE_NAMES = {".env", ".envrc", ".netrc", ".npmrc", ".pypirc"}

REMOTE_STATE_SCRIPT = r"""
set -euo pipefail
repo="$HOME/$1"
git_dir=$(git -C "$repo" rev-parse --absolute-git-dir)
idx=$(mktemp)
rm -f "$idx"
trap 'rm -f "$idx"' EXIT
if [ -f "$git_dir/index" ]; then cp "$git_dir/index" "$idx"; fi
GIT_INDEX_FILE="$idx" git -C "$repo" add -A -- . >/dev/null
head=$(git -C "$repo" rev-parse --verify HEAD 2>/dev/null || printf '0000000000000000000000000000000000000000')
tree=$(GIT_INDEX_FILE="$idx" git -C "$repo" write-tree)
printf '%s:%s\n' "$head" "$tree"
"""

READ_BASELINE_SCRIPT = r"""
set -euo pipefail
path="$HOME/.local/state/ompup/$1.state"
[ -f "$path" ] || exit 3
cat "$path"
"""

WRITE_BASELINE_SCRIPT = r"""
set -euo pipefail
umask 077
dir="$HOME/.local/state/ompup"
mkdir -p "$dir"
tmp=$(mktemp "$dir/.state.XXXXXX")
trap 'rm -f "$tmp"' EXIT
printf '%s\n%s\n' "$2" "$3" > "$tmp"
mv "$tmp" "$dir/$1.state"
trap - EXIT
"""

BOOTSTRAP_SCRIPT = r"""
set -euo pipefail
target="$HOME/$1"
branch="$2"
origin="$3"
[ ! -e "$target" ] || { echo 'remote project path already exists' >&2; exit 4; }
mkdir -p "$(dirname "$target")"
cleanup() { rm -rf "$target"; }
trap cleanup ERR INT TERM
git init -q -b "$branch" "$target"
if [ -n "$origin" ]; then git -C "$target" remote add origin "$origin"; fi
trap - ERR INT TERM
"""

REMOVE_REMOTE_PROJECT_SCRIPT = r"""
set -euo pipefail
target="$HOME/$1"
[ -d "$target/.git" ] || { echo 'refusing to remove a non-repository path' >&2; exit 4; }
rm -rf "$target"
"""

APPLY_COMMIT_SCRIPT = r"""
set -euo pipefail
repo="$HOME/$1"
incoming_ref="$2"
branch="$3"
expected_old="$4"
expected_new="$5"
current_branch=$(git -C "$repo" symbolic-ref --quiet --short HEAD)
if [ "$current_branch" != "$branch" ]; then
  printf 'branch mismatch: remote=%s local=%s\n' "$current_branch" "$branch" >&2
  exit 6
fi
current=$(git -C "$repo" rev-parse --verify HEAD 2>/dev/null || printf '0000000000000000000000000000000000000000')
if [ "$current" != "$expected_old" ]; then
  printf 'remote HEAD changed during transfer: expected=%s actual=%s\n' "$expected_old" "$current" >&2
  exit 7
fi
incoming=$(git -C "$repo" rev-parse --verify "$incoming_ref^{commit}")
if [ "$incoming" != "$expected_new" ]; then
  printf 'incoming commit mismatch: expected=%s actual=%s\n' "$expected_new" "$incoming" >&2
  exit 8
fi
if [ "$current" != '0000000000000000000000000000000000000000' ]; then
  git -C "$repo" merge-base --is-ancestor "$current" "$incoming"
fi
git -C "$repo" reset --hard -q "$incoming"
git -C "$repo" update-ref -d "$incoming_ref"
"""

APPLY_SNAPSHOT_SCRIPT = r"""
set -euo pipefail
repo="$HOME/$1"
incoming_ref="$2"
expected_tree="$3"
expected_head="$4"
current=$(git -C "$repo" rev-parse --verify HEAD 2>/dev/null || printf '0000000000000000000000000000000000000000')
if [ "$current" != "$expected_head" ]; then
  printf 'remote HEAD changed before snapshot apply: expected=%s actual=%s\n' "$expected_head" "$current" >&2
  exit 7
fi
incoming=$(git -C "$repo" rev-parse --verify "$incoming_ref^{tree}")
if [ "$incoming" != "$expected_tree" ]; then
  printf 'incoming snapshot mismatch: expected=%s actual=%s\n' "$expected_tree" "$incoming" >&2
  exit 8
fi
git -C "$repo" read-tree --dry-run --reset -u "$incoming_ref"
git -C "$repo" read-tree --reset -u "$incoming_ref"
git -C "$repo" update-ref -d "$incoming_ref"
"""

CREATE_SNAPSHOT_REF_SCRIPT = r"""
set -euo pipefail
repo="$HOME/$1"
expected_head="$2"
expected_tree="$3"
snapshot_ref="$4"
current=$(git -C "$repo" rev-parse --verify HEAD 2>/dev/null || printf '0000000000000000000000000000000000000000')
if [ "$current" != "$expected_head" ]; then
  printf 'remote HEAD changed during export: expected=%s actual=%s\n' "$expected_head" "$current" >&2
  exit 7
fi
git_dir=$(git -C "$repo" rev-parse --absolute-git-dir)
idx=$(mktemp)
rm -f "$idx"
trap 'rm -f "$idx"' EXIT
if [ -f "$git_dir/index" ]; then cp "$git_dir/index" "$idx"; fi
GIT_INDEX_FILE="$idx" git -C "$repo" add -A -- . >/dev/null
actual=$(GIT_INDEX_FILE="$idx" git -C "$repo" write-tree)
if [ "$actual" != "$expected_tree" ]; then
  printf 'remote snapshot changed during export: expected=%s actual=%s\n' "$expected_tree" "$actual" >&2
  exit 7
fi
git -C "$repo" update-ref "$snapshot_ref" "$actual"
"""

DELETE_REF_SCRIPT = r"""
set -euo pipefail
git -C "$HOME/$1" update-ref -d "$2"
"""

PREPARE_HANDOFF_SCRIPT = r"""
set -euo pipefail
target="$HOME/$1"
umask 077
rm -rf "$target"
mkdir -p "$target"
chmod 700 "$target"
"""

VERIFY_HANDOFF_SCRIPT = r"""
set -euo pipefail
target="$HOME/$1"
expected="$2"
launch="$3"
session_file="$target/session.jsonl"
case "$launch" in
  '$HOME/'*) launch="$HOME/${launch#\$HOME/}" ;;
  '~/'*) launch="$HOME/${launch#\~/}" ;;
esac
actual=$(python3 - "$session_file" <<'PY'
import hashlib
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
digest = hashlib.sha256()
with path.open("rb") as handle:
    for chunk in iter(lambda: handle.read(1024 * 1024), b""):
        digest.update(chunk)
print(digest.hexdigest())
PY
)
[ "$actual" = "$expected" ] || {
  printf 'session checksum mismatch: expected=%s actual=%s\n' "$expected" "$actual" >&2
  exit 5
}
chmod 600 "$session_file"
[ ! -d "$target/session" ] || chmod -R go-rwx "$target/session"
validation_dir=$(mktemp -d "$target/.validate.XXXXXX")
trap 'rm -rf "$validation_dir"' EXIT
(
  cd "$validation_dir"
  "$launch" --export "$session_file" >/dev/null
)
"""

START_HANDOFF_SCRIPT = r"""
set -euo pipefail
repo="$HOME/$1"
session="$2"
session_file="$HOME/$3"
launch="$4"
fingerprint="$5"
case "$launch" in
  '$HOME/'*) launch="$HOME/${launch#\$HOME/}" ;;
  '~/'*) launch="$HOME/${launch#\~/}" ;;
esac
tmux has-session -t "=$session" 2>/dev/null && {
  printf 'tmux session already exists: %s\n' "$session" >&2
  exit 4
}
printf -v command '%q ' "$launch" --cwd "$repo" --resume "$session_file"
tmux new-session -d -s "$session" -c "$repo" "$command"
if [ -n "$fingerprint" ]; then
  tmux set-option -t "$session" @ompup-environment "$fingerprint"
fi
tmux has-session -t "=$session" 2>/dev/null || {
  printf 'remote OMP exited before becoming attachable\n' >&2
  exit 6
}
"""

CLEANUP_HANDOFF_SCRIPT = r"""
set -euo pipefail
if [ "$3" = 1 ]; then tmux kill-session -t "=$1" 2>/dev/null || true; fi
rm -rf "$HOME/$2"
"""


def die(message: str) -> "NoReturn":
    print(f"ompup: {message}", file=sys.stderr)
    raise SystemExit(1)


def run(
    args: list[str],
    *,
    cwd: Path | None = None,
    env: dict[str, str] | None = None,
    check: bool = True,
    capture: bool = False,
    text: bool = True,
) -> subprocess.CompletedProcess:
    return subprocess.run(
        args,
        cwd=cwd,
        env=env,
        check=check,
        capture_output=capture,
        text=text,
    )


def configure_ssh_transport(remote: str) -> None:
    global SSH_CONTROL_PATH
    control_dir = Path.home() / ".cache" / "ompup" / "ssh"
    if control_dir.is_symlink() or (control_dir.exists() and not control_dir.is_dir()):
        raise RuntimeError(f"SSH control path is not a private directory: {control_dir}")
    control_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    control_dir.chmod(0o700)
    remote_key = hashlib.sha256(remote.encode()).hexdigest()[:16]
    SSH_CONTROL_PATH = str(control_dir / f"{os.getpid()}-{remote_key}")


def ssh_transport_args() -> list[str]:
    if not SSH_CONTROL_PATH:
        return []
    return [
        "-o",
        "ControlMaster=auto",
        "-o",
        "ControlPersist=60",
        "-o",
        f"ControlPath={SSH_CONTROL_PATH}",
    ]


def git_transport_env() -> dict[str, str]:
    env = os.environ.copy()
    env["GIT_SSH_COMMAND"] = shlex.join(["ssh", *ssh_transport_args()])
    return env


def rsync_args() -> list[str]:
    return ["rsync", "-e", shlex.join(["ssh", *ssh_transport_args()])]


def ssh_command(command: str, *, check: bool = True, capture: bool = False) -> subprocess.CompletedProcess:
    return run(["ssh", *ssh_transport_args(), REMOTE, command], check=check, capture=capture)


def ssh_script(
    script: str,
    *args: str,
    check: bool = True,
    capture: bool = False,
) -> subprocess.CompletedProcess:
    command = "bash -s -- " + " ".join(shlex.quote(arg) for arg in args)
    return subprocess.run(
        ["ssh", *ssh_transport_args(), REMOTE, command],
        input=script,
        text=True,
        check=check,
        capture_output=capture,
    )


def git(root: Path, *args: str, env: dict[str, str] | None = None, capture: bool = True) -> str:
    result = run(["git", "-C", str(root), *args], env=env, capture=capture)
    return result.stdout.strip() if capture else ""




def project_identity(root: Path) -> tuple[str, str]:
    result = run(
        ["git", "-C", str(root), "remote", "get-url", "origin"],
        check=False,
        capture=True,
    )
    origin = result.stdout.strip() if result.returncode == 0 else ""
    material = f"origin\0{origin}" if origin else f"path\0{root}"
    identity = hashlib.sha256(material.encode()).hexdigest()

    remote_origin = origin
    parsed = urlsplit(origin)
    sensitive_query = {"access_token", "auth", "key", "password", "signature", "token"}
    if (
        origin.startswith(("/", "file:"))
        or parsed.password is not None
        or (parsed.scheme in {"http", "https"} and parsed.username is not None)
        or any(key.lower() in sensitive_query for key, _ in parse_qsl(parsed.query))
    ):
        remote_origin = ""
    return identity, remote_origin


def prepare_index(root: Path) -> tuple[Path, str, list[str]]:
    git_dir = Path(git(root, "rev-parse", "--absolute-git-dir"))
    handle = tempfile.NamedTemporaryFile(prefix="ompup-index-", delete=False)
    index = Path(handle.name)
    handle.close()
    index.unlink()
    if (git_dir / "index").is_file():
        shutil.copy2(git_dir / "index", index)

    env = os.environ.copy()
    env["GIT_INDEX_FILE"] = str(index)
    try:
        git(root, "add", "-A", "--", ".", env=env, capture=False)
        tree = git(root, "write-tree", env=env)
        entries = git(root, "ls-files", "-z", env=env).split("\0")
    except Exception:
        index.unlink(missing_ok=True)
        raise
    return index, tree, [entry for entry in entries if entry]


def repository_head(root: Path) -> str:
    result = run(
        ["git", "-C", str(root), "rev-parse", "--verify", "HEAD"],
        check=False,
        capture=True,
    )
    return result.stdout.strip() if result.returncode == 0 else "0" * 40
def current_branch(root: Path) -> str:
    result = run(
        ["git", "-C", str(root), "symbolic-ref", "--quiet", "--short", "HEAD"],
        check=False,
        capture=True,
    )
    if result.returncode != 0 or not result.stdout.strip():
        die("detached HEAD is not supported; check out a local branch before synchronizing")
    return result.stdout.strip()


def local_state(root: Path) -> str:
    index, tree, _ = prepare_index(root)
    index.unlink(missing_ok=True)
    return f"{repository_head(root)}:{tree}"


def remote_exists(remote_dir: str) -> bool:
    command = f"test -d {shlex.quote(remote_dir)}"
    return ssh_command(command, check=False).returncode == 0


def remote_state(remote_dir: str) -> str:
    result = ssh_script(REMOTE_STATE_SCRIPT, remote_dir, capture=True)
    return result.stdout.strip()


def require_remote_command(command: str) -> None:
    result = ssh_script('command -v "$1" >/dev/null 2>&1', command, check=False)
    if result.returncode != 0:
        die(f"required remote command not found on {REMOTE}: {command}")


def session_exists(session: str) -> bool:
    result = ssh_script('tmux has-session -t "=$1" 2>/dev/null', session, check=False)
    return result.returncode == 0


def read_baseline(state_key: str) -> tuple[str, str] | None:
    result = ssh_script(READ_BASELINE_SCRIPT, state_key, check=False, capture=True)
    if result.returncode == 3:
        return None
    if result.returncode != 0:
        die("could not read remote synchronization state")
    lines = result.stdout.splitlines()
    if len(lines) != 2 or not re.fullmatch(r"[0-9a-f]{64}", lines[0]):
        die("remote synchronization state is malformed")
    return lines[0], lines[1]


def write_baseline(state_key: str, identity: str, state: str) -> None:
    ssh_script(WRITE_BASELINE_SCRIPT, state_key, identity, state)


def validate_snapshot_paths(entries: list[str]) -> None:
    for entry in entries:
        path = Path(entry)
        if any(part in PRESERVED_DIRS for part in path.parts):
            die(f"unignored dependency/build path would transfer: {entry}")
        name = path.name
        if name in SENSITIVE_NAMES or name.startswith(".env.") or name.endswith((".pem", ".key")):
            die(f"sensitive path requires explicit handling and will not transfer: {entry}")


def operation_ref(kind: str, state_key: str) -> str:
    key = hashlib.sha256(state_key.encode()).hexdigest()[:16]
    nonce = os.urandom(6).hex()
    return f"refs/ompup/{kind}/{key}-{os.getpid()}-{nonce}"


def remote_repository(remote_dir: str) -> str:
    return f"{REMOTE}:{remote_dir}"


def delete_local_ref(root: Path, ref: str) -> None:
    git(root, "update-ref", "-d", ref, capture=False)


def delete_remote_ref(remote_dir: str, ref: str) -> None:
    ssh_script(DELETE_REF_SCRIPT, remote_dir, ref, check=False)


def push_ref(root: Path, repository: str, source: str, destination: str) -> None:
    git(
        root,
        "push",
        "-q",
        repository,
        f"{source}:{destination}",
        env=git_transport_env(),
        capture=False,
    )


def fetch_ref(root: Path, repository: str, source: str, destination: str) -> None:
    git(
        root,
        "fetch",
        "-q",
        repository,
        f"+{source}:{destination}",
        env=git_transport_env(),
        capture=False,
    )


def scan_snapshot_tree(root: Path, tree: str) -> None:
    env = os.environ.copy()
    env.update(
        {
            "GIT_AUTHOR_NAME": "ompup",
            "GIT_AUTHOR_EMAIL": "ompup@localhost",
            "GIT_COMMITTER_NAME": "ompup",
            "GIT_COMMITTER_EMAIL": "ompup@localhost",
            "GIT_AUTHOR_DATE": "2000-01-01T00:00:00Z",
            "GIT_COMMITTER_DATE": "2000-01-01T00:00:00Z",
        }
    )
    commit = git(root, "commit-tree", tree, "-m", "ompup snapshot", env=env)
    result = run(
        [
            "gitleaks",
            "git",
            "--no-banner",
            "--redact",
            "--log-level",
            "error",
            f"--log-opts={commit}^!",
            str(root),
        ],
        cwd=root,
        check=False,
        capture=True,
    )
    if result.returncode != 0:
        die("secret scan rejected the working snapshot; review it locally with gitleaks")


def scan_history(root: Path, revision: str = "") -> None:
    command = ["gitleaks", "git", "--no-banner", "--redact", "--log-level", "error"]
    if revision:
        command.append(f"--log-opts={revision}")
    command.append(str(root))
    result = run(command, cwd=root, check=False, capture=True)
    if result.returncode != 0:
        scope = "incoming Git history" if revision else "reachable Git history"
        die(f"secret scan rejected {scope}; review it locally with gitleaks")


def prepare_snapshot(root: Path) -> tuple[str, str]:
    head = repository_head(root)
    index, tree, entries = prepare_index(root)
    try:
        validate_snapshot_paths(entries)
    finally:
        index.unlink(missing_ok=True)
    if repository_head(root) != head:
        die("local HEAD changed while its snapshot was being prepared; retry")
    scan_snapshot_tree(root, tree)
    return f"{head}:{tree}", tree


def push_object(root: Path, remote_dir: str, object_name: str, remote_ref: str) -> None:
    local_ref = operation_ref("outgoing", remote_ref)
    git(root, "update-ref", local_ref, object_name, capture=False)
    try:
        push_ref(root, remote_repository(remote_dir), local_ref, remote_ref)
    finally:
        delete_local_ref(root, local_ref)


def publish_commit(
    root: Path,
    state_key: str,
    remote_dir: str,
    branch: str,
    expected_old: str,
    expected_new: str,
) -> None:
    remote_ref = operation_ref("commits", state_key)
    try:
        push_object(root, remote_dir, expected_new, remote_ref)
        result = ssh_script(
            APPLY_COMMIT_SCRIPT,
            remote_dir,
            remote_ref,
            branch,
            expected_old,
            expected_new,
            check=False,
            capture=True,
        )
        if result.returncode != 0:
            detail = result.stderr.strip().splitlines()[-1] if result.stderr.strip() else "remote Git rejected the update"
            die(f"could not fast-forward remote commits: {detail}")
    finally:
        delete_remote_ref(remote_dir, remote_ref)


def publish_snapshot(root: Path, state_key: str, remote_dir: str, state: str, tree: str) -> None:
    expected_head = state.split(":", 1)[0]
    remote_ref = operation_ref("snapshots", state_key)
    try:
        push_object(root, remote_dir, tree, remote_ref)
        result = ssh_script(
            APPLY_SNAPSHOT_SCRIPT,
            remote_dir,
            remote_ref,
            tree,
            expected_head,
            check=False,
            capture=True,
        )
        if result.returncode != 0:
            detail = result.stderr.strip().splitlines()[-1] if result.stderr.strip() else "remote Git rejected the snapshot"
            die(f"could not apply remote working snapshot: {detail}")
    finally:
        delete_remote_ref(remote_dir, remote_ref)


def bootstrap(
    root: Path,
    project: str,
    state_key: str,
    remote_dir: str,
    identity: str,
    origin: str,
) -> str:
    del project
    branch = current_branch(root)
    expected, tree = prepare_snapshot(root)
    head = expected.split(":", 1)[0]
    ssh_script(BOOTSTRAP_SCRIPT, remote_dir, branch, origin)
    try:
        if head != "0" * 40:
            scan_history(root)
            publish_commit(root, state_key, remote_dir, branch, "0" * 40, head)
        if local_state(root) != expected:
            die("local checkout changed while its snapshot was being prepared; retry")
        publish_snapshot(root, state_key, remote_dir, expected, tree)
        actual = remote_state(remote_dir)
        if actual != expected:
            die("remote checkout did not match the prepared snapshot; synchronization state was not recorded")
    except BaseException:
        ssh_script(REMOVE_REMOTE_PROJECT_SCRIPT, remote_dir, check=False)
        raise
    write_baseline(state_key, identity, actual)
    print(f"ompup: bootstrapped {REMOTE}:~/{remote_dir}")
    return actual


def is_ancestor(root: Path, ancestor: str, descendant: str) -> bool:
    if ancestor == "0" * 40:
        return True
    result = run(
        ["git", "-C", str(root), "merge-base", "--is-ancestor", ancestor, descendant],
        check=False,
    )
    return result.returncode == 0


def fast_forward_remote(root: Path, project: str, state_key: str, remote_dir: str, remote_head: str) -> None:
    del project
    local_head = repository_head(root)
    if not is_ancestor(root, remote_head, local_head):
        die("local commit history is not a fast-forward of the remote; reconcile it with Git")
    branch = current_branch(root)
    scan_history(root, f"{remote_head}..{local_head}" if remote_head != "0" * 40 else local_head)
    publish_commit(root, state_key, remote_dir, branch, remote_head, local_head)
    print(f"ompup: fast-forwarded remote commits to {local_head[:10]}")


def fast_forward_local(root: Path, project: str, state_key: str, remote_dir: str, remote_head: str) -> None:
    del project
    local_head = repository_head(root)
    branch_result = ssh_command(
        f"git -C {shlex.quote(remote_dir)} symbolic-ref --quiet --short HEAD",
        check=False,
        capture=True,
    )
    if branch_result.returncode != 0:
        die("could not determine the remote branch")
    branch = branch_result.stdout.strip()
    local_branch = current_branch(root)
    if local_branch != branch:
        die(f"branch mismatch: local={local_branch} remote={branch}")

    local_ref = operation_ref("incoming", state_key)
    try:
        fetch_ref(root, remote_repository(remote_dir), f"refs/heads/{branch}", local_ref)
        incoming = git(root, "rev-parse", f"{local_ref}^{{commit}}")
        if incoming != remote_head or not is_ancestor(root, local_head, incoming):
            die("remote commit history is not a fast-forward of local; reconcile it with Git")
        scan_history(root, f"{local_head}..{incoming}" if local_head != "0" * 40 else incoming)
        git(root, "reset", "--hard", "-q", incoming, capture=False)
    finally:
        delete_local_ref(root, local_ref)
    print(f"ompup: fast-forwarded local commits to {incoming[:10]}")


def assert_identity(state_key: str, remote_dir: str, identity: str, local: str, remote: str) -> str:
    baseline = read_baseline(state_key)
    if baseline is None:
        if local != remote:
            die("existing remote checkout predates safe sync and differs locally; reconcile it with Git first")
        write_baseline(state_key, identity, remote)
        return remote
    recorded_identity, recorded_state = baseline
    if recorded_identity != identity:
        die(f"~/{remote_dir} maps to a different local repository; choose a distinct project name")
    return recorded_state


def sync_up(
    root: Path,
    project: str,
    state_key: str,
    remote_dir: str,
    identity: str,
    origin: str,
) -> None:
    local = local_state(root)
    if not remote_exists(remote_dir):
        bootstrap(root, project, state_key, remote_dir, identity, origin)
        return

    remote = remote_state(remote_dir)
    baseline = assert_identity(state_key, remote_dir, identity, local, remote)
    if local == remote:
        write_baseline(state_key, identity, remote)
        print("ompup: local and remote snapshots already match")
        return
    if remote != baseline:
        die("remote working state changed since the last sync; run `ompup pull` or resolve the conflict")
    local_head, remote_head = local.split(":", 1)[0], remote.split(":", 1)[0]
    if local_head != remote_head:
        fast_forward_remote(root, project, state_key, remote_dir, remote_head)

    expected, tree = prepare_snapshot(root)
    if expected != local:
        die("local checkout changed while its snapshot was being prepared; retry")
    publish_snapshot(root, state_key, remote_dir, expected, tree)

    actual = remote_state(remote_dir)
    if actual != local:
        die("remote verification did not match the local snapshot; synchronization state was not advanced")
    write_baseline(state_key, identity, actual)
    print("ompup: synchronized local working state to remote")


def fetch_snapshot(root: Path, state_key: str, remote_dir: str, state: str) -> None:
    expected_head, expected_tree = state.split(":", 1)
    remote_ref = operation_ref("snapshots", state_key)
    local_ref = operation_ref("incoming", state_key)
    try:
        result = ssh_script(
            CREATE_SNAPSHOT_REF_SCRIPT,
            remote_dir,
            expected_head,
            expected_tree,
            remote_ref,
            check=False,
            capture=True,
        )
        if result.returncode != 0:
            detail = result.stderr.strip().splitlines()[-1] if result.stderr.strip() else "remote snapshot export failed"
            die(f"could not export remote working snapshot: {detail}")
        before = local_state(root)
        fetch_ref(root, remote_repository(remote_dir), remote_ref, local_ref)
        incoming = git(root, "rev-parse", f"{local_ref}^{{tree}}")
        if incoming != expected_tree:
            die(f"fetched snapshot mismatch: expected={expected_tree} actual={incoming}")
        scan_snapshot_tree(root, incoming)
        if local_state(root) != before:
            die("local checkout changed while the remote snapshot was being fetched; retry")
        run(["git", "-C", str(root), "read-tree", "--dry-run", "--reset", "-u", incoming])
        run(["git", "-C", str(root), "read-tree", "--reset", "-u", incoming])
    finally:
        delete_local_ref(root, local_ref)
        delete_remote_ref(remote_dir, remote_ref)


def sync_down(root: Path, project: str, state_key: str, remote_dir: str, identity: str) -> None:
    if not remote_exists(remote_dir):
        die(f"nothing at {REMOTE}:~/{remote_dir}")
    local = local_state(root)
    remote = remote_state(remote_dir)
    baseline = assert_identity(state_key, remote_dir, identity, local, remote)
    if local == remote:
        write_baseline(state_key, identity, remote)
        print("ompup: local and remote snapshots already match")
        return
    if local != baseline:
        if remote == baseline:
            die("remote has no changes to download; local working state changed")
        die("both local and remote working states changed since the last sync; resolve the conflict")
    local_head, remote_head = local.split(":", 1)[0], remote.split(":", 1)[0]
    if local_head != remote_head:
        fast_forward_local(root, project, state_key, remote_dir, remote_head)

    fetch_snapshot(root, state_key, remote_dir, remote)
    actual = local_state(root)
    if actual != remote:
        die("local verification did not match the remote snapshot; synchronization state was not advanced")
    write_baseline(state_key, identity, actual)
    print("ompup: synchronized remote working state to local")
    run(["git", "-C", str(root), "status", "--short"], check=False)


def show_status(
    root: Path,
    state_key: str,
    remote_dir: str,
    identity: str,
    session: str,
) -> None:
    local = local_state(root)
    print(f"== local ({root})")
    run(["git", "-C", str(root), "status", "--short", "--branch"], check=False)
    if not remote_exists(remote_dir):
        print(f"== remote ({REMOTE}:~/{remote_dir})\n(no checkout)\n== tmux\n(no session {session})")
        return
    remote = remote_state(remote_dir)
    baseline_data = read_baseline(state_key)
    print(f"== remote ({REMOTE}:~/{remote_dir})")
    ssh_command(f"git -C {shlex.quote(remote_dir)} status --short --branch", check=False)
    print("== sync")
    if baseline_data is None:
        print("unregistered existing checkout")
    elif baseline_data[0] != identity:
        print("project identity mismatch")
    elif local == remote:
        print("local and remote match")
    elif local.split(":", 1)[0] != remote.split(":", 1)[0]:
        print("commits differ; synchronize with Git before transferring working state")
    elif local == baseline_data[1]:
        print("remote changed; `ompup pull` is safe")
    elif remote == baseline_data[1]:
        print("local changed; `ompup sync` is safe")
    else:
        print("both sides changed; manual resolution required")
    print("== tmux")
    print(f"session {session} is {'running' if session_exists(session) else 'not running'}")


def session_environment(session: str) -> str:
    result = ssh_command(
        f"tmux show-options -v -t {shlex.quote(session)} @ompup-environment",
        check=False,
        capture=True,
    )
    return result.stdout.strip() if result.returncode == 0 else ""


def attach(session: str, remote_dir: str, launch: str, fingerprint: str) -> None:
    quoted_session = shlex.quote(session)
    quoted_target = shlex.quote("=" + session)
    quoted_option_target = shlex.quote(session)
    create = (
        f"tmux new-session -d -s {quoted_session} "
        f'-c \"$HOME/{remote_dir}\"'
    )
    if launch:
        create += " " + shlex.quote(f'{launch}; exec \"$SHELL\"')
    if fingerprint:
        existing_check = (
            f"actual=$(tmux show-options -v -t {quoted_option_target} @ompup-environment 2>/dev/null || true); "
            f"[ \"$actual\" = {shlex.quote(fingerprint)} ] || "
            f"{{ printf 'tmux session environment mismatch\\n' >&2; exit 7; }}; "
        )
        record_environment = (
            f"tmux set-option -t {quoted_option_target} @ompup-environment "
            f"{shlex.quote(fingerprint)}; "
        )
    else:
        existing_check = ""
        record_environment = ""
    command = (
        f"if tmux has-session -t {quoted_target} 2>/dev/null; then "
        f"{existing_check}"
        f"exec tmux attach-session -t {quoted_target}; fi; "
        f"{create}; "
        f"{record_environment}"
        f"exec tmux attach-session -t {quoted_target}"
    )
    os.execvp("ssh", ["ssh", *ssh_transport_args(), "-t", REMOTE, command])


def add_project_arguments(parser: argparse.ArgumentParser, *, cmux: bool = False) -> None:
    parser.add_argument("project", nargs="?", help="project name or path; defaults to the current Git repository")
    parser.add_argument("--pick", action="store_true", help="choose interactively from the projects directory")
    parser.add_argument("--host", default="", help="configured host name or SSH destination")
    parser.add_argument(
        "--profile",
        default="auto",
        help="host capability role (auto detects macos; custom configured roles are accepted)",
    )
    if cmux:
        parser.add_argument("--cmux", action="store_true", help="open or reuse a cmux workspace")


def create_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="ompup",
        description="Safely continue a local Git project inside persistent OMP on a remote machine.",
    )
    parser.add_argument("--version", action="version", version=f"ompup {VERSION}")
    commands = parser.add_subparsers(dest="command", required=True)
    for name, help_text in (
        ("up", "bootstrap or sync when needed, then attach OMP"),
        ("shell", "bootstrap or sync when needed, then attach a shell"),
        ("sync", "transfer local commits and working state without attaching"),
        ("pull", "transfer remote commits and working state to local"),
        ("status", "show selected host, synchronization, and tmux state"),
        ("doctor", "probe configured hosts and explain selection"),
    ):
        subparser = commands.add_parser(name, help=help_text)
        add_project_arguments(subparser, cmux=name in {"up", "shell"})
    handoff_parser = commands.add_parser(
        "handoff",
        help="move a live local OMP session into remote tmux and replace its cmux surface",
    )
    add_project_arguments(handoff_parser)
    handoff_parser.add_argument("--session-file", required=True, help=argparse.SUPPRESS)
    handoff_parser.add_argument("--artifacts-dir", default="", help=argparse.SUPPRESS)
    handoff_parser.add_argument("--session-id", required=True, help=argparse.SUPPRESS)
    handoff_parser.add_argument(
        "--prepare-only",
        action="store_true",
        help="prepare and verify remote OMP without replacing the local terminal",
    )
    hosts_parser = commands.add_parser("hosts", help="probe every configured host")
    hosts_parser.add_argument("--json", action="store_true", help="emit probe data as JSON")
    pin_parser = commands.add_parser("pin", help="pin a project to one configured host")
    pin_parser.add_argument("host")
    pin_parser.add_argument("project", nargs="?")
    pin_parser.add_argument("--pick", action="store_true")
    unpin_parser = commands.add_parser("unpin", help="remove a project's host pin")
    unpin_parser.add_argument("project", nargs="?")
    unpin_parser.add_argument("--pick", action="store_true")
    env_parser = commands.add_parser("env", help="manage shared OMP environment parity")
    env_commands = env_parser.add_subparsers(dest="env_command", required=True)
    for name, help_text in (
        ("status", "compare shared OMP configuration on remote machines"),
        ("sync", "synchronize shared OMP configuration to remote machines"),
    ):
        env_subparser = env_commands.add_parser(name, help=help_text)
        env_subparser.add_argument("--host", action="append", default=[], help="configured host name or SSH destination")
        env_subparser.add_argument("--all", action="store_true", help="target every configured host")
        if name == "status":
            env_subparser.add_argument("--json", action="store_true", help="emit status as JSON")
    auth_parser = commands.add_parser("auth", help="configure and verify the shared OMP auth broker")
    auth_commands = auth_parser.add_subparsers(dest="auth_command", required=True)
    auth_commands.add_parser("setup", help="provision the broker token and configure this machine")
    auth_commands.add_parser("status", help="verify local broker authentication")
    migrate_parser = auth_commands.add_parser("migrate", help="migrate local stored credentials to the broker")
    migrate_parser.add_argument("--dry-run", action="store_true", help="show migrations without writing")
    return parser


def parse_args() -> argparse.Namespace:
    argv = sys.argv[1:]
    commands = {"up", "shell", "sync", "pull", "status", "doctor", "hosts", "pin", "unpin", "handoff", "env", "auth"}
    if not argv:
        argv = ["up"]
    elif argv[0] not in commands and argv[0] not in {"-h", "--help", "--version"}:
        argv.insert(0, "up")
    return create_parser().parse_args(argv)


def validate_local_requirements(args: argparse.Namespace) -> None:
    if not REMOTE_ROOT or not re.fullmatch(r"[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*", REMOTE_ROOT):
        die("OMPUP_REMOTE_ROOT must be a relative path of safe directory names")
    if any(part in {".", ".."} for part in REMOTE_ROOT.split("/")):
        die("OMPUP_REMOTE_ROOT cannot contain . or ..")
    if os.environ.get("OMPUP_EXCLUDES"):
        die("OMPUP_EXCLUDES is no longer supported; use .gitignore or .git/info/exclude")
    if args.command == "hosts":
        required = ("ssh",)
    elif args.command in {"pin", "unpin"}:
        required = ("git",)
    elif args.command in {"status", "doctor"}:
        required = ("git", "ssh")
    elif args.command == "auth":
        required = ("ssh", "omp")
    elif args.command == "env":
        required = ("ssh", "omp") if args.env_command == "status" else ("ssh", "omp", "gitleaks")
    elif args.command == "handoff":
        required = ("git", "ssh", "rsync", "gitleaks")
    else:
        required = ("git", "ssh", "gitleaks")
    for executable in required:
        if shutil.which(executable) is None:
            die(f"required local command not found: {executable}")


def host_context(
    root: Path,
    project: str,
    requested_host: str,
    requested_profile: str,
    *,
    persist: bool = True,
    probe_all: bool = False,
) -> tuple[HostChoice, list[HostProbe], str, str, str]:
    global LAUNCH, REMOTE
    session = project
    hosts = load_hosts(LEGACY_HOST)
    profile = project_profile(root, requested_profile)
    explicit = requested_host or (LEGACY_HOST if LEGACY_HOST not in {"", "auto"} else "")
    requested = explicit or pinned_host(root)
    probe_targets = hosts if probe_all or not requested else [find_host(hosts, requested)]
    probes = probe_hosts(probe_targets, project, session, REMOTE_ROOT)
    choice = choose_host(hosts, probes, root, profile, explicit)
    remote_dir = choice.probe.remote_dir
    REMOTE = choice.host.ssh
    configure_ssh_transport(REMOTE)
    LAUNCH = LAUNCH_OVERRIDE or choice.host.launch
    if persist and not pinned_host(root):
        pin_host(root, choice.host.name)
    state_key = f"{hashlib.sha256(remote_dir.encode()).hexdigest()[:16]}-{project}"
    return choice, probes, remote_dir, session, state_key


def print_banner(root: Path, project: str, choice: HostChoice, profile: str) -> None:
    status = git(root, "status", "--porcelain")
    branch_result = run(
        ["git", "-C", str(root), "symbolic-ref", "--quiet", "--short", "HEAD"],
        check=False,
        capture=True,
    )
    branch = branch_result.stdout.strip() or "detached"
    dirty = len(status.splitlines()) if status else 0
    probe = choice.probe
    print(
        f"ompup: {project} -> {choice.host.name} ({choice.reason}); "
        f"{probe.system}/{probe.arch}, {probe.free_gb:.0f} GB free, "
        f"load {probe.load1:.2f}/{probe.cpu_count} CPU; "
        f"{branch}, {dirty} changed path{'s' if dirty != 1 else ''}; profile {profile}"
    )


def show_hosts(as_json: bool = False) -> None:
    hosts = load_hosts(LEGACY_HOST)
    probes = probe_hosts(hosts, ".ompup-probe", ".ompup-probe", REMOTE_ROOT)
    if as_json:
        print(
            json.dumps(
                [
                    {
                        "name": probe.host.name,
                        "ssh": probe.host.ssh,
                        "roles": probe.host.roles,
                        "reachable": probe.reachable,
                        "tools_ok": probe.tools_ok,
                        "system": probe.system,
                        "arch": probe.arch,
                        "cpu_count": probe.cpu_count,
                        "load1": probe.load1,
                        "memory_available": probe.memory_available,
                        "disk_free": probe.disk_free,
                        "latency_ms": probe.latency_ms,
                        "error": probe.error,
                    }
                    for probe in probes
                ],
                indent=2,
            )
        )
        return
    for probe in probes:
        print(format_probe(probe))


def open_cmux(root: Path, project: str, host_name: str, command: str) -> None:
    if shutil.which("cmux") is None:
        die("cmux is not installed")
    if run(["cmux", "ping"], check=False, capture=True).returncode != 0:
        die("cmux is installed but no live runtime is reachable")
    title = f"ompup:{project}@{host_name}"
    result = run(["cmux", "workspace", "list", "--json"], capture=True)
    payload = json.loads(result.stdout)
    existing = next(
        (
            workspace
            for workspace in payload.get("workspaces", [])
            if workspace.get("custom_title") == title or workspace.get("title") == title
        ),
        None,
    )
    if existing:
        run(["cmux", "workspace", "select", existing["ref"]])
        print(f"ompup: selected existing cmux workspace {title}")
        return
    executable = str(Path(__file__).resolve())
    launch_command = " ".join(
        shlex.quote(part)
        for part in (executable, command, str(root), "--host", host_name)
    )
    run(
        [
            "cmux",
            "workspace",
            "create",
            "--name",
            title,
            "--description",
            f"Persistent remote OMP on {host_name}",
            "--cwd",
            str(root),
            "--command",
            launch_command,
            "--focus",
            "true",
        ]
    )

def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def validate_handoff_launch(launch: str) -> None:
    if not re.fullmatch(r"(?:\$HOME/|~/|/)?[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*", launch):
        die("handoff requires the selected host launch setting to be one executable path")


def ensure_cmux_runtime() -> None:
    if shutil.which("cmux") is None:
        die("session handoff requires cmux")
    if run(["cmux", "ping"], check=False, capture=True).returncode != 0:
        die("session handoff requires a live cmux runtime")


def cmux_caller() -> tuple[str, str] | None:
    result = run(["cmux", "identify"], check=False, capture=True)
    if result.returncode != 0:
        return None
    try:
        caller = json.loads(result.stdout).get("caller")
    except json.JSONDecodeError:
        return None
    if not caller or caller.get("surface_type") != "terminal":
        return None
    window = caller.get("window_ref")
    surface = caller.get("surface_ref")
    if not isinstance(window, str) or not isinstance(surface, str):
        return None
    return window, surface


def handoff_attach_command(session: str) -> str:
    remote_command = f"tmux attach-session -t {shlex.quote('=' + session)}"
    ssh = shlex.join(["ssh", *ssh_transport_args(), "-t", REMOTE, remote_command])
    return f'{ssh}; exec "$SHELL" -l'


def replace_or_open_cmux(root: Path, project: str, host_name: str, session: str) -> str:
    command = handoff_attach_command(session)
    caller = cmux_caller()
    if caller:
        window, surface = caller
        result = run(
            [
                "cmux",
                "respawn-pane",
                "--window",
                window,
                "--surface",
                surface,
                "--command",
                command,
            ],
            check=False,
            capture=True,
        )
        if result.returncode == 0:
            return "replaced current cmux surface"

    run(
        [
            "cmux",
            "workspace",
            "create",
            "--name",
            f"ompup:{project}@{host_name}",
            "--description",
            f"Handed-off OMP session on {host_name}",
            "--cwd",
            str(root),
            "--command",
            command,
            "--focus",
            "true",
        ]
    )
    if caller:
        window, surface = caller
        closed = run(
            ["cmux", "close-surface", "--window", window, "--surface", surface],
            check=False,
            capture=True,
        )
        if closed.returncode == 0:
            return "opened fallback cmux workspace and closed the local surface"
    return "opened fallback cmux workspace"


def cleanup_handoff(session: str, handoff_dir: str, *, kill_session: bool) -> None:
    ssh_script(CLEANUP_HANDOFF_SCRIPT, session, handoff_dir, "1" if kill_session else "0", check=False)


def handoff_session(
    root: Path,
    project: str,
    remote_dir: str,
    session: str,
    state_key: str,
    identity: str,
    origin: str,
    choice: HostChoice,
    args: argparse.Namespace,
    environment_fingerprint: str,
) -> None:
    session_file = Path(args.session_file).expanduser().resolve()
    if not session_file.is_file() or session_file.suffix != ".jsonl":
        die("active OMP session file is missing or is not JSONL")
    if not re.fullmatch(r"[A-Za-z0-9_-]+", args.session_id):
        die("active OMP session ID is not safe for remote storage")
    artifacts_dir = Path(args.artifacts_dir).expanduser().resolve() if args.artifacts_dir else None
    if artifacts_dir and artifacts_dir.exists() and (not artifacts_dir.is_dir() or artifacts_dir.is_symlink()):
        die("active OMP artifact path is not a regular directory")
    validate_handoff_launch(LAUNCH)
    require_remote_command("rsync")
    if not args.prepare_only:
        ensure_cmux_runtime()
    if session_exists(session):
        die(f"remote tmux session {session!r} already exists; attach it or choose another host")

    sync_up(root, project, state_key, remote_dir, identity, origin)
    if session_exists(session):
        die(f"remote tmux session {session!r} appeared during synchronization; local OMP was preserved")

    handoff_dir = f".local/state/ompup/handoffs/{project}/{args.session_id}"
    remote_session_file = f"{handoff_dir}/session.jsonl"
    source_hash = file_sha256(session_file)
    ssh_script(PREPARE_HANDOFF_SCRIPT, handoff_dir)
    remote_started = False
    try:
        run([*rsync_args(), "-a", "--partial", str(session_file), f"{REMOTE}:{remote_session_file}"])
        if artifacts_dir and artifacts_dir.is_dir():
            run(
                [
                    *rsync_args(),
                    "-a",
                    "--partial",
                    str(artifacts_dir) + os.sep,
                    f"{REMOTE}:{handoff_dir}/session/",
                ]
            )
        if file_sha256(session_file) != source_hash:
            die("local OMP session changed during transfer; local OMP was preserved")

        verified = ssh_script(
            VERIFY_HANDOFF_SCRIPT,
            handoff_dir,
            source_hash,
            LAUNCH,
            check=False,
            capture=True,
        )
        if verified.returncode != 0:
            detail = verified.stderr.strip().splitlines()[-1] if verified.stderr.strip() else "remote export failed"
            die(f"remote OMP could not load the transferred session: {detail}")

        started = ssh_script(
            START_HANDOFF_SCRIPT,
            remote_dir,
            session,
            remote_session_file,
            LAUNCH,
            environment_fingerprint,
            check=False,
            capture=True,
        )
        if started.returncode != 0:
            detail = started.stderr.strip().splitlines()[-1] if started.stderr.strip() else "remote OMP did not stay running"
            die(f"remote OMP did not become attachable: {detail}")
        remote_started = True

        if args.prepare_only:
            print(
                f"ompup: remote session ready on {choice.host.name}; "
                f"attach with `ssh -t {REMOTE} {shlex.quote(f'tmux attach-session -t ={session}')}`"
            )
            return
        mode = replace_or_open_cmux(root, project, choice.host.name, session)
        print(f"ompup: {mode}; remote session {args.session_id} verified")
    except BaseException:
        cleanup_handoff(session, handoff_dir, kill_session=remote_started)
        raise


def run_doctor(root: Path, project: str, args: argparse.Namespace) -> None:
    choice, probes, remote_dir, session, _ = host_context(
        root, project, args.host, args.profile, persist=False, probe_all=True
    )
    for probe in probes:
        marker = "*" if probe.host.name == choice.host.name else " "
        print(f"{marker} {format_probe(probe)}")
    print(f"selected {choice.host.name}: {choice.reason}")
    print(f"remote path ~/{remote_dir}; tmux session {session}")


def run_environment_command(args: argparse.Namespace) -> None:
    hosts = load_hosts(LEGACY_HOST)
    selected = select_hosts(hosts, args.host, args.all)
    config = load_environment_config()
    if config.mode == "preserve":
        if args.env_command == "sync":
            raise RuntimeError(
                "environment sync is disabled in preserve mode; set environment.mode to mirror explicitly"
            )
        statuses = [preserved_environment_status(host) for host in selected]
        if args.json:
            print(
                json.dumps(
                    {
                        "mode": "preserve",
                        "hosts": [
                            {
                                "name": status.host.name,
                                "reachable": status.reachable,
                                "ok": status.ok,
                                "ompVersion": status.omp_version,
                                "error": status.error,
                            }
                            for status in statuses
                        ],
                    },
                    indent=2,
                )
            )
        else:
            print("local: preserve remote OMP configuration")
            for status in statuses:
                print(format_environment_status(status))
        return

    token = None
    if args.env_command == "sync" and config.broker_url:
        bootstrap_auth(hosts)
        token_path = CONFIG_ROOT / "auth-broker.token"
        if not token_path.is_file():
            raise RuntimeError(
                f"auth broker token is missing at {token_path}; run `ompup auth setup`"
            )
        token = token_path.read_bytes()

    results: list[tuple[object, object]] = []
    failures: list[str] = []
    for host in selected:
        release = build_release(config, host)
        try:
            status = environment_status(host)
            expected_version = str(release.manifest["ompVersion"])
            ready = (
                status.ok
                and status.fingerprint == release.fingerprint
                and status.omp_version == expected_version
            )
            if args.env_command == "sync" and not ready:
                try:
                    status = sync_environment(host, release, token)
                except RuntimeError as error:
                    failures.append(f"{host.name}: {error}")
                    print(f"ompup: {host.name}: {error}", file=sys.stderr)
            results.append((release, status))
        finally:
            cleanup_release(release)
    if failures:
        raise RuntimeError(f"environment sync failed for {len(failures)} host(s)")

    if args.json:
        print(
            json.dumps(
                {
                    "mode": "mirror",
                    "hosts": [
                        {
                            "name": status.host.name,
                            "reachable": status.reachable,
                            "ok": status.ok and status.fingerprint == release.fingerprint,
                            "expectedFingerprint": release.fingerprint,
                            "fingerprint": status.fingerprint,
                            "expectedOmpVersion": release.manifest["ompVersion"],
                            "ompVersion": status.omp_version,
                            "mismatches": status.mismatches,
                            "error": status.error,
                            "excludedExtensions": release.manifest["excludedExtensions"],
                        }
                        for release, status in results
                    ],
                },
                indent=2,
            )
        )
        return
    for release, status in results:
        print(format_environment_status(status, release.fingerprint))
        if release.manifest["excludedExtensions"]:
            print(
                f"{status.host.name} host-local extensions: "
                + ", ".join(release.manifest["excludedExtensions"])
            )


def run_auth_command(args: argparse.Namespace) -> None:
    hosts = load_hosts(LEGACY_HOST)
    if args.auth_command == "setup":
        config, changed = bootstrap_auth(hosts)
        print(f"ompup: broker configured at {config.broker_url}" + ("; local config updated" if changed else ""))
    elif args.auth_command == "migrate":
        bootstrap_auth(hosts)
        command = ["omp", "auth-broker", "migrate", "--from-local", "--include-oauth"]
        if args.dry_run:
            command.append("--dry-run")
        run(command)
        return
    run(["omp", "auth-broker", "status", "--json"])


def verify_selected_environment(choice: HostChoice, session: str):
    config = load_environment_config()
    status = ensure_environment(choice.host)
    if config.mode == "preserve":
        print(f"ompup: preserving remote OMP configuration on {choice.host.name} ({status.omp_version})")
        return status
    print(f"ompup: environment {status.fingerprint[:12]} verified on {choice.host.name}")
    if choice.probe.session_exists:
        actual = session_environment(session)
        if actual != status.fingerprint:
            die(
                f"remote tmux session {session!r} was started with environment "
                f"{actual[:12] if actual else 'unknown'}; quit it before attaching "
                f"with environment {status.fingerprint[:12]}"
            )
    return status




def main() -> None:
    global LAUNCH, REMOTE
    args = parse_args()
    validate_local_requirements(args)
    try:
        if args.command == "hosts":
            show_hosts(args.json)
            return
        if args.command == "env":
            run_environment_command(args)
            return
        if args.command == "auth":
            run_auth_command(args)
            return
        root = resolve_project(
            getattr(args, "project", "") or "",
            getattr(args, "pick", False),
            init_missing=args.command in {"up", "shell", "sync", "handoff"},
        )
        project = root.name
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", project):
            die(f"project name {project!r} is not safe for remote paths")
        hosts = load_hosts(LEGACY_HOST)
        if args.command == "pin":
            host = find_host(hosts, args.host)
            pin_host(root, host.name)
            print(f"ompup: pinned {project} to {host.name}")
            return
        if args.command == "unpin":
            unpin_host(root)
            print(f"ompup: removed host pin for {project}")
            return
        if args.command == "doctor":
            run_doctor(root, project, args)
            return

        choice, _, remote_dir, session, state_key = host_context(
            root,
            project,
            args.host,
            args.profile,
            persist=args.command != "status",
        )
        profile = project_profile(root, args.profile)
        identity, origin = project_identity(root)
        selected_environment = None
        if args.command in {"up", "handoff"}:
            selected_environment = verify_selected_environment(choice, session)
        if getattr(args, "cmux", False):
            open_cmux(root, project, choice.host.name, args.command)
            return
        if args.command == "handoff":
            if selected_environment is None:
                die("remote environment was not verified")
            handoff_session(
                root,
                project,
                remote_dir,
                session,
                state_key,
                identity,
                origin,
                choice,
                args,
                selected_environment.fingerprint,
            )
            return
        if args.command == "status":
            show_status(root, state_key, remote_dir, identity, session)
            return
        if args.command == "pull":
            sync_down(root, project, state_key, remote_dir, identity)
            return
        if args.command == "sync":
            sync_up(root, project, state_key, remote_dir, identity, origin)
            return

        if choice.probe.project_exists and choice.probe.session_exists:
            print("ompup: existing tmux session found; attaching without changing its checkout")
        else:
            sync_up(root, project, state_key, remote_dir, identity, origin)
        attach(
            session,
            remote_dir,
            "" if args.command == "shell" else LAUNCH,
            selected_environment.fingerprint if selected_environment else "",
        )
    except (HostSelectionError, RuntimeError) as error:
        die(str(error))


if __name__ == "__main__":
    main()
