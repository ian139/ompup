#!/usr/bin/env bash
# ompup v0.2 - explicit, crash-recoverable project handoff over SSH.
#
# Configuration: OMPUP_HOST, OMPUP_REMOTE_ROOT (default Projects),
# OMPUP_CMD (default omp; shell text), OMPUP_EXCLUDES, XDG_STATE_HOME.
# OMPUP_CMD is intentionally evaluated by `bash -lc` on the remote. It must
# not contain CR, LF, or TAB. Ompup otherwise treats configuration as data.
set -euo pipefail

VERSION=0.2.0
PROGRAM=${0##*/}
LC_ALL=C
export LC_ALL

say() { printf '%s\n' "$*"; }
warn() { printf 'ompup: %s\n' "$*" >&2; }
die() { warn "$*"; exit 1; }

usage() {
  cat <<'EOF'
Usage: ompup [sync|pull|attach|shell|status] [--dry-run] [--acknowledge-excluded]
       ompup help | --help
       ompup version | --version

An explicit two-copy handoff. `sync` hands ownership to the remote; `pull`
hands ownership to local; `attach` never transfers data. With no command,
ompup syncs and attaches only after a successful handoff. When the remote
already owns the tree, run `ompup attach`.

Options:
  --dry-run                 inspect sync/pull without managed mutations
  --acknowledge-excluded    acknowledge the exact tracked files omitted

Environment:
  OMPUP_HOST                narrow SSH alias or user@host (required)
  OMPUP_REMOTE_ROOT         relative remote root (default: Projects)
  OMPUP_CMD                 remote bash text launched by attach (default: omp)
  OMPUP_EXCLUDES            colon-separated extra rsync exclude patterns
  XDG_STATE_HOME            local state base override

The exclusion policy is a convenience denylist, not a secret scanner.
EOF
}

# Help/version deliberately precede configuration, discovery and dependencies.
case "${1:-}" in
  -h|--help|help) usage; exit 0 ;;
  version|--version) printf 'ompup %s\n' "$VERSION"; exit 0 ;;
esac

CMD=up
DRY_RUN=0
ACKNOWLEDGE=0
SEEN_CMD=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    sync|pull|attach|shell|status)
      [ "$SEEN_CMD" -eq 0 ] || die "only one command may be specified"
      CMD=$1; SEEN_CMD=1 ;;
    --dry-run)
      [ "$DRY_RUN" -eq 0 ] || die "duplicate --dry-run"
      DRY_RUN=1 ;;
    --acknowledge-excluded)
      [ "$ACKNOWLEDGE" -eq 0 ] || die "duplicate --acknowledge-excluded"
      ACKNOWLEDGE=1 ;;
    *) die "unknown argument '$1'" ;;
  esac
  shift
done
[ "$DRY_RUN" -eq 0 ] || { [ "$CMD" = sync ] || [ "$CMD" = pull ] || die "--dry-run applies only to sync or pull"; }
[ "$ACKNOWLEDGE" -eq 0 ] || { [ "$CMD" = sync ] || [ "$CMD" = pull ] || die "--acknowledge-excluded applies only to sync or pull"; }

contains_control() {
  [[ "$1" =~ [[:cntrl:]] ]]
}
require_plain() {
  if contains_control "$2"; then die "$1 contains an unsupported control byte"; fi
  return 0
}
escape_path() { printf '%q' "$1"; }
need() { command -v "$1" >/dev/null 2>&1 || die "required local command not found: $1"; }

HOST=${OMPUP_HOST:-}
REMOTE_ROOT=${OMPUP_REMOTE_ROOT:-Projects}
LAUNCH=${OMPUP_CMD:-omp}
[ -n "$HOST" ] || die "set OMPUP_HOST to an SSH alias or user@host"
require_plain OMPUP_HOST "$HOST"
case "$HOST" in
  -*|*:*|*[!A-Za-z0-9_.@-]*) die "OMPUP_HOST must be a single SSH alias or user@host token" ;;
esac
[ -n "$REMOTE_ROOT" ] || die "OMPUP_REMOTE_ROOT must not be empty"
require_plain OMPUP_REMOTE_ROOT "$REMOTE_ROOT"
case "$REMOTE_ROOT" in
  /*|*/|*//*|*[^A-Za-z0-9._/-]*) die "OMPUP_REMOTE_ROOT must contain only safe relative path segments" ;;
esac
oldifs=$IFS; IFS=/; set -- $REMOTE_ROOT; IFS=$oldifs
for segment in "$@"; do
  [ -n "$segment" ] && [ "$segment" != . ] && [ "$segment" != .. ] || die "OMPUP_REMOTE_ROOT contains an invalid segment"
done
[ -n "$LAUNCH" ] || die "OMPUP_CMD must not be empty"
require_plain OMPUP_CMD "$LAUNCH"
require_plain OMPUP_EXCLUDES "${OMPUP_EXCLUDES:-}"

need git
need ssh
need rsync
need mv
MV_NO_TARGET_FLAG=-h
if mv --help 2>&1 | grep -q -- '--no-target-directory'; then MV_NO_TARGET_FLAG=-T; fi
absolute_slot() {
  local path=$1 parent name physical
  case "$path" in
    */*) parent=${path%/*}; name=${path##*/}; [ -n "$parent" ] || parent=/ ;;
    *) parent=.; name=$path ;;
  esac
  physical=$(cd "$parent" && pwd -P) || return 1
  if [ "$physical" = / ]; then printf '/%s' "$name"; else printf '%s/%s' "$physical" "$name"; fi
}
move_platform() { mv "$MV_NO_TARGET_FLAG" "$1" "$2"; }
tracked_move() (
  local source=$1 destination=$2 tracker tracker_pid= moved=0 actual
  tracker=$(mktemp -d "${TMPDIR:-/tmp}/ompup-move.XXXXXX") || return 1
  trap '[ -z "$tracker_pid" ] || kill "$tracker_pid" 2>/dev/null || true; rm -rf "$tracker"' EXIT HUP INT TERM
  (
    cd "$source" || exit 1
    : > "$tracker/ready"
    while [ ! -e "$tracker/go" ]; do :; done
    pwd -P > "$tracker/actual"
  ) &
  tracker_pid=$!
  while [ ! -e "$tracker/ready" ]; do
    kill -0 "$tracker_pid" 2>/dev/null || { wait "$tracker_pid" || true; return 1; }
  done
  if move_platform "$source" "$destination"; then moved=1; fi
  : > "$tracker/go"
  wait "$tracker_pid" || return 1
  tracker_pid=
  IFS= read -r actual < "$tracker/actual" || return 1
  [ "$moved" -eq 1 ] || return 1
  printf '%s' "$actual"
)
move_exact() {
  local source destination actual
  source=$(absolute_slot "$1") || return 1
  destination=$(absolute_slot "$2") || return 1
  actual=$(tracked_move "$source" "$destination") || return 1
  [ "$actual" = "$destination" ] && return 0
  if [ ! -e "$source" ] && [ ! -L "$source" ]; then
    tracked_move "$actual" "$source" >/dev/null || return 1
  fi
  return 1
}
STATE_ANCHOR=${XDG_STATE_HOME:-$HOME/.local/state}
STATE_BASE="$STATE_ANCHOR/ompup"

valid_epoch() {
  local value=$1
  case "$value" in ''|0|0*|*[!0-9]*) return 1 ;; esac
  [ "${#value}" -lt 10 ] || { [ "${#value}" -eq 10 ] && [[ "$value" < 2147483648 ]]; }
}

valid_sha1() {
  [ "${#1}" -eq 40 ] || return 1
  case "$1" in *[!0-9a-f]*) return 1 ;; *) return 0 ;; esac
}
# A pull can leave the live root absent after renaming it into its exclusively
# created backup container. Locate only an exactly bound pull journal whose
# recorded backup tree is the current physical directory.
RECOVERY_SOURCE= RECOVERY_ROOT= RECOVERY_KIND=
discover_interrupted_pull() {
  local current token address journal txn_dir project state jcandidate jbackup
  local jseen key value extra jschema= jtoken= joperation= jpre= jtarget= jpreowner= jtargetowner=
  local sseen sroot= saddress= shost= sremote= skind= matches=0
  current=$(pwd -P)
  for journal in "$STATE_BASE"/targets/*/*/transactions/*/journal; do
    [ -f "$journal" ] && [ ! -L "$journal" ] || continue
    txn_dir=${journal%/journal}; token=${txn_dir##*/}
    [[ "$token" =~ ^[0-9]+-[0-9]+$ ]] || continue
    jseen='|'; jschema=; jtoken=; joperation=; jpre=; jtarget=; jpreowner=; jtargetowner=
    jcandidate=; jbackup=
    while IFS=$'\t' read -r key value extra || [ -n "$key" ]; do
      [ -n "$key" ] && [ -z "${extra:-}" ] || { jseen=bad; break; }
      case "$jseen" in *"|$key|"*) jseen=bad; break ;; esac
      jseen="$jseen$key|"
      case "$key" in
        schema) jschema=$value ;; token) jtoken=$value ;; operation) joperation=$value ;;
        pre_epoch) jpre=$value ;; target_epoch) jtarget=$value ;;
        pre_owner) jpreowner=$value ;; target_owner) jtargetowner=$value ;;
        candidate_container) jcandidate=$value ;; backup_container) jbackup=$value ;;
        *) jseen=bad; break ;;
      esac
    done < "$journal"
    [ "$jseen" != bad ] && [ "$jschema" = 2 ] && [ "$jtoken" = "$token" ] &&
      [ "$joperation" = pull ] && valid_epoch "$jpre" && valid_epoch "$jtarget" &&
      { [ "$jpreowner" = local ] || [ "$jpreowner" = remote ]; } &&
      [ "$jtargetowner" = local ] && [ -n "$jcandidate" ] && [ -n "$jbackup" ] || continue
    project=${txn_dir%/transactions/"$token"}; state="$project/state"
    [ -f "$state" ] && [ ! -L "$state" ] || continue
    sseen='|'; sroot=; saddress=; shost=; sremote=; skind=
    while IFS=$'\t' read -r key value extra || [ -n "$key" ]; do
      [ -n "$key" ] && [ -z "${extra:-}" ] || { sseen=bad; break; }
      case "$sseen" in *"|$key|"*) sseen=bad; break ;; esac
      sseen="$sseen$key|"
      case "$key" in
        local_root) sroot=$value ;; address) saddress=$value ;; host) shost=$value ;;
        remote_root) sremote=$value ;; identity_kind) skind=$value ;;
      esac
    done < "$state"
    [ "$sseen" != bad ] && [ "$shost" = "$HOST" ] && [ "$sremote" = "$REMOTE_ROOT" ] &&
      { [ "$skind" = git ] || [ "$skind" = non-git ]; } || continue
    case "$sroot" in /*) ;; *) continue ;; esac
    address=$saddress
    case "$jcandidate" in "${sroot%/*}/.ompup-candidate-$address-$token."??????) ;; *) continue ;; esac
    case "$jbackup" in "${sroot%/*}/.ompup-backup-$address-$token."??????) ;; *) continue ;; esac
    [ "$jbackup/tree" = "$current" ] || continue
    matches=$((matches + 1)); RECOVERY_SOURCE=$current; RECOVERY_ROOT=$sroot; RECOVERY_KIND=$skind
  done
  [ "$matches" -le 1 ] || die "multiple pull recovery journals match the surviving directory"
}
discover_interrupted_pull


# All values embedded in remote shell programs pass through this encoder.
sq() {
  local value=$1
  printf "'%s'" "$(printf '%s' "$value" | sed "s/'/'\\\\''/g")"
}
REMOTE_MOVE_EXACT='move_platform() { if mv --help 2>&1 | grep -q -- "--no-target-directory"; then mv -T "$1" "$2"; else mv -h "$1" "$2"; fi; }; absolute_slot() { local path=$1 parent name physical; case "$path" in */*) parent=${path%/*}; name=${path##*/}; [ -n "$parent" ] || parent=/ ;; *) parent=.; name=$path ;; esac; physical=$(cd "$parent" && pwd -P) || return 1; if [ "$physical" = / ]; then printf "/%s" "$name"; else printf "%s/%s" "$physical" "$name"; fi; }; tracked_move() ( local source=$1 destination=$2 tracker tracker_pid= moved=0 actual; tracker=$(mktemp -d "${TMPDIR:-/tmp}/ompup-move.XXXXXX") || return 1; trap '"'"'[ -z "$tracker_pid" ] || kill "$tracker_pid" 2>/dev/null || true; rm -rf "$tracker"'"'"' EXIT HUP INT TERM; ( cd "$source" || exit 1; : > "$tracker/ready"; while [ ! -e "$tracker/go" ]; do :; done; pwd -P > "$tracker/actual"; ) & tracker_pid=$!; while [ ! -e "$tracker/ready" ]; do kill -0 "$tracker_pid" 2>/dev/null || { wait "$tracker_pid" || true; return 1; }; done; if move_platform "$source" "$destination"; then moved=1; fi; : > "$tracker/go"; wait "$tracker_pid" || return 1; tracker_pid=; IFS= read -r actual < "$tracker/actual" || return 1; [ "$moved" -eq 1 ] || return 1; printf "%s" "$actual"; ); move_exact() { local source destination actual; source=$(absolute_slot "$1") || return 1; destination=$(absolute_slot "$2") || return 1; actual=$(tracked_move "$source" "$destination") || return 1; [ "$actual" = "$destination" ] && return 0; if [ ! -e "$source" ] && [ ! -L "$source" ]; then tracked_move "$actual" "$source" >/dev/null || return 1; fi; return 1; }'
ssh_run() {
  local script=$1
  ssh -o ControlMaster=no -o ControlPath=none -o BatchMode=yes -o StrictHostKeyChecking=yes "$HOST" "bash -c $(sq "$script")"
}
ssh_read() {
  local script=$1
  ssh -o ControlMaster=no -o ControlPath=none -o BatchMode=yes -o StrictHostKeyChecking=yes "$HOST" "bash -c $(sq "$script")"
}
ssh_write() {
  local script=$1 data=$2
  printf '%s' "$data" | ssh -o ControlMaster=no -o ControlPath=none -o BatchMode=yes -o StrictHostKeyChecking=yes "$HOST" "bash -c $(sq "$script")"
}

# Remote managed directories are built one component at a time. Existing
# symlinks or non-directories fail closed instead of being followed by
# mkdir -p, writes, or later recursive cleanup.
remote_safe_dir_prelude() {
  cat <<'EOF'
safe_dir() {
  managed_path=$1
  case "$managed_path" in ''|/*) echo "unsafe managed directory: $managed_path" >&2; exit 2 ;; esac
  managed_oldifs=$IFS
  IFS=/
  set -- $managed_path
  IFS=$managed_oldifs
  managed_current=
  for managed_component in "$@"; do
    [ -n "$managed_component" ] && [ "$managed_component" != . ] && [ "$managed_component" != .. ] ||
      { echo "unsafe managed directory component" >&2; exit 2; }
    managed_current=${managed_current:+$managed_current/}$managed_component
    [ ! -L "$managed_current" ] || { echo "managed directory is a symlink: $managed_current" >&2; exit 2; }
    if [ -e "$managed_current" ]; then
      [ -d "$managed_current" ] || { echo "managed path is not a directory: $managed_current" >&2; exit 2; }
    else
      mkdir "$managed_current" || exit 2
      [ -d "$managed_current" ] && [ ! -L "$managed_current" ] ||
        { echo "could not safely create managed directory: $managed_current" >&2; exit 2; }
    fi
  done
}
require_dir() {
  managed_path=$1
  case "$managed_path" in ''|/*) echo "unsafe managed directory: $managed_path" >&2; exit 2 ;; esac
  managed_oldifs=$IFS
  IFS=/
  set -- $managed_path
  IFS=$managed_oldifs
  managed_current=
  for managed_component in "$@"; do
    managed_current=${managed_current:+$managed_current/}$managed_component
    [ -d "$managed_current" ] && [ ! -L "$managed_current" ] ||
      { echo "managed directory is missing or unsafe: $managed_current" >&2; exit 2; }
  done
}
EOF
}

remote_control_dirs_script() {
  printf '%s\nsafe_dir %s\nsafe_dir %s\nsafe_dir %s\n' \
    "$(remote_safe_dir_prelude)" "$(sq "$REMOTE_ROOT")" "$(sq "$REMOTE_ROOT/.ompup-v2")" "$(sq "$REMOTE_CONTROL")"
}

remote_validate_tree_script() {
  local dir=$1
  cat <<EOF
set -euo pipefail
cd "\$HOME"
dir=$(sq "$dir")
[ -d "\$dir" ] && [ ! -L "\$dir" ] || { echo 'BLOCK:remote tree is missing or unsafe' >&2; exit 2; }
while IFS= read -r -d '' path; do
  rel=\${path#"\$dir"/}; [ "\$path" != "\$dir" ] || rel=.
  case "/\$rel/" in */.git/*) continue ;; esac
  [[ "\$rel" =~ [[:cntrl:]] ]] && { echo 'BLOCK:unsupported control-byte pathname in remote tree' >&2; exit 2; }
  if [ ! -f "\$path" ] && [ ! -d "\$path" ] && [ ! -L "\$path" ]; then
    echo 'BLOCK:unsupported special file in remote tree' >&2
    exit 2
  fi
done < <(find "\$dir" -print0)
EOF
}
require_remote_tree() {
  local dir=$1 output
  output=$(ssh_read "$(remote_validate_tree_script "$dir")" 2>&1) ||
    die "${output:-remote tree validation failed}"
}

# Context-free, domain-separated SHA-1. GIT_DIR prevents ambient repository
# object format/configuration from affecting the stable protocol address.
hash_fields() {
  local domain=$1; shift
  { printf 'ompup-v2:%s\000' "$domain"; for field in "$@"; do printf '%s\000' "$field"; done; } |
    env GIT_DIR=/dev/null git hash-object --stdin
}

# Discover a valid Git root, but never downgrade a broken worktree to non-Git.
ROOT=
IDENTITY_KIND=
ORIGIN=
LOCAL_INSPECT_ROOT=${RECOVERY_SOURCE:-$(pwd -P)}
if discovered=$(env GIT_OPTIONAL_LOCKS=0 git -C "$LOCAL_INSPECT_ROOT" rev-parse --show-toplevel 2>/dev/null); then
  discovered=$(cd "$discovered" && pwd -P)
  [ "$discovered" = "$LOCAL_INSPECT_ROOT" ] || die "pull recovery must start from the surviving project root"
  ROOT=${RECOVERY_ROOT:-$discovered}
  IDENTITY_KIND=git
  [ -z "$RECOVERY_KIND" ] || [ "$RECOVERY_KIND" = git ] || die "pull recovery identity kind mismatch"
  origins=$(env GIT_OPTIONAL_LOCKS=0 git -C "$LOCAL_INSPECT_ROOT" remote get-url --all origin 2>/dev/null || true)
  [ -n "$origins" ] || die "Git project requires exactly one remote.origin.url"
  case "$origins" in *$'\n'*) die "Git project requires exactly one remote.origin.url" ;; esac
  require_plain remote.origin.url "$origins"
  ORIGIN=$origins
else
  ROOT=${RECOVERY_ROOT:-$LOCAL_INSPECT_ROOT}
  IDENTITY_KIND=non-git
  [ -z "$RECOVERY_KIND" ] || [ "$RECOVERY_KIND" = non-git ] || die "pull recovery identity kind mismatch"
  probe=$LOCAL_INSPECT_ROOT
  while :; do
    if [ -e "$probe/.git" ] || [ -L "$probe/.git" ]; then
      die "found .git at '$probe' but Git validation failed; refusing non-Git downgrade"
    fi
    [ "$probe" = / ] && break
    probe=${probe%/*}; [ -n "$probe" ] || probe=/
  done
fi
require_plain "project root" "$ROOT"

if [ "$IDENTITY_KIND" = git ]; then
  IDENTITY_HASH=$(hash_fields git-origin "$ORIGIN")
  slug_source=${ORIGIN%/}; slug_source=${slug_source##*/}; slug_source=${slug_source%.git}
else
  IDENTITY_HASH=$(hash_fields non-git-path "$ROOT")
  slug_source=${ROOT##*/}
fi
slug=$(printf '%s' "$slug_source" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9._-][^a-z0-9._-]*/-/g; s/^-*//; s/-*$//')
[ -n "$slug" ] || slug=project
ADDRESS="$slug--${IDENTITY_HASH%${IDENTITY_HASH#????????????}}"
SESSION_SLUG=$(printf '%.32s' "$slug")
SESSION="ompup-$SESSION_SLUG-${IDENTITY_HASH%${IDENTITY_HASH#????????????}}"
TARGET_HASH=$(hash_fields target "$HOST" "$REMOTE_ROOT")
REMOTE_DIR="$REMOTE_ROOT/$ADDRESS"
REMOTE_CONTROL="$REMOTE_ROOT/.ompup-v2/$ADDRESS"
REMOTE_LOCK="$REMOTE_ROOT/.ompup-v2/locks/$ADDRESS.lock"
PROJECT_STATE="$STATE_BASE/targets/$TARGET_HASH/$ADDRESS"
STATE_FILE="$PROJECT_STATE/state"
BASELINES="$PROJECT_STATE/baselines"
TRANSACTIONS="$PROJECT_STATE/transactions"
LOCAL_LOCK="$STATE_BASE/locks/$TARGET_HASH--$ADDRESS.lock"

# Reject control-byte pathnames and unsupported transferable types before any
# mutation. Do not inspect protected .git subtrees.
validate_tree() {
  local base=$1 path rel
  while IFS= read -r -d '' path; do
    rel=${path#"$base"/}; [ "$path" != "$base" ] || rel=.
    case "/$rel/" in */.git/*) continue ;; esac
    contains_control "$rel" && die "unsupported control-byte pathname in local tree"
    if [ ! -f "$path" ] && [ ! -d "$path" ] && [ ! -L "$path" ]; then
      die "unsupported special file in local tree"
    fi
  done < <(find "$base" -print0)
}
validate_tree "$LOCAL_INSPECT_ROOT"

FILTER_KINDS=()
FILTER_RULES=()
add_filter() { FILTER_KINDS+=("$1"); FILTER_RULES+=("$2"); }
add_default_filters() {
  add_filter exclude .git
  add_filter include .ompupignore
  add_filter include .env.example
  add_filter include .env.sample
  local rule
  for rule in '.env' '.env.*' '*.pem' '*.key' '*.p12' '*.pfx' '.ssh/' '.aws/' '.gnupg/' '.netrc' '.npmrc' '.pypirc' '.git-credentials' '.docker/config.json' '.kube/' '.config/gh/hosts.yml' 'node_modules/' '.venv/' 'venv/' '__pycache__/' '.pytest_cache/' '.mypy_cache/' 'target/' 'dist/' 'build/' '.next/' '.turbo/' '.cache/' '.DS_Store'; do
    add_filter exclude "$rule"
  done
}
add_ignore_text() {
  local text=$1 label=$2 rule
  while IFS= read -r rule || [ -n "$rule" ]; do
    contains_control "$rule" && die "$label contains an unsupported control byte"
    [ -n "$rule" ] && add_filter exclude "$rule"
  done <<< "$text"
  return 0
}
add_extra_filters() {
  if [ -n "${OMPUP_EXCLUDES:-}" ]; then
    local extras=() old=$IFS rule
    IFS=: read -r -a extras <<< "$OMPUP_EXCLUDES"
    IFS=$old
    for rule in "${extras[@]}"; do [ -n "$rule" ] && add_filter exclude "$rule"; done
  fi
}
build_filters() {
  FILTER_KINDS=(); FILTER_RULES=()
  add_default_filters
  if [ -f "$LOCAL_INSPECT_ROOT/.ompupignore" ]; then
    local local_ignore
    local_ignore=$(cat "$LOCAL_INSPECT_ROOT/.ompupignore")
    add_ignore_text "$local_ignore" ".ompupignore"
  fi
  add_extra_filters
}
build_filters

FILTER_ARGS=()
make_filter_args() {
  FILTER_ARGS=()
  local i=0
  while [ "$i" -lt "${#FILTER_RULES[@]}" ]; do
    if [ "${FILTER_KINDS[$i]}" = include ]; then FILTER_ARGS+=("--include=${FILTER_RULES[$i]}")
    else FILTER_ARGS+=("--exclude=${FILTER_RULES[$i]}")
    fi
    i=$((i + 1))
  done
}
make_filter_args
filter_digest() {
  { local i=0; while [ "$i" -lt "${#FILTER_RULES[@]}" ]; do printf '%s\t%s\n' "${FILTER_KINDS[$i]}" "${FILTER_RULES[$i]}"; i=$((i + 1)); done; } |
    env GIT_DIR=/dev/null git hash-object --stdin
}
FILTER_DIGEST=$(filter_digest)
print_policy() {
  say "filter-policy: convenience denylist, not a secret scanner"
  local i=0
  while [ "$i" -lt "${#FILTER_RULES[@]}" ]; do say "filter: ${FILTER_KINDS[$i]} ${FILTER_RULES[$i]}"; i=$((i + 1)); done
}

# Git tuple is mode<TAB>branch-or--<TAB>oid-or-. Validation rejects index
# state that cannot cross the immutable .git boundary.
GIT_MODE=none GIT_BRANCH=- GIT_OID=-
local_git_tuple() {
  [ "$IDENTITY_KIND" = git ] || { GIT_MODE=none; GIT_BRANCH=-; GIT_OID=-; return; }
  env GIT_OPTIONAL_LOCKS=0 git -C "$LOCAL_INSPECT_ROOT" diff --cached --quiet --ignore-submodules -- || die "local Git index has staged changes"
  [ -z "$(env GIT_OPTIONAL_LOCKS=0 git -C "$LOCAL_INSPECT_ROOT" ls-files -u)" ] || die "local Git has unmerged entries"
  sparse=$(env GIT_OPTIONAL_LOCKS=0 git -C "$LOCAL_INSPECT_ROOT" config --bool core.sparseCheckout 2>/dev/null || true)
  [ "$sparse" != true ] || die "local Git sparse checkout is unsupported"
  [ -z "$(env GIT_OPTIONAL_LOCKS=0 git -C "$LOCAL_INSPECT_ROOT" ls-files -s | sed -n '/^160000 /p')" ] || die "local Gitlinks/submodules are unsupported"
  gd=$(env GIT_OPTIONAL_LOCKS=0 git -C "$LOCAL_INSPECT_ROOT" rev-parse --git-dir)
  case "$gd" in /*) ;; *) gd="$LOCAL_INSPECT_ROOT/$gd" ;; esac
  for op in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-apply rebase-merge; do [ ! -e "$gd/$op" ] || die "local Git operation in progress: $op"; done
  if oid=$(env GIT_OPTIONAL_LOCKS=0 git -C "$LOCAL_INSPECT_ROOT" rev-parse --verify HEAD 2>/dev/null); then
    GIT_OID=$oid
    if branch=$(env GIT_OPTIONAL_LOCKS=0 git -C "$LOCAL_INSPECT_ROOT" symbolic-ref --quiet --short HEAD 2>/dev/null); then GIT_MODE=branch; GIT_BRANCH=$branch
    else GIT_MODE=detached; GIT_BRANCH=-; fi
  else
    branch=$(env GIT_OPTIONAL_LOCKS=0 git -C "$LOCAL_INSPECT_ROOT" symbolic-ref --quiet --short HEAD 2>/dev/null) || die "invalid unborn Git HEAD"
    GIT_MODE=unborn; GIT_BRANCH=$branch; GIT_OID=-
  fi
}
local_git_tuple
require_local_path_git_match() {
  local dir=$1 origin gd oid branch mode
  if [ "$IDENTITY_KIND" = non-git ]; then
    [ ! -e "$dir/.git" ] && [ ! -L "$dir/.git" ] || die "local candidate unexpectedly contains .git"
    return 0
  fi
  [ -e "$dir/.git" ] || die "local candidate Git metadata is missing"
  origin=$(env GIT_OPTIONAL_LOCKS=0 git -C "$dir" remote get-url --all origin 2>/dev/null || true)
  [ "$origin" = "$ORIGIN" ] || die "local candidate Git origin differs"
  env GIT_OPTIONAL_LOCKS=0 git -C "$dir" diff --cached --quiet --ignore-submodules -- || die "local candidate Git index has staged changes"
  [ -z "$(env GIT_OPTIONAL_LOCKS=0 git -C "$dir" ls-files -u)" ] || die "local candidate Git has unmerged entries"
  [ "$(env GIT_OPTIONAL_LOCKS=0 git -C "$dir" config --bool core.sparseCheckout 2>/dev/null || true)" != true ] ||
    die "local candidate sparse checkout is unsupported"
  [ -z "$(env GIT_OPTIONAL_LOCKS=0 git -C "$dir" ls-files -s | sed -n '/^160000 /p')" ] || die "local candidate Gitlink is unsupported"
  gd=$(env GIT_OPTIONAL_LOCKS=0 git -C "$dir" rev-parse --git-dir); case "$gd" in /*) ;; *) gd="$dir/$gd" ;; esac
  for op in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-apply rebase-merge; do
    [ ! -e "$gd/$op" ] || die "local candidate Git operation in progress: $op"
  done
  if oid=$(env GIT_OPTIONAL_LOCKS=0 git -C "$dir" rev-parse --verify HEAD 2>/dev/null); then
    if branch=$(env GIT_OPTIONAL_LOCKS=0 git -C "$dir" symbolic-ref --quiet --short HEAD 2>/dev/null); then mode=branch
    else mode=detached; branch=-; fi
  else
    branch=$(env GIT_OPTIONAL_LOCKS=0 git -C "$dir" symbolic-ref --quiet --short HEAD 2>/dev/null) ||
      die "invalid local candidate unborn Git HEAD"
    mode=unborn; oid=-
  fi
  [ "$mode/$branch/$oid" = "$GIT_MODE/$GIT_BRANCH/$GIT_OID" ] || die "local candidate Git tuple changed"
}

require_live_local_git_tuple() {
  require_local_path_git_match "$LOCAL_INSPECT_ROOT"
}

remote_git_tuple_script() {
  local dir=$1
  cat <<EOF
set -eu
cd "\$HOME"
dir=$(sq "$dir")
if [ $(sq "$IDENTITY_KIND") = non-git ]; then
  [ ! -e "\$dir/.git" ] || { echo 'BLOCK:remote unexpectedly contains .git'; exit 2; }
  printf 'none\t-\t-\n'; exit 0
fi
[ -e "\$dir/.git" ] || { echo 'BLOCK:remote Git metadata is missing'; exit 2; }
origin=\$(GIT_OPTIONAL_LOCKS=0 git -C "\$dir" remote get-url --all origin 2>/dev/null || true)
[ "\$origin" = $(sq "$ORIGIN") ] || { echo 'BLOCK:remote origin differs'; exit 2; }
GIT_OPTIONAL_LOCKS=0 git -C "\$dir" diff --cached --quiet --ignore-submodules -- || { echo 'BLOCK:remote Git index has staged changes'; exit 2; }
[ -z "\$(GIT_OPTIONAL_LOCKS=0 git -C "\$dir" ls-files -u)" ] || { echo 'BLOCK:remote Git has unmerged entries'; exit 2; }
[ "\$(GIT_OPTIONAL_LOCKS=0 git -C "\$dir" config --bool core.sparseCheckout 2>/dev/null || true)" != true ] || { echo 'BLOCK:remote sparse checkout'; exit 2; }
[ -z "\$(GIT_OPTIONAL_LOCKS=0 git -C "\$dir" ls-files -s | sed -n '/^160000 /p')" ] || { echo 'BLOCK:remote Gitlink'; exit 2; }
gd=\$(GIT_OPTIONAL_LOCKS=0 git -C "\$dir" rev-parse --git-dir); case "\$gd" in /*) ;; *) gd="\$dir/\$gd";; esac
for op in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-apply rebase-merge; do [ ! -e "\$gd/\$op" ] || { echo "BLOCK:remote Git operation \$op"; exit 2; }; done
if oid=\$(GIT_OPTIONAL_LOCKS=0 git -C "\$dir" rev-parse --verify HEAD 2>/dev/null); then
  if branch=\$(GIT_OPTIONAL_LOCKS=0 git -C "\$dir" symbolic-ref --quiet --short HEAD 2>/dev/null); then printf 'branch\t%s\t%s\n' "\$branch" "\$oid"; else printf 'detached\t-\t%s\n' "\$oid"; fi
else
  branch=\$(GIT_OPTIONAL_LOCKS=0 git -C "\$dir" symbolic-ref --quiet --short HEAD 2>/dev/null) || { echo 'BLOCK:invalid remote unborn HEAD'; exit 2; }
  printf 'unborn\t%s\t-\n' "\$branch"
fi
EOF
}
REMOTE_GIT_MODE=- REMOTE_GIT_BRANCH=- REMOTE_GIT_OID=-
read_remote_git_tuple() {
  local tuple
  tuple=$(ssh_read "$(remote_git_tuple_script "$REMOTE_DIR")") || die "${tuple:-remote Git validation failed}"
  IFS=$'\t' read -r REMOTE_GIT_MODE REMOTE_GIT_BRANCH REMOTE_GIT_OID extra <<< "$tuple"
  [ -z "${extra:-}" ] && [ -n "$REMOTE_GIT_MODE" ] || die "malformed remote Git tuple"
}
require_git_match() {
  read_remote_git_tuple
  [ "$REMOTE_GIT_MODE" = "$GIT_MODE" ] && [ "$REMOTE_GIT_BRANCH" = "$GIT_BRANCH" ] && [ "$REMOTE_GIT_OID" = "$GIT_OID" ] ||
    die "remote Git tuple diverged (local $GIT_MODE/$GIT_BRANCH/$GIT_OID; remote $REMOTE_GIT_MODE/$REMOTE_GIT_BRANCH/$REMOTE_GIT_OID)"
}

# Strict state parser: no sourcing, duplicates, unknowns, or omissions.
STATE_PRESENT=0 ST_OWNER= ST_EPOCH= ST_BASELINE_EPOCH= ST_FILTER_DIGEST= ST_ACK_DIGEST= ST_GIT_MODE= ST_GIT_BRANCH= ST_GIT_OID=
require_remote_path_git_match() {
  local path=$1 tuple mode branch oid extra
  tuple=$(ssh_read "$(remote_git_tuple_script "$path")") || die "${tuple:-remote candidate Git validation failed}"
  IFS=$'\t' read -r mode branch oid extra <<< "$tuple"
  [ -z "${extra:-}" ] && [ "$mode" = "$GIT_MODE" ] && [ "$branch" = "$GIT_BRANCH" ] && [ "$oid" = "$GIT_OID" ] ||
    die "remote candidate Git tuple does not match local"
}
validate_baseline_generation() {
  local epoch=$1 generation
  valid_epoch "$epoch" || die "invalid baseline epoch"
  [ -d "$BASELINES" ] && [ ! -L "$BASELINES" ] || die "state baselines directory is missing or unsafe"
  generation="$BASELINES/$epoch"
  [ -d "$generation" ] && [ ! -L "$generation" ] &&
    [ -d "$generation/tree" ] && [ ! -L "$generation/tree" ] &&
    [ -f "$generation/rules" ] && [ ! -L "$generation/rules" ] ||
    die "state baseline generation is missing or unsafe"
}
check_baseline_generation_removal() {
  local epoch=$1 generation
  valid_epoch "$epoch" || die "refusing invalid baseline generation deletion"
  [ -e "$BASELINES" ] || return 0
  [ -d "$BASELINES" ] && [ ! -L "$BASELINES" ] || die "refusing unsafe baselines directory deletion"
  generation="$BASELINES/$epoch"
  [ -e "$generation" ] || [ -L "$generation" ] || return 0
  [ -d "$generation" ] && [ ! -L "$generation" ] || die "refusing symlink baseline generation deletion"
}
remove_baseline_generation() {
  local epoch=$1 generation
  check_baseline_generation_removal "$epoch"
  generation="$BASELINES/$epoch"
  [ -e "$generation" ] || return 0
  rm -rf -- "$generation"
}
next_epoch() {
  valid_epoch "$1" || die "invalid state epoch"
  [ "$1" != 2147483647 ] || die "state epoch is exhausted"
  printf '%s' $((1 + $1))
}

validate_existing_local_dir_chain() {
  local path=$1 parent
  if [ "$path" = "$STATE_ANCHOR" ]; then
    if [ -e "$path" ] || [ -L "$path" ]; then
      [ -d "$path" ] && [ ! -L "$path" ] || die "managed local directory is unsafe: $path"
    fi
    return 0
  fi
  case "$path/" in "$STATE_ANCHOR/"*) ;; *) die "managed local path escapes the state root: $path" ;; esac
  parent=${path%/*}; [ "$parent" != "$path" ] || die "invalid managed local path: $path"
  validate_existing_local_dir_chain "$parent"
  if [ -e "$path" ] || [ -L "$path" ]; then
    [ -d "$path" ] && [ ! -L "$path" ] || die "managed local directory is unsafe: $path"
  fi
}

ensure_local_dir() {
  local path=$1 parent
  validate_existing_local_dir_chain "$path"
  [ -d "$path" ] && return 0
  if [ "$path" = "$STATE_ANCHOR" ]; then
    mkdir -p "$path" || die "cannot create local state root: $path"
  else
    parent=${path%/*}; [ "$parent" != "$path" ] || die "invalid managed local path: $path"
    ensure_local_dir "$parent"
    if ! mkdir "$path" 2>/dev/null; then
      [ -d "$path" ] && [ ! -L "$path" ] || die "cannot safely create managed local directory: $path"
    fi
  fi
  [ -d "$path" ] && [ ! -L "$path" ] || die "cannot safely create managed local directory: $path"
}

require_local_dir() {
  validate_existing_local_dir_chain "$1"
  [ -d "$1" ] && [ ! -L "$1" ] || die "managed local directory is missing or unsafe: $1"
}

write_exclusive_file() {
  local path=$1 text=$2
  [ ! -e "$path" ] && [ ! -L "$path" ] || die "exclusive managed file already exists: $path"
  (umask 077; set -C; printf '%s' "$text" > "$path") ||
    die "cannot exclusively create managed file: $path"
  [ -f "$path" ] && [ ! -L "$path" ] || die "managed file is not a regular file: $path"
}

safe_remove_local_dir() {
  require_local_dir "$1"
  rm -rf -- "$1"
}

read_state() {
  STATE_PRESENT=0
  [ ! -L "$STATE_FILE" ] || die "state file must not be a symlink"
  [ -f "$STATE_FILE" ] || return 0
  local seen='|' key value extra
  while IFS=$'\t' read -r key value extra || [ -n "$key" ]; do
    [ -n "$key" ] && [ -z "${extra:-}" ] || die "malformed state file"
    case "$seen" in *"|$key|"*) die "duplicate state field: $key" ;; esac
    seen="$seen$key|"
    case "$key" in
      schema) [ "$value" = 2 ] || die "unsupported state schema" ;;
      identity_kind) [ "$value" = "$IDENTITY_KIND" ] || die "state identity kind mismatch" ;;
      identity_hash) [ "$value" = "$IDENTITY_HASH" ] || die "state identity hash mismatch" ;;
      address) [ "$value" = "$ADDRESS" ] || die "state address mismatch" ;;
      local_root) [ "$value" = "$ROOT" ] || die "state belongs to a different local checkout" ;;
      host) [ "$value" = "$HOST" ] || die "state host mismatch" ;;
      remote_root) [ "$value" = "$REMOTE_ROOT" ] || die "state remote root mismatch" ;;
      remote_dir) [ "$value" = "$REMOTE_DIR" ] || die "state remote directory mismatch" ;;
      tmux_session) [ "$value" = "$SESSION" ] || die "state tmux session mismatch" ;;
      epoch) ST_EPOCH=$value ;;
      owner) ST_OWNER=$value ;;
      baseline_epoch) ST_BASELINE_EPOCH=$value ;;
      filter_digest) ST_FILTER_DIGEST=$value ;;
      exclude_ack_digest) ST_ACK_DIGEST=$value ;;
      git_mode) ST_GIT_MODE=$value ;;
      git_branch) ST_GIT_BRANCH=$value ;;
      git_oid) ST_GIT_OID=$value ;;
      *) die "unknown state field: $key" ;;
    esac
  done < "$STATE_FILE"
  for key in schema identity_kind identity_hash address local_root host remote_root remote_dir tmux_session epoch owner baseline_epoch filter_digest exclude_ack_digest git_mode git_branch git_oid; do
    case "$seen" in *"|$key|"*) ;; *) die "missing state field: $key" ;; esac
  done
  valid_epoch "$ST_EPOCH" || die "invalid state epoch"
  valid_epoch "$ST_BASELINE_EPOCH" || die "invalid state baseline epoch"
  [ "$ST_BASELINE_EPOCH" = "$ST_EPOCH" ] || die "state baseline epoch mismatch"
  [ "$ST_OWNER" = local ] || [ "$ST_OWNER" = remote ] || die "invalid state owner"
  case "$ST_GIT_MODE" in none|branch|detached|unborn) ;; *) die "invalid state Git mode" ;; esac
  require_plain "state Git branch" "$ST_GIT_BRANCH"; require_plain "state Git OID" "$ST_GIT_OID"
  valid_sha1 "$ST_FILTER_DIGEST" || die "invalid state filter digest"
  [ "$ST_ACK_DIGEST" = - ] || valid_sha1 "$ST_ACK_DIGEST" || die "invalid state acknowledgement digest"
  validate_baseline_generation "$ST_BASELINE_EPOCH"
  STATE_PRESENT=1
}
validate_existing_local_dir_chain "$PROJECT_STATE"
read_state

marker_text() {
  printf 'schema\t2\nidentity_hash\t%s\nidentity_kind\t%s\naddress\t%s\ncreated_by_version\t%s\n' "$IDENTITY_HASH" "$IDENTITY_KIND" "$ADDRESS" "$VERSION"
}
MARKER_ERROR=
validate_marker_text() {
  local text=$1 seen='|' key value extra count=0
  MARKER_ERROR=
  while IFS=$'\t' read -r key value extra; do
    if [ -z "$key" ] || [ -n "${extra:-}" ]; then MARKER_ERROR="malformed remote marker"; return 1; fi
    case "$seen" in *"|$key|"*) MARKER_ERROR="duplicate remote marker field: $key"; return 1 ;; esac
    seen="$seen$key|"; count=$((count + 1))
    case "$key" in
      schema) [ "$value" = 2 ] || { MARKER_ERROR="remote marker schema mismatch"; return 1; } ;;
      identity_hash) [ "$value" = "$IDENTITY_HASH" ] || { MARKER_ERROR="remote marker identity mismatch"; return 1; } ;;
      identity_kind) [ "$value" = "$IDENTITY_KIND" ] || { MARKER_ERROR="remote marker kind mismatch"; return 1; } ;;
      address) [ "$value" = "$ADDRESS" ] || { MARKER_ERROR="remote marker address mismatch"; return 1; } ;;
      created_by_version) [ "$value" = "$VERSION" ] || { MARKER_ERROR="remote marker version mismatch"; return 1; } ;;
      *) MARKER_ERROR="unknown remote marker field: $key"; return 1 ;;
    esac
  done <<< "$text"
  [ "$count" -eq 5 ] || { MARKER_ERROR="remote marker is incomplete"; return 1; }
  return 0
}
require_marker() {
  local text
  text=$(ssh_read "set -eu; cd \"\$HOME\"; $(remote_safe_dir_prelude); require_dir $(sq "$REMOTE_CONTROL"); marker=$(sq "$REMOTE_CONTROL/marker"); [ -f \"\$marker\" ] && [ ! -L \"\$marker\" ]; cat \"\$marker\"") ||
    die "remote marker is missing or unsafe; refusing destination adoption"
  validate_marker_text "$text" || die "$MARKER_ERROR"
}
remote_destination_state() {
  ssh_run "cd \"\$HOME\"; dir=$(sq "$REMOTE_DIR"); marker=$(sq "$REMOTE_CONTROL/marker"); if [ -e \"\$dir\" ] || [ -L \"\$dir\" ]; then [ -d \"\$dir\" ] && [ ! -L \"\$dir\" ] || exit 2; if [ -f \"\$marker\" ] && [ ! -L \"\$marker\" ]; then echo marked; else echo unmarked; fi; else echo absent; fi"
}

load_frozen_filters() {
  FILTER_KINDS=(); FILTER_RULES=()
  local kind rule extra
  while IFS=$'\t' read -r kind rule extra || [ -n "$kind" ]; do
    [ -z "${extra:-}" ] && { [ "$kind" = include ] || [ "$kind" = exclude ]; } || die "malformed baseline filter rules"
    contains_control "$rule" && die "malformed baseline filter rule"
    add_filter "$kind" "$rule"
  done < "$BASELINES/$ST_BASELINE_EPOCH/rules"
  [ "${FILTER_KINDS[0]:-}" = exclude ] && [ "${FILTER_RULES[0]:-}" = .git ] || die "baseline does not protect .git"
  make_filter_args
}
RULES_TEXT=
freeze_rules_text() {
  [ -z "$RULES_TEXT" ] || return 0
  local i=0 text=
  while [ "$i" -lt "${#FILTER_RULES[@]}" ]; do
    text="${text}${FILTER_KINDS[$i]}"$'\t'"${FILTER_RULES[$i]}"$'\n'
    i=$((i + 1))
  done
  RULES_TEXT=$text
}
write_rules() {
  local file=$1
  freeze_rules_text
  write_exclusive_file "$file" "$RULES_TEXT"
}

RSYNC_COMMON=(-rltpc --prune-empty-dirs)
SSH_TRANSPORT='ssh -o ControlMaster=no -o ControlPath=none -o BatchMode=yes -o StrictHostKeyChecking=yes'
rsync_copy_local() {
  local source=$1 destination=$2
  [ -d "$destination" ] && [ ! -L "$destination" ] || die "local rsync destination is unsafe"
  (cd "$destination" && rsync "${RSYNC_COMMON[@]}" --delete "${FILTER_ARGS[@]}" "$source/" ./)
}
rsync_local_to_remote_container() {
  local source=$1 container=$2 nonce remote_command
  nonce=$(container_nonce candidate "$container")
  remote_command="cd $(sq "$container") && [ -d . ] && [ \"\$(cat .ompup-nonce 2>/dev/null || true)\" = $(sq "$nonce") ] && [ -f .ompup-nonce ] && [ ! -L .ompup-nonce ] && [ -d tree ] && [ ! -L tree ] && exec rsync"
  rsync -e "$SSH_TRANSPORT" --rsync-path="$remote_command" "${RSYNC_COMMON[@]}" --delete \
    "${FILTER_ARGS[@]}" "$source/" "$HOST:tree/"
}
rsync_remote_to_local() {
  local source=$1 destination=$2
  [ -d "$destination" ] && [ ! -L "$destination" ] || die "local rsync destination is unsafe"
  (cd "$destination" && rsync -e "$SSH_TRANSPORT" "${RSYNC_COMMON[@]}" --delete "${FILTER_ARGS[@]}" "$HOST:$source/" ./)
}
compare_local() {
  { rsync "${RSYNC_COMMON[@]}" -ni --out-format=$'%i\t%n' "${FILTER_ARGS[@]}" "$1/" "$2/"
    rsync "${RSYNC_COMMON[@]}" -ni --out-format=$'%i\t%n' "${FILTER_ARGS[@]}" "$2/" "$1/"
  } | sed -e $'/^\\.d\\.\\.t\\.\\.\\.\\.\\t/d' -e $'/^\\.d\\.\\.t\\.\\.\\.\\.\\.\\.\\t/d' | sort -u
}
compare_remote() {
  { rsync -e "$SSH_TRANSPORT" "${RSYNC_COMMON[@]}" -ni --out-format=$'%i\t%n' "${FILTER_ARGS[@]}" "$1/" "$HOST:$2/"
    rsync -e "$SSH_TRANSPORT" "${RSYNC_COMMON[@]}" -ni --out-format=$'%i\t%n' "${FILTER_ARGS[@]}" "$HOST:$2/" "$1/"
  } | sed -e $'/^\\.d\\.\\.t\\.\\.\\.\\.\\t/d' -e $'/^\\.d\\.\\.t\\.\\.\\.\\.\\.\\.\\t/d' | sort -u
}

LOCAL_CHANGES= REMOTE_CHANGES=
compute_changes() {
  load_frozen_filters
  validate_tree "$ROOT"
  require_remote_tree "$REMOTE_DIR"
  LOCAL_CHANGES=$(compare_local "$BASELINES/$ST_BASELINE_EPOCH/tree" "$ROOT" || die "failed to compare local tree")
  REMOTE_CHANGES=$(compare_remote "$BASELINES/$ST_BASELINE_EPOCH/tree" "$REMOTE_DIR" || die "failed to compare remote tree")
}
require_effective_owner() {
  local expected=$1
  if [ -n "$LOCAL_CHANGES" ] && [ -n "$REMOTE_CHANGES" ]; then
    print_change_set local-changed "$LOCAL_CHANGES"; print_change_set remote-changed "$REMOTE_CHANGES"
    die "ownership is unknown-conflict; both sides changed"
  fi
  if [ "$ST_OWNER" = remote ] && [ -n "$LOCAL_CHANGES" ]; then
    print_change_set local-changed "$LOCAL_CHANGES"
    die "non-owning local side changed; ownership is unknown-conflict"
  fi
  if [ "$ST_OWNER" = local ] && [ -n "$REMOTE_CHANGES" ]; then
    print_change_set remote-changed "$REMOTE_CHANGES"
    die "non-owning remote side changed; ownership is unknown-conflict"
  fi
  [ "$ST_OWNER" = "$expected" ] || die "$ST_OWNER already owns the tree; explicit handoff from $expected is required"
}
print_change_set() {
  local label=$1 data=$2 line prefix path rendered
  if [ -z "$data" ]; then say "$label: (none)"; return; fi
  say "$label:"
  while IFS= read -r line; do
    case "$line" in
      *$'\t'*) prefix=${line%%$'\t'*}; path=${line#*$'\t'}; rendered=$(escape_path "$path"); say "  $prefix	$rendered" ;;
      *) rendered=$(escape_path "$line"); say "  $rendered" ;;
    esac
  done <<< "$data"
}
common_changes() {
  local a b ap bp out=
  while IFS= read -r a; do
    [ -n "$a" ] || continue; ap=${a#*$'\t'}
    while IFS= read -r b; do [ -n "$b" ] || continue; bp=${b#*$'\t'}; [ "$ap" = "$bp" ] && out="${out}${out:+$'\n'}$ap"; done <<< "$REMOTE_CHANGES"
  done <<< "$LOCAL_CHANGES"
  printf '%s' "$out"
}

# Determine tracked paths omitted by rsync's actual filter engine. The dry-run
# destination is deliberately absent; rsync -n creates nothing.
TRACKED_EXCLUDED= ACK_DIGEST=-
compute_tracked_excluded() {
  TRACKED_EXCLUDED=; ACK_DIGEST=-
  [ "$IDENTITY_KIND" = git ] || return 0
  local probe="${TMPDIR:-/tmp}/.ompup-filter-probe-$IDENTITY_HASH-$$" listing path included line
  [ ! -e "$probe" ] || die "filter probe path unexpectedly exists: $probe"
  listing=$(rsync -rltpcni --out-format='%n' "${FILTER_ARGS[@]}" "$LOCAL_INSPECT_ROOT/" "$probe/" || die "cannot inspect filter policy")
  while IFS= read -r -d '' path; do
    included=0
    while IFS= read -r line; do
      [ "$line" = "$path" ] && included=1
    done <<< "$listing"
    if [ "$included" -eq 0 ]; then TRACKED_EXCLUDED="${TRACKED_EXCLUDED}${TRACKED_EXCLUDED:+$'\n'}$path"; fi
  done < <(env GIT_OPTIONAL_LOCKS=0 git -C "$LOCAL_INSPECT_ROOT" ls-files -z)
  if [ -n "$TRACKED_EXCLUDED" ]; then
    ACK_DIGEST=$({ printf '%s\n' "$FILTER_DIGEST"; printf '%s\n' "$TRACKED_EXCLUDED"; } | env GIT_DIR=/dev/null git hash-object --stdin)
  fi
}
compute_tracked_excluded
check_ack() {
  [ -z "$TRACKED_EXCLUDED" ] && return 0
  say "tracked-excluded:"
  while IFS= read -r path; do say "  $(escape_path "$path")"; done <<< "$TRACKED_EXCLUDED"
  if [ "$ST_ACK_DIGEST" = "$ACK_DIGEST" ]; then return 0; fi
  [ "$ACKNOWLEDGE" -eq 1 ] || die "tracked files are excluded; review them and rerun with --acknowledge-excluded"
  say "exclude-acknowledgement: $ACK_DIGEST"
}

TOKEN="$$-$(date +%s)"
LOCKED_LOCAL=0 LOCKED_REMOTE=0 PUBLISHED=0 LOCAL_STAGE=
LOCAL_CANDIDATE_CONTAINER= LOCAL_BACKUP_CONTAINER=
REMOTE_CANDIDATE_CONTAINER= REMOTE_BACKUP_CONTAINER=
container_nonce() { hash_fields transaction-container "$IDENTITY_HASH" "$1" "$2"; }
require_local_container() {
  local path=$1 kind=$2 expected
  expected=$(container_nonce "$kind" "$path")
  [ -d "$path" ] && [ ! -L "$path" ] &&
    [ -f "$path/.ompup-nonce" ] && [ ! -L "$path/.ompup-nonce" ] &&
    [ "$(cat "$path/.ompup-nonce")" = "$expected" ] ||
    die "transaction $kind container is missing, replaced, or unsafe"
}
create_local_container() {
  local kind=$1 parent=$2 path
  [ -d "$parent" ] && [ ! -L "$parent" ] || die "transaction container parent is unsafe"
  path=$(mktemp -d "$parent/.ompup-$kind-$ADDRESS-$TOKEN.XXXXXX") ||
    die "cannot exclusively create local $kind container"
  case "$path" in "$parent/.ompup-$kind-$ADDRESS-$TOKEN."??????) ;; *) die "mktemp returned an invalid local container path" ;; esac
  [ -d "$path" ] && [ ! -L "$path" ] || die "new local $kind container is unsafe"
  write_exclusive_file "$path/.ompup-nonce" "$(container_nonce "$kind" "$path")"$'\n'
  CREATED_CONTAINER=$path
}
remove_local_container() {
  local path=$1 kind=$2
  [ -n "$path" ] || return 0
  require_local_container "$path" "$kind"
  (
    cd "$path"
    [ ! -L tree ] && [ ! -L failed ] || exit 2
    [ ! -e tree ] || { [ -d tree ] && rm -rf -- tree; }
    [ ! -e failed ] || { [ -d failed ] && rm -rf -- failed; }
    rm -- .ompup-nonce
  ) || die "cannot safely empty local $kind container"
  rmdir "$path" || die "cannot safely remove local $kind container"
}
remove_remote_container() {
  local path=$1 kind=$2 nonce parent base
  [ -n "$path" ] || return 0
  nonce=$(container_nonce "$kind" "$path"); parent=${path%/*}; base=${path##*/}
  if ! ssh_run "set -eu; cd \"\$HOME\"; parent=$(sq "$parent"); base=$(sq "$base"); cd \"\$parent/\$base\"; [ \"\$(cat .ompup-nonce 2>/dev/null || true)\" = $(sq "$nonce") ] && [ -f .ompup-nonce ] && [ ! -L .ompup-nonce ]; [ ! -L tree ] && [ ! -L failed ]; [ ! -e tree ] || { [ -d tree ]; rm -rf -- tree; }; [ ! -e failed ] || { [ -d failed ]; rm -rf -- failed; }; rm -- .ompup-nonce; cd ..; rmdir -- \"\$base\""; then
    warn "cannot safely remove remote $kind container"
    return 1
  fi
}
cleanup() {
  local rc=$?
  trap - EXIT HUP INT TERM
  if [ "$PUBLISHED" -eq 0 ]; then
    if [ -n "$LOCAL_STAGE" ] && [ -d "$LOCAL_STAGE" ] && [ ! -L "$LOCAL_STAGE" ]; then
      safe_remove_local_dir "$LOCAL_STAGE"
    fi
    [ -z "$LOCAL_CANDIDATE_CONTAINER" ] || remove_local_container "$LOCAL_CANDIDATE_CONTAINER" candidate
    [ -z "$LOCAL_BACKUP_CONTAINER" ] || remove_local_container "$LOCAL_BACKUP_CONTAINER" backup
    [ -z "$REMOTE_CANDIDATE_CONTAINER" ] || remove_remote_container "$REMOTE_CANDIDATE_CONTAINER" candidate
    [ -z "$REMOTE_BACKUP_CONTAINER" ] || remove_remote_container "$REMOTE_BACKUP_CONTAINER" backup
  fi
  if [ "$LOCKED_REMOTE" -eq 1 ]; then
    ssh_run "cd \"\$HOME\"; [ \"\$(cat $(sq "$REMOTE_LOCK/token") 2>/dev/null || true)\" != $(sq "$TOKEN") ] || rm -rf $(sq "$REMOTE_LOCK")" >/dev/null 2>&1 || true
  fi
  if [ "$LOCKED_LOCAL" -eq 1 ] && [ "$(cat "$LOCAL_LOCK/token" 2>/dev/null || true)" = "$TOKEN" ]; then rm -rf "$LOCAL_LOCK"; fi
  exit "$rc"
}
release_locks() {
  if [ "$LOCKED_REMOTE" -eq 1 ]; then
    if ssh_run "cd \"\$HOME\"; [ \"\$(cat $(sq "$REMOTE_LOCK/token") 2>/dev/null || true)\" != $(sq "$TOKEN") ] || rm -rf $(sq "$REMOTE_LOCK")"; then
      LOCKED_REMOTE=0
    else
      warn "could not release remote lock; cleanup will retry"
    fi
  fi
  if [ "$LOCKED_LOCAL" -eq 1 ] && [ "$(cat "$LOCAL_LOCK/token" 2>/dev/null || true)" = "$TOKEN" ]; then
    rm -rf "$LOCAL_LOCK"
    LOCKED_LOCAL=0
  fi
}
trap cleanup EXIT HUP INT TERM

acquire_locks() {
  umask 077
  ensure_local_dir "${LOCAL_LOCK%/*}"
  if ! mkdir "$LOCAL_LOCK" 2>/dev/null; then
    oldpid=$(cat "$LOCAL_LOCK/pid" 2>/dev/null || true)
    case "$oldpid" in
      ''|*[!0-9]*) die "local mutation lock is held or malformed: $LOCAL_LOCK" ;;
      *) die "local mutation lock is held by PID $oldpid; stale locks require explicit inspection and removal" ;;
    esac
  fi
  [ -d "$LOCAL_LOCK" ] && [ ! -L "$LOCAL_LOCK" ] || die "local mutation lock is unsafe"
  write_exclusive_file "$LOCAL_LOCK/pid" "$$"$'\n'
  write_exclusive_file "$LOCAL_LOCK/token" "$TOKEN"$'\n'
  LOCKED_LOCAL=1
  script="set -eu; cd \"\$HOME\"; umask 077; $(remote_safe_dir_prelude); safe_dir $(sq "$REMOTE_ROOT"); safe_dir $(sq "$REMOTE_ROOT/.ompup-v2"); safe_dir $(sq "$REMOTE_ROOT/.ompup-v2/locks"); lock=$(sq "$REMOTE_LOCK"); mkdir \"\$lock\" || { echo 'remote mutation lock is held' >&2; exit 3; }; [ -d \"\$lock\" ] && [ ! -L \"\$lock\" ]; set -C; printf '%s\\n' $(sq "$TOKEN") > \"\$lock/token\"; [ -f \"\$lock/token\" ] && [ ! -L \"\$lock/token\" ]"
  ssh_run "$script" || die "cannot acquire remote mutation lock"
  LOCKED_REMOTE=1
}

write_state() {
  local owner=$1 epoch=$2 baseline_epoch=$3 ack=$4
  local tmp_dir="$PROJECT_STATE/.state-tmp-$TOKEN" tmp="$PROJECT_STATE/.state-tmp-$TOKEN/state" text
  ensure_local_dir "$PROJECT_STATE"
  [ ! -e "$tmp_dir" ] && [ ! -L "$tmp_dir" ] || die "local state temp directory already exists"
  mkdir "$tmp_dir" || die "cannot exclusively create local state temp directory"
  [ -d "$tmp_dir" ] && [ ! -L "$tmp_dir" ] || die "local state temp directory is unsafe"
  text=$(cat <<EOF
schema	2
identity_kind	$IDENTITY_KIND
identity_hash	$IDENTITY_HASH
address	$ADDRESS
local_root	$ROOT
host	$HOST
remote_root	$REMOTE_ROOT
remote_dir	$REMOTE_DIR
tmux_session	$SESSION
epoch	$epoch
owner	$owner
baseline_epoch	$baseline_epoch
filter_digest	$FILTER_DIGEST
exclude_ack_digest	$ack
git_mode	$GIT_MODE
git_branch	$GIT_BRANCH
git_oid	$GIT_OID
EOF
)
  write_exclusive_file "$tmp" "$text"$'\n'
  [ ! -L "$STATE_FILE" ] || die "state file became a symlink"
  [ ! -e "$STATE_FILE" ] || [ -f "$STATE_FILE" ] || die "state path is not a regular file"
  mv "$tmp" "$STATE_FILE"
  rmdir "$tmp_dir"
}

remote_remove_transaction_artifacts() {
  local txn_token=$1 script removals artifact
  shift
  script="set -eu; cd \"\$HOME\"; $(remote_control_dirs_script); safe_dir $(sq "$REMOTE_CONTROL/txn"); txn=$(sq "$REMOTE_CONTROL/txn/$txn_token"); if [ -e \"\$txn\" ] || [ -L \"\$txn\" ]; then [ -d \"\$txn\" ] && [ ! -L \"\$txn\" ]; fi"
  removals=$(sq "$REMOTE_CONTROL/txn/$txn_token")
  for artifact in "$@"; do
    script="$script; artifact=$(sq "$artifact"); { [ ! -e \"\$artifact\" ] && [ ! -L \"\$artifact\" ]; } || { [ -d \"\$artifact\" ] && [ ! -L \"\$artifact\" ]; }"
    removals="$removals $(sq "$artifact")"
  done
  ssh_run "$script; rm -rf $removals"
}

# Recover the one durable local journal before starting another mutation.
# Random container paths are journal-bound; any nonce or content mismatch is
# preserved and blocks instead of being adopted or recursively removed.
recover_transaction() {
  local journal= count=0 path key value extra txn_token= txn_dir= seen='|'
  local schema= token= op= pre= target= pre_owner= target_owner= state=
  local candidate_container= backup_container= candidate_tree backup_tree parent
  [ -e "$TRANSACTIONS" ] || return 0
  [ -d "$TRANSACTIONS" ] && [ ! -L "$TRANSACTIONS" ] || die "transactions directory is unsafe"
  for path in "$TRANSACTIONS"/*/journal; do
    [ -f "$path" ] && [ ! -L "$path" ] || continue
    journal=$path; count=$((count + 1))
  done
  [ "$count" -le 1 ] || die "multiple unresolved local transaction journals"
  [ "$count" -eq 1 ] || return 0
  txn_dir=${journal%/journal}; txn_token=${txn_dir##*/}
  [ -d "$txn_dir" ] && [ ! -L "$txn_dir" ] || die "transaction directory is unsafe"
  [[ "$txn_token" =~ ^[0-9]+-[0-9]+$ ]] || die "invalid transaction directory token"
  while IFS=$'\t' read -r key value extra || [ -n "$key" ]; do
    [ -n "$key" ] && [ -z "${extra:-}" ] || die "malformed transaction journal"
    case "$seen" in *"|$key|"*) die "duplicate transaction journal field: $key" ;; esac
    seen="$seen$key|"
    case "$key" in
      schema) schema=$value ;; token) token=$value ;; operation) op=$value ;;
      pre_epoch) pre=$value ;; target_epoch) target=$value ;;
      pre_owner) pre_owner=$value ;; target_owner) target_owner=$value ;;
      candidate_container) candidate_container=$value ;; backup_container) backup_container=$value ;;
      *) die "unknown transaction journal field: $key" ;;
    esac
  done < "$journal"
  for key in schema token operation pre_epoch target_epoch pre_owner target_owner candidate_container backup_container; do
    case "$seen" in *"|$key|"*) ;; *) die "missing transaction journal field: $key" ;; esac
  done
  [ "$schema" = 2 ] || die "unsupported transaction journal schema"
  [ "$token" = "$txn_token" ] || die "transaction journal token does not match its directory"
  [ "$op" = sync ] || [ "$op" = pull ] || die "invalid transaction operation"
  valid_epoch "$target" || die "invalid transaction target epoch"
  if [ "$pre" = none ]; then
    [ "$op" = sync ] && [ "$pre_owner" = none ] && [ "$target_owner" = remote ] ||
      die "invalid initial transaction journal"
  else
    valid_epoch "$pre" || die "invalid transaction pre epoch"
    [ "$target" -gt "$pre" ] || die "transaction epochs are not monotonic"
    { [ "$pre_owner" = local ] || [ "$pre_owner" = remote ]; } || die "invalid transaction pre owner"
    if [ "$op" = pull ]; then [ "$target_owner" = local ] || die "invalid pull transaction target owner"
    else [ "$target_owner" = remote ] || die "invalid sync transaction target owner"; fi
  fi
  contains_control "$candidate_container$backup_container" && die "transaction journal contains a control-byte path"
  parent=${ROOT%/*}; [ -n "$parent" ] || parent=/
  if [ "$op" = pull ]; then
    case "$candidate_container" in "$parent/.ompup-candidate-$ADDRESS-$txn_token."??????) ;; *) die "invalid local candidate container path" ;; esac
    case "$backup_container" in "$parent/.ompup-backup-$ADDRESS-$txn_token."??????) ;; *) die "invalid local backup container path" ;; esac
  else
    case "$candidate_container" in "$REMOTE_ROOT/.ompup-candidate-$ADDRESS-$txn_token."??????) ;; *) die "invalid remote candidate container path" ;; esac
    case "$backup_container" in "$REMOTE_ROOT/.ompup-backup-$ADDRESS-$txn_token."??????) ;; *) die "invalid remote backup container path" ;; esac
  fi
  candidate_tree="$candidate_container/tree"; backup_tree="$backup_container/tree"
  check_baseline_generation_removal "$target"
  [ -f "$txn_dir/rules" ] && [ ! -L "$txn_dir/rules" ] || die "transaction rules are missing or unsafe"
  [ -d "$txn_dir/after" ] && [ ! -L "$txn_dir/after" ] || die "transaction target snapshot is missing or unsafe"
  [ "$pre" = none ] || { [ -d "$txn_dir/before" ] && [ ! -L "$txn_dir/before" ]; } ||
    die "transaction pre snapshot is missing or unsafe"

  FILTER_KINDS=(); FILTER_RULES=(); RULES_TEXT=
  while IFS=$'\t' read -r key value extra || [ -n "$key" ]; do
    [ -z "${extra:-}" ] && { [ "$key" = include ] || [ "$key" = exclude ]; } || die "malformed transaction rules"
    contains_control "$value" && die "malformed transaction rule"
    add_filter "$key" "$value"
  done < "$txn_dir/rules"
  [ "${FILTER_KINDS[0]:-}" = exclude ] && [ "${FILTER_RULES[0]:-}" = .git ] ||
    die "transaction rules do not protect .git"
  make_filter_args
  if [ "$op" = sync ]; then
    validate_remote_journal_if_present "$txn_token" "$op" "$pre" "$target" "$pre_owner" "$target_owner" \
      "$candidate_container" "$backup_container"
  fi

  if [ "$STATE_PRESENT" -eq 1 ] && [ "$ST_EPOCH" = "$target" ]; then
    validate_baseline_generation "$target"
    if [ "$op" = pull ]; then
      validate_tree "$ROOT"
      [ -z "$(compare_local "$BASELINES/$target/tree" "$ROOT")" ] ||
        die "committed local target changed; preserving recovery artifacts"
      if [ -e "$backup_container" ] || [ -L "$backup_container" ]; then remove_local_container "$backup_container" backup; fi
      if [ -e "$candidate_container" ] || [ -L "$candidate_container" ]; then remove_local_container "$candidate_container" candidate; fi
    else
      require_remote_tree "$REMOTE_DIR"
      [ -z "$(compare_remote "$BASELINES/$target/tree" "$REMOTE_DIR")" ] ||
        die "committed remote target changed; preserving recovery artifacts"
      if ssh_run "cd \"\$HOME\"; [ -e $(sq "$backup_container") ] || [ -L $(sq "$backup_container") ]" >/dev/null 2>&1; then
        remove_remote_container "$backup_container" backup
      fi
      if ssh_run "cd \"\$HOME\"; [ -e $(sq "$candidate_container") ] || [ -L $(sq "$candidate_container") ]" >/dev/null 2>&1; then
        remove_remote_container "$candidate_container" candidate
      fi
      remote_remove_transaction_artifacts "$txn_token"
    fi
    [ "$pre" = none ] || remove_baseline_generation "$pre"
    safe_remove_local_dir "$txn_dir"
    LOCAL_INSPECT_ROOT=$ROOT
    say "ompup: finalized committed transaction $txn_token"
    return 0
  fi

  if [ "$op" = pull ]; then
    require_local_container "$backup_container" backup
    if [ ! -e "$backup_tree" ] && [ ! -L "$backup_tree" ]; then
      [ -d "$ROOT" ] && [ ! -L "$ROOT" ] || die "unpublished pull live root is unsafe"
      validate_tree "$ROOT"
      [ -z "$(compare_local "$txn_dir/before" "$ROOT")" ] ||
        die "unpublished pull destination changed; preserving transaction artifacts"
      remove_local_container "$backup_container" backup
      remove_local_container "$candidate_container" candidate
    else
      [ -d "$backup_tree" ] && [ ! -L "$backup_tree" ] || die "pull recovery backup tree is unsafe"
      validate_tree "$backup_tree"
      backup_changed=0
      (require_local_path_git_match "$backup_tree") || backup_changed=1
      [ -z "$(compare_local "$txn_dir/before" "$backup_tree")" ] || backup_changed=1
      if [ "$backup_changed" -eq 1 ]; then
        if [ ! -e "$ROOT" ] && [ ! -L "$ROOT" ]; then
          (cd "$backup_container" && move_exact tree "$ROOT" && [ ! -e tree ] && [ -d "$ROOT" ] && [ ! -L "$ROOT" ]) ||
            die "pull recovery could not restore moved third version; artifacts preserved"
          LOCAL_INSPECT_ROOT=$ROOT
          cd "$ROOT"
          die "pull recovery restored a moved third local version; transaction artifacts preserved"
        fi
        die "pull recovery found an occupied live path and moved third backup; preserved both versions"
      fi
      if [ -e "$ROOT" ] || [ -L "$ROOT" ]; then
        [ -d "$ROOT" ] && [ ! -L "$ROOT" ] || die "pull recovery live root is unsafe"
        validate_tree "$ROOT"
        [ -z "$(compare_local "$txn_dir/after" "$ROOT")" ] ||
          die "pull recovery found a third local version; preserving both versions and transaction artifacts"
        require_local_container "$candidate_container" candidate
        [ ! -e "$candidate_container/failed" ] && [ ! -L "$candidate_container/failed" ] ||
          die "pull recovery failed-tree slot is occupied"
        (cd "$candidate_container" && move_exact "$ROOT" failed && [ -d failed ] && [ ! -L failed ] && [ ! -e "$ROOT" ]) ||
          die "pull recovery could not preserve the transaction target; artifacts preserved"
        validate_tree "$candidate_container/failed"
        moved_changed=0
        (require_local_path_git_match "$candidate_container/failed") || moved_changed=1
        [ -z "$(compare_local "$txn_dir/after" "$candidate_container/failed")" ] || moved_changed=1
        if [ "$moved_changed" -eq 1 ]; then
          if [ ! -e "$ROOT" ] && [ ! -L "$ROOT" ]; then
            (cd "$candidate_container" && move_exact failed "$ROOT" && [ ! -e failed ] && [ -d "$ROOT" ] && [ ! -L "$ROOT" ]) ||
              die "pull recovery could not restore moved recovery-race version; artifacts preserved"
            LOCAL_INSPECT_ROOT=$ROOT
            cd "$ROOT"
            die "pull recovery restored a version changed during recovery move; transaction artifacts preserved"
          fi
          die "pull recovery move raced with an occupied live path; preserved both versions and transaction artifacts"
        fi
      fi
      [ ! -e "$ROOT" ] && [ ! -L "$ROOT" ] || die "pull recovery live path became occupied"
      (cd "$backup_container" && move_exact tree "$ROOT" && [ ! -e tree ] && [ -d "$ROOT" ] && [ ! -L "$ROOT" ]) ||
        die "pull recovery backup restore failed; artifacts preserved"
      LOCAL_INSPECT_ROOT=$ROOT
      require_local_path_git_match "$ROOT"
      [ -z "$(compare_local "$txn_dir/before" "$ROOT")" ] || die "pull rollback validation failed; artifacts preserved"
      cd "$ROOT"
      remove_local_container "$backup_container" backup
      remove_local_container "$candidate_container" candidate
    fi
  else
    nonce=$(container_nonce backup "$backup_container")
    backup_state=$(ssh_read "set -eu; cd \"\$HOME\"; container=$(sq "$backup_container"); [ -d \"\$container\" ] && [ ! -L \"\$container\" ]; [ \"\$(cat \"\$container/.ompup-nonce\" 2>/dev/null || true)\" = $(sq "$nonce") ]; if [ -e \"\$container/tree\" ] || [ -L \"\$container/tree\" ]; then [ -d \"\$container/tree\" ] && [ ! -L \"\$container/tree\" ]; echo tree; else echo empty; fi") ||
      die "sync recovery backup container is missing, replaced, or unsafe"
    state=$(remote_destination_state) || die "cannot inspect sync recovery destination"
    if [ "$pre" != none ] && [ "$backup_state" = tree ]; then
      require_remote_tree "$backup_tree"
      backup_changed=0
      (require_remote_path_git_match "$backup_tree") || backup_changed=1
      [ -z "$(compare_remote "$txn_dir/before" "$backup_tree")" ] || backup_changed=1
      if [ "$backup_changed" -eq 1 ]; then
        if [ "$state" = absent ] && remote_restore_backup_if_live_absent "$backup_container"; then
          die "sync recovery restored a moved third backup version; transaction artifacts preserved"
        fi
        die "sync recovery found an occupied live path and moved third backup; preserved both versions"
      fi
    fi
    if [ "$pre" = none ]; then
      if [ "$state" != absent ]; then
        require_remote_tree "$REMOTE_DIR"
        [ -z "$(compare_remote "$txn_dir/after" "$REMOTE_DIR")" ] ||
          die "initial-sync recovery found a third remote version; preserving live tree and transaction artifacts"
        bnonce=$(container_nonce backup "$backup_container")
        ssh_run "set -eu; $REMOTE_MOVE_EXACT; cd \"\$HOME\"; container=$(sq "$backup_container"); nonce=$(sq "$bnonce"); live=\$HOME/$(sq "$REMOTE_DIR"); cd \"\$container\"; [ \"\$(cat .ompup-nonce)\" = \"\$nonce\" ]; [ ! -e tree ] && [ ! -L tree ]; [ -d \"\$live\" ] && [ ! -L \"\$live\" ]; move_exact \"\$live\" tree; [ -d tree ] && [ ! -L tree ] && [ ! -e \"\$live\" ]" ||
          die "initial-sync recovery could not preserve transaction target"
        require_remote_tree "$backup_tree"
        moved_changed=0
        (require_remote_path_git_match "$backup_tree") || moved_changed=1
        [ -z "$(compare_remote "$txn_dir/after" "$backup_tree")" ] || moved_changed=1
        if [ "$moved_changed" -eq 1 ]; then
          live_state=$(remote_destination_state) || die "cannot inspect initial-sync recovery live path"
          if [ "$live_state" = absent ] && remote_restore_backup_if_live_absent "$backup_container"; then
            die "initial-sync recovery restored a version changed during recovery move; transaction artifacts preserved"
          fi
          die "initial-sync recovery move raced with an occupied live path; preserved both versions and transaction artifacts"
        fi
      fi
      ssh_run "set -eu; cd \"\$HOME\"; marker=$(sq "$REMOTE_CONTROL/marker"); if [ -e \"\$marker\" ] || [ -L \"\$marker\" ]; then [ -f \"\$marker\" ] && [ ! -L \"\$marker\" ]; rm -- \"\$marker\"; fi"
    else
      if [ "$backup_state" = empty ]; then
        require_remote_tree "$REMOTE_DIR"
        [ -z "$(compare_remote "$txn_dir/before" "$REMOTE_DIR")" ] ||
          die "unpublished sync destination changed; preserving transaction artifacts"
      else
        if [ "$state" != absent ]; then
          require_remote_tree "$REMOTE_DIR"
          [ -z "$(compare_remote "$txn_dir/after" "$REMOTE_DIR")" ] ||
            die "sync recovery found a third remote version; preserving both versions and transaction artifacts"
          cnonce=$(container_nonce candidate "$candidate_container")
          ssh_run "set -eu; $REMOTE_MOVE_EXACT; cd \"\$HOME\"; container=$(sq "$candidate_container"); nonce=$(sq "$cnonce"); live=\$HOME/$(sq "$REMOTE_DIR"); cd \"\$container\"; [ \"\$(cat .ompup-nonce)\" = \"\$nonce\" ]; [ ! -e failed ] && [ ! -L failed ]; move_exact \"\$live\" failed; [ -d failed ] && [ ! -L failed ] && [ ! -e \"\$live\" ]" ||
            die "sync recovery could not preserve transaction target"
          require_remote_tree "$candidate_container/failed"
          moved_changed=0
          (require_remote_path_git_match "$candidate_container/failed") || moved_changed=1
          [ -z "$(compare_remote "$txn_dir/after" "$candidate_container/failed")" ] || moved_changed=1
          if [ "$moved_changed" -eq 1 ]; then
            live_state=$(remote_destination_state) || die "cannot inspect sync recovery live path"
            if [ "$live_state" = absent ] && remote_restore_failed_if_live_absent "$candidate_container"; then
              die "sync recovery restored a version changed during recovery move; transaction artifacts preserved"
            fi
            die "sync recovery move raced with an occupied live path; preserved both versions and transaction artifacts"
          fi
        fi
        remote_restore_backup_if_live_absent "$backup_container" ||
          die "sync recovery backup restore failed; artifacts preserved"
        require_remote_tree "$REMOTE_DIR"
        [ -z "$(compare_remote "$txn_dir/before" "$REMOTE_DIR")" ] || die "sync rollback validation failed; artifacts preserved"
    fi
    fi
    remove_remote_container "$backup_container" backup
    remove_remote_container "$candidate_container" candidate
    remote_remove_transaction_artifacts "$txn_token"
  fi
  remove_baseline_generation "$target"
  safe_remove_local_dir "$txn_dir"
  PUBLISHED=0
  LOCAL_STAGE=
  LOCAL_INSPECT_ROOT=$ROOT
  build_filters; make_filter_args; FILTER_DIGEST=$(filter_digest)
  say "ompup: recovered uncommitted transaction $txn_token to its pre-tree"
}

create_local_txn_dirs() {
  ensure_local_dir "$TRANSACTIONS"
  LOCAL_STAGE="$TRANSACTIONS/$TOKEN"
  [ ! -e "$LOCAL_STAGE" ] && [ ! -L "$LOCAL_STAGE" ] || die "local transaction token directory already exists"
  mkdir "$LOCAL_STAGE" || die "cannot exclusively create local transaction directory"
  [ -d "$LOCAL_STAGE" ] && [ ! -L "$LOCAL_STAGE" ] || die "local transaction directory is unsafe"
  mkdir "$LOCAL_STAGE/after" "$LOCAL_STAGE/before"
}

write_local_journal_temp() {
  local operation=$1 epoch=$2 candidate_container=$3 backup_container=$4 text
  text=$(journal_text "$TOKEN" "$operation" "${ST_EPOCH:-none}" "$epoch" "${ST_OWNER:-none}" \
    "$([ "$operation" = pull ] && printf local || printf remote)" "$candidate_container" "$backup_container")
  write_exclusive_file "$LOCAL_STAGE/journal.tmp" "$text"$'\n'
}

prepare_local_txn() {
  local epoch=$1
  RULES_TEXT=
  create_local_txn_dirs
  write_rules "$LOCAL_STAGE/rules"
  rsync_copy_local "$ROOT" "$LOCAL_STAGE/after"
  [ -z "$(compare_local "$LOCAL_STAGE/after" "$ROOT")" ] || die "local source changed while staging"
  if [ "$STATE_PRESENT" -eq 1 ]; then rsync_copy_local "$BASELINES/$ST_BASELINE_EPOCH/tree" "$LOCAL_STAGE/before"; fi
}
publish_local_journal() {
  [ -f "$LOCAL_STAGE/journal.tmp" ] && [ ! -L "$LOCAL_STAGE/journal.tmp" ] ||
    die "local transaction journal temp is unsafe"
  [ ! -e "$LOCAL_STAGE/journal" ] && [ ! -L "$LOCAL_STAGE/journal" ] ||
    die "local transaction journal already exists"
  mv "$LOCAL_STAGE/journal.tmp" "$LOCAL_STAGE/journal"
  [ -f "$LOCAL_STAGE/journal" ] && [ ! -L "$LOCAL_STAGE/journal" ] ||
    die "published local transaction journal is unsafe"
  PUBLISHED=1
}
materialize_baseline() {
  local epoch=$1 source=$2
  ensure_local_dir "$BASELINES"
  [ ! -e "$BASELINES/$epoch" ] && [ ! -L "$BASELINES/$epoch" ] ||
    die "baseline generation already exists"
  mkdir "$BASELINES/$epoch"
  mkdir "$BASELINES/$epoch/tree"
  rsync_copy_local "$source" "$BASELINES/$epoch/tree"
  freeze_rules_text
  write_exclusive_file "$BASELINES/$epoch/rules" "$RULES_TEXT"
  [ -z "$(compare_local "$source" "$BASELINES/$epoch/tree")" ] || die "baseline materialization validation failed"
}

# Candidate containers are random, exclusively created directories. Every
# write is anchored below a verified nonce-bearing container.
remote_create_container() {
  local kind=$1 path nonce
  path=$(ssh_read "set -eu; cd \"\$HOME\"; umask 077; $(remote_safe_dir_prelude); require_dir $(sq "$REMOTE_ROOT"); path=\$(mktemp -d $(sq "$REMOTE_ROOT/.ompup-$kind-$ADDRESS-$TOKEN.XXXXXX")); [ -d \"\$path\" ] && [ ! -L \"\$path\" ]; printf '%s' \"\$path\"") ||
    die "cannot exclusively create remote $kind container"
  contains_control "$path" && die "remote mktemp returned a control-byte path"
  case "$path" in "$REMOTE_ROOT/.ompup-$kind-$ADDRESS-$TOKEN."??????) ;; *) die "remote mktemp returned an invalid $kind container path" ;; esac
  nonce=$(container_nonce "$kind" "$path")
  ssh_write "set -eu; cd \"\$HOME\"; path=$(sq "$path"); [ -d \"\$path\" ] && [ ! -L \"\$path\" ]; [ ! -e \"\$path/.ompup-nonce\" ] && [ ! -L \"\$path/.ompup-nonce\" ]; umask 077; set -C; cat > \"\$path/.ompup-nonce\"; [ -f \"\$path/.ompup-nonce\" ] && [ ! -L \"\$path/.ompup-nonce\" ]" "$nonce"$'\n' ||
    die "cannot bind remote $kind container nonce"
  CREATED_REMOTE_CONTAINER=$path
}
remote_make_candidate() {
  local initialized=$1 container=$2 nonce script
  nonce=$(container_nonce candidate "$container")
  script="set -eu; cd \"\$HOME\"; container=$(sq "$container"); nonce=$(sq "$nonce"); cd \"\$container\"; [ \"\$(cat .ompup-nonce 2>/dev/null || true)\" = \"\$nonce\" ] && [ -f .ompup-nonce ] && [ ! -L .ompup-nonce ]; [ ! -e tree ] && [ ! -L tree ]"
  if [ "$initialized" -eq 0 ]; then
    if [ "$IDENTITY_KIND" = git ]; then
      script="$script; git clone --no-checkout --origin origin -- $(sq "$ORIGIN") tree"
      if [ "$GIT_MODE" = branch ]; then script="$script; git -C tree cat-file -e $(sq "$GIT_OID^{commit}"); git -C tree checkout -B $(sq "$GIT_BRANCH") $(sq "$GIT_OID")"
      elif [ "$GIT_MODE" = detached ]; then script="$script; git -C tree cat-file -e $(sq "$GIT_OID^{commit}"); git -C tree checkout --detach $(sq "$GIT_OID")"
      else script="$script; git -C tree checkout --orphan $(sq "$GIT_BRANCH"); git -C tree rm -rf --ignore-unmatch . >/dev/null 2>&1 || true"; fi
      script="$script; for entry in tree/* tree/.[!.]* tree/..?*; do [ -e \"\$entry\" ] || [ -L \"\$entry\" ] || continue; [ \"\${entry##*/}\" = .git ] || rm -rf -- \"\$entry\"; done"
    else
      script="$script; mkdir tree"
    fi
  else
    script="$script; source=\$HOME/$(sq "$REMOTE_DIR"); [ -d \"\$source\" ] && [ ! -L \"\$source\" ]; mkdir tree; cd tree; cp -Rp \"\$source\"/. ."
  fi
  ssh_run "$script" || die "failed to build remote whole-tree candidate"
}
remote_publish_marker() {
  local text tmp_dir="$REMOTE_CONTROL/.marker-tmp-$TOKEN"
  text=$(marker_text)
  ssh_write "set -eu; cd \"\$HOME\"; umask 077; $(remote_control_dirs_script); marker=$(sq "$REMOTE_CONTROL/marker"); tmp_dir=$(sq "$tmp_dir"); [ ! -e \"\$marker\" ] && [ ! -L \"\$marker\" ]; [ ! -e \"\$tmp_dir\" ] && [ ! -L \"\$tmp_dir\" ]; mkdir \"\$tmp_dir\"; [ -d \"\$tmp_dir\" ] && [ ! -L \"\$tmp_dir\" ]; set -C; cat > \"\$tmp_dir/marker\"; [ -f \"\$tmp_dir/marker\" ] && [ ! -L \"\$tmp_dir/marker\" ]; mv \"\$tmp_dir/marker\" \"\$marker\"; rmdir \"\$tmp_dir\"" "$text"$'\n'
}
journal_text() {
  printf 'schema\t2\ntoken\t%s\noperation\t%s\npre_epoch\t%s\ntarget_epoch\t%s\npre_owner\t%s\ntarget_owner\t%s\ncandidate_container\t%s\nbackup_container\t%s\n' \
    "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$8"
}
validate_remote_journal_if_present() {
  local token=$1 operation=$2 pre=$3 target=$4 pre_owner=$5 target_owner=$6
  local candidate_container=$7 backup_container=$8 actual expected path
  path="$REMOTE_CONTROL/txn/$token/journal"
  actual=$(ssh_read "set -eu; cd \"\$HOME\"; path=$(sq "$path"); if [ -e \"\$path\" ] || [ -L \"\$path\" ]; then $(remote_safe_dir_prelude); require_dir $(sq "$REMOTE_CONTROL/txn/$token"); [ -f \"\$path\" ] && [ ! -L \"\$path\" ]; printf 'present\\n'; cat \"\$path\"; else printf absent; fi") ||
    die "remote transaction journal is unsafe or unreadable"
  [ "$actual" != absent ] || return 0
  expected="present"$'\n'"$(journal_text "$token" "$operation" "$pre" "$target" "$pre_owner" "$target_owner" "$candidate_container" "$backup_container")"
  [ "$actual" = "$expected" ] || die "remote transaction journal does not match its bound local journal"
}

remote_publish_journal() {
  local operation=$1 epoch=$2 candidate_container=$3 backup_container=$4
  local text pre=${ST_EPOCH:-none} pre_owner=${ST_OWNER:-none} target_owner
  target_owner=$([ "$operation" = pull ] && printf local || printf remote)
  text=$(journal_text "$TOKEN" "$operation" "$pre" "$epoch" "$pre_owner" "$target_owner" "$candidate_container" "$backup_container")
  ssh_write "set -eu; cd \"\$HOME\"; umask 077; $(remote_control_dirs_script); safe_dir $(sq "$REMOTE_CONTROL/txn"); txn=$(sq "$REMOTE_CONTROL/txn/$TOKEN"); [ ! -e \"\$txn\" ] && [ ! -L \"\$txn\" ]; mkdir \"\$txn\"; [ -d \"\$txn\" ] && [ ! -L \"\$txn\" ]; set -C; cat > \"\$txn/journal\"; [ -f \"\$txn/journal\" ] && [ ! -L \"\$txn/journal\" ]" "$text"$'\n'
}
remote_prepare_backup() {
  local initialized=$1 backup_container=$2 backup_nonce
  [ "$initialized" -eq 1 ] || return 0
  backup_nonce=$(container_nonce backup "$backup_container")
  ssh_run "set -eu; $REMOTE_MOVE_EXACT; cd \"\$HOME\"; : ompup_backup_move; container=$(sq "$backup_container"); nonce=$(sq "$backup_nonce"); live=\$HOME/$(sq "$REMOTE_DIR"); cd \"\$container\"; [ \"\$(cat .ompup-nonce 2>/dev/null || true)\" = \"\$nonce\" ] && [ -f .ompup-nonce ] && [ ! -L .ompup-nonce ]; [ ! -e tree ] && [ ! -L tree ]; [ -d \"\$live\" ] && [ ! -L \"\$live\" ]; move_exact \"\$live\" tree; [ ! -e \"\$live\" ] && [ ! -L \"\$live\" ] && [ -d tree ] && [ ! -L tree ]" ||
    die "remote backup move failed; journal retained for recovery"
}
remote_restore_backup_if_live_absent() {
  local backup_container=$1 backup_nonce
  backup_nonce=$(container_nonce backup "$backup_container")
  ssh_run "set -eu; $REMOTE_MOVE_EXACT; cd \"\$HOME\"; container=$(sq "$backup_container"); nonce=$(sq "$backup_nonce"); live=\$HOME/$(sq "$REMOTE_DIR"); cd \"\$container\"; [ \"\$(cat .ompup-nonce 2>/dev/null || true)\" = \"\$nonce\" ] && [ -f .ompup-nonce ] && [ ! -L .ompup-nonce ]; [ -d tree ] && [ ! -L tree ]; [ ! -e \"\$live\" ] && [ ! -L \"\$live\" ]; move_exact tree \"\$live\"; [ ! -e tree ] && [ ! -L tree ] && [ -d \"\$live\" ] && [ ! -L \"\$live\" ]"
}
remote_restore_failed_if_live_absent() {
  local candidate_container=$1 candidate_nonce
  candidate_nonce=$(container_nonce candidate "$candidate_container")
  ssh_run "set -eu; $REMOTE_MOVE_EXACT; cd \"\$HOME\"; container=$(sq "$candidate_container"); nonce=$(sq "$candidate_nonce"); live=\$HOME/$(sq "$REMOTE_DIR"); cd \"\$container\"; [ \"\$(cat .ompup-nonce 2>/dev/null || true)\" = \"\$nonce\" ] && [ -f .ompup-nonce ] && [ ! -L .ompup-nonce ]; [ -d failed ] && [ ! -L failed ]; [ ! -e \"\$live\" ] && [ ! -L \"\$live\" ]; move_exact failed \"\$live\"; [ ! -e failed ] && [ ! -L failed ] && [ -d \"\$live\" ] && [ ! -L \"\$live\" ]"
}
remote_promote_candidate() {
  local initialized=$1 candidate_container=$2 candidate_nonce live_nonce
  candidate_nonce=$(container_nonce candidate "$candidate_container")
  live_nonce=$(container_nonce live "$REMOTE_DIR")
  ssh_run "set -eu; cd \"\$HOME\"; : ompup_candidate_promotion; candidate=$(sq "$candidate_container"); cnonce=$(sq "$candidate_nonce"); [ -d \"\$candidate\" ] && [ ! -L \"\$candidate\" ]; [ \"\$(cat \"\$candidate/.ompup-nonce\" 2>/dev/null || true)\" = \"\$cnonce\" ] && [ -f \"\$candidate/.ompup-nonce\" ] && [ ! -L \"\$candidate/.ompup-nonce\" ]; [ -d \"\$candidate/tree\" ] && [ ! -L \"\$candidate/tree\" ]; live=$(sq "$REMOTE_DIR"); [ ! -e \"\$live\" ] && [ ! -L \"\$live\" ]; mkdir \"\$live\"; [ -d \"\$live\" ] && [ ! -L \"\$live\" ]; cd \"\$live\"; umask 077; set -C; printf '%s\\n' $(sq "$live_nonce") > .ompup-nonce; [ -f .ompup-nonce ] && [ ! -L .ompup-nonce ]; cp -Rp \"\$HOME/\$candidate/tree\"/. .; [ \"\$(cat .ompup-nonce)\" = $(sq "$live_nonce") ]; rm -- .ompup-nonce" ||
    die "remote candidate promotion failed; journal retained for recovery"
}
remote_cleanup_commit() {
  remove_remote_container "$REMOTE_BACKUP_CONTAINER" backup || return 1
  REMOTE_BACKUP_CONTAINER=
  remove_remote_container "$REMOTE_CANDIDATE_CONTAINER" candidate || return 1
  REMOTE_CANDIDATE_CONTAINER=
  remote_remove_transaction_artifacts "$TOKEN"
}
sync_real() {
  check_ack
  acquire_locks
  read_state; recover_transaction; read_state
  local initialized=$STATE_PRESENT dest candidate epoch backup old_baseline cleanup_ok=0
  dest=$(remote_destination_state) || die "cannot inspect remote destination"
  if [ "$initialized" -eq 0 ]; then
    [ "$dest" = absent ] || die "remote destination already exists without an adoptable local ledger ($dest)"
    epoch=1
    print_policy
  else
    [ "$dest" = marked ] || die "remote destination/marker mismatch: $dest"
    require_remote_tree "$REMOTE_DIR"
    require_marker; require_git_match; compute_changes
    require_effective_owner local
    epoch=$(next_epoch "$ST_EPOCH")
    build_filters; make_filter_args; FILTER_DIGEST=$(filter_digest); compute_tracked_excluded; check_ack
  fi
  prepare_local_txn "$epoch"
  remote_create_container candidate; REMOTE_CANDIDATE_CONTAINER=$CREATED_REMOTE_CONTAINER
  remote_create_container backup; REMOTE_BACKUP_CONTAINER=$CREATED_REMOTE_CONTAINER
  candidate="$REMOTE_CANDIDATE_CONTAINER/tree"
  remote_make_candidate "$initialized" "$REMOTE_CANDIDATE_CONTAINER"
  rsync_local_to_remote_container "$ROOT" "$REMOTE_CANDIDATE_CONTAINER"
  require_remote_tree "$candidate"
  [ -z "$(compare_remote "$LOCAL_STAGE/after" "$candidate")" ] || die "remote candidate validation failed"
  require_remote_path_git_match "$candidate"
  [ -z "$(compare_local "$LOCAL_STAGE/after" "$ROOT")" ] || die "local source changed before publication"
  if [ "$initialized" -eq 1 ]; then require_marker; require_remote_tree "$REMOTE_DIR"; require_git_match; fi
  require_live_local_git_tuple
  write_local_journal_temp sync "$epoch" "$REMOTE_CANDIDATE_CONTAINER" "$REMOTE_BACKUP_CONTAINER"
  publish_local_journal
  remote_publish_journal sync "$epoch" "$REMOTE_CANDIDATE_CONTAINER" "$REMOTE_BACKUP_CONTAINER"
  validate_remote_journal_if_present "$TOKEN" sync "${ST_EPOCH:-none}" "$epoch" "${ST_OWNER:-none}" remote \
    "$REMOTE_CANDIDATE_CONTAINER" "$REMOTE_BACKUP_CONTAINER"
  backup="$REMOTE_BACKUP_CONTAINER/tree"
  remote_prepare_backup "$initialized" "$REMOTE_BACKUP_CONTAINER"
  if [ "$initialized" -eq 1 ]; then
    require_remote_tree "$backup"
    backup_changed=0
    (require_remote_path_git_match "$backup") || backup_changed=1
    [ -z "$(compare_remote "$LOCAL_STAGE/before" "$backup")" ] || backup_changed=1
    if [ "$backup_changed" -eq 1 ]; then
      live_state=$(remote_destination_state) || die "cannot inspect remote destination after backup move"
      if [ "$live_state" = absent ] && remote_restore_backup_if_live_absent "$REMOTE_BACKUP_CONTAINER"; then
        require_remote_tree "$REMOTE_DIR"
        die "remote destination changed during backup move; restored moved third version and preserved transaction artifacts"
      fi
      die "remote destination changed during backup move and live path is occupied; preserved both versions and transaction artifacts"
    fi
  fi
  remote_promote_candidate "$initialized" "$REMOTE_CANDIDATE_CONTAINER"
  if [ "$initialized" -eq 0 ]; then remote_publish_marker; fi
  require_remote_tree "$REMOTE_DIR"
  [ -z "$(compare_remote "$LOCAL_STAGE/after" "$REMOTE_DIR")" ] ||
    die "remote live validation failed after promotion; transaction artifacts preserved"
  [ -z "$(compare_local "$LOCAL_STAGE/after" "$ROOT")" ] || die "local source changed before ownership commit"
  require_marker; require_git_match
  materialize_baseline "$epoch" "$LOCAL_STAGE/after"
  ack=${ST_ACK_DIGEST:--}; [ -n "$TRACKED_EXCLUDED" ] && ack=$ACK_DIGEST
  old_baseline=${ST_BASELINE_EPOCH:-none}
  require_live_local_git_tuple
  write_state remote "$epoch" "$epoch" "$ack"
  if remote_cleanup_commit; then
    cleanup_ok=1
    [ "$old_baseline" = none ] || remove_baseline_generation "$old_baseline"
    safe_remove_local_dir "$LOCAL_STAGE"
    PUBLISHED=0; LOCAL_STAGE=
  else
    warn "handoff committed; remote transaction cleanup remains recoverable"
  fi
  ST_OWNER=remote; ST_EPOCH=$epoch; ST_BASELINE_EPOCH=$epoch; STATE_PRESENT=1
  release_locks
  say "ompup: synced $ROOT -> $HOST:~/$REMOTE_DIR; owner=remote epoch=$epoch"
  [ "$cleanup_ok" -eq 1 ] || say "ompup: committed journal retained for cleanup recovery"
}

pull_real() {
  [ "$STATE_PRESENT" -eq 1 ] || die "project is not initialized; run ompup sync"
  check_ack
  acquire_locks
  read_state; recover_transaction; read_state; require_marker; require_remote_tree "$REMOTE_DIR"; require_git_match; compute_changes
  require_effective_owner remote
  remote_ignore=$(ssh_read "cd \"\$HOME\"; cat $(sq "$REMOTE_DIR/.ompupignore") 2>/dev/null || true") ||
    die "cannot read remote exclusion policy"
  FILTER_KINDS=(); FILTER_RULES=(); RULES_TEXT=
  add_default_filters
  add_ignore_text "$remote_ignore" "remote .ompupignore"
  add_extra_filters
  make_filter_args; FILTER_DIGEST=$(filter_digest); compute_tracked_excluded; check_ack
  epoch=$(next_epoch "$ST_EPOCH")
  create_local_txn_dirs
  write_rules "$LOCAL_STAGE/rules"
  rsync_copy_local "$ROOT" "$LOCAL_STAGE/before"
  require_remote_tree "$REMOTE_DIR"
  rsync_remote_to_local "$REMOTE_DIR" "$LOCAL_STAGE/after"
  [ -z "$(compare_remote "$LOCAL_STAGE/after" "$REMOTE_DIR")" ] || die "remote source changed while staging pull"

  parent=${ROOT%/*}; [ -n "$parent" ] || parent=/
  create_local_container candidate "$parent"; LOCAL_CANDIDATE_CONTAINER=$CREATED_CONTAINER
  create_local_container backup "$parent"; LOCAL_BACKUP_CONTAINER=$CREATED_CONTAINER
  mkdir "$LOCAL_CANDIDATE_CONTAINER/tree" || die "cannot create local candidate tree"
  require_local_container "$LOCAL_CANDIDATE_CONTAINER" candidate
  (
    cd "$LOCAL_CANDIDATE_CONTAINER/tree"
    cp -Rp "$ROOT"/. .
  ) || die "failed to copy local Git boundary into candidate"
  rsync_copy_local "$LOCAL_STAGE/after" "$LOCAL_CANDIDATE_CONTAINER/tree"
  validate_tree "$LOCAL_CANDIDATE_CONTAINER/tree"
  [ -z "$(compare_local "$LOCAL_STAGE/after" "$LOCAL_CANDIDATE_CONTAINER/tree")" ] || die "local candidate validation failed"
  require_local_path_git_match "$LOCAL_CANDIDATE_CONTAINER/tree"
  [ -z "$(compare_local "$LOCAL_STAGE/before" "$ROOT")" ] || die "local destination changed before publication"
  require_live_local_git_tuple
  write_local_journal_temp pull "$epoch" "$LOCAL_CANDIDATE_CONTAINER" "$LOCAL_BACKUP_CONTAINER"
  publish_local_journal

  require_local_container "$LOCAL_BACKUP_CONTAINER" backup
  live_nonce=$(container_nonce live "$ROOT")
  (
    cd "$LOCAL_BACKUP_CONTAINER"
    [ ! -e tree ] && [ ! -L tree ]
    move_exact "$ROOT" tree || exit 1
    [ -d tree ] && [ ! -L tree ] && [ ! -e "$ROOT" ] && [ ! -L "$ROOT" ]
  ) || die "local backup move failed; journal retained for recovery"
  validate_tree "$LOCAL_BACKUP_CONTAINER/tree"
  backup_changed=0
  (require_local_path_git_match "$LOCAL_BACKUP_CONTAINER/tree") || backup_changed=1
  [ -z "$(compare_local "$LOCAL_STAGE/before" "$LOCAL_BACKUP_CONTAINER/tree")" ] || backup_changed=1
  if [ "$backup_changed" -eq 1 ]; then
    if [ ! -e "$ROOT" ] && [ ! -L "$ROOT" ]; then
      (
        cd "$LOCAL_BACKUP_CONTAINER"
        move_exact tree "$ROOT" || exit 1
        [ ! -e tree ] && [ ! -L tree ] && [ -d "$ROOT" ] && [ ! -L "$ROOT" ]
      ) || die "moved local third version could not be restored; preserved transaction artifacts"
      LOCAL_INSPECT_ROOT=$ROOT
      cd "$ROOT"
      die "local destination changed during backup move; restored moved third version and preserved transaction artifacts"
    fi
    die "local destination changed during backup move and live path is occupied; preserved both versions and transaction artifacts"
  fi

  require_local_container "$LOCAL_CANDIDATE_CONTAINER" candidate
  [ ! -e "$ROOT" ] && [ ! -L "$ROOT" ] || die "concurrent local destination blocks promotion"
  mkdir "$ROOT" || die "cannot exclusively create local live destination"
  [ -d "$ROOT" ] && [ ! -L "$ROOT" ] || die "new local live destination is unsafe"
  write_exclusive_file "$ROOT/.ompup-nonce" "$live_nonce"$'\n'
  (
    cd "$ROOT"
    [ "$(cat .ompup-nonce)" = "$live_nonce" ] && [ -f .ompup-nonce ] && [ ! -L .ompup-nonce ]
    cp -Rp "$LOCAL_CANDIDATE_CONTAINER/tree"/. .
    [ "$(cat .ompup-nonce)" = "$live_nonce" ]
    rm -- .ompup-nonce
  ) || die "local candidate promotion failed; journal retained for recovery"
  LOCAL_INSPECT_ROOT=$ROOT
  cd "$ROOT"
  validate_tree "$ROOT"
  [ -z "$(compare_local "$LOCAL_STAGE/after" "$ROOT")" ] ||
    die "local live validation failed; transaction artifacts preserved"
  require_local_path_git_match "$ROOT"
  require_marker; require_remote_tree "$REMOTE_DIR"; require_git_match
  [ -z "$(compare_remote "$LOCAL_STAGE/after" "$REMOTE_DIR")" ] ||
    die "remote source changed before ownership commit; transaction artifacts preserved"
  materialize_baseline "$epoch" "$LOCAL_STAGE/after"
  ack=$ST_ACK_DIGEST; [ -n "$TRACKED_EXCLUDED" ] && ack=$ACK_DIGEST
  old_baseline=$ST_BASELINE_EPOCH
  require_live_local_git_tuple
  write_state local "$epoch" "$epoch" "$ack"
  remove_baseline_generation "$old_baseline"
  remove_local_container "$LOCAL_BACKUP_CONTAINER" backup; LOCAL_BACKUP_CONTAINER=
  remove_local_container "$LOCAL_CANDIDATE_CONTAINER" candidate; LOCAL_CANDIDATE_CONTAINER=
  safe_remove_local_dir "$LOCAL_STAGE"
  PUBLISHED=0; LOCAL_STAGE=
  ST_OWNER=local; ST_EPOCH=$epoch; ST_BASELINE_EPOCH=$epoch
  release_locks
  say "ompup: pulled $HOST:~/$REMOTE_DIR -> $ROOT; owner=local epoch=$epoch"
}

dry_run() {
  say "dry-run: no managed mutations"
  say "identity-kind: $IDENTITY_KIND"; say "identity: $IDENTITY_HASH"; say "address: $ADDRESS"; say "remote: $HOST:~/$REMOTE_DIR"
  print_policy; check_ack
  dest=$(remote_destination_state) || die "cannot inspect remote destination"
  if [ "$STATE_PRESENT" -eq 0 ]; then
    [ "$CMD" = sync ] || die "project is not initialized; pull has no source ledger"
    [ "$dest" = absent ] || die "remote destination collision: $dest"
    if [ "$IDENTITY_KIND" = git ]; then
      [ "$GIT_OID" != - ] || die "unborn initial Git cloneability cannot be proven read-only"
      refs=$(ssh_read "git ls-remote -- $(sq "$ORIGIN") 2>/dev/null") || die "remote cannot read Git origin"
      case "$refs" in *"$GIT_OID"*) ;; *) die "exact local HEAD cloneability is not provable read-only" ;; esac
    fi
    say "planned: create candidate, validate, swap into absent destination, owner local -> remote"
    return
  fi
  require_marker; require_git_match; compute_changes
  print_change_set local-changed "$LOCAL_CHANGES"; print_change_set remote-changed "$REMOTE_CHANGES"; print_change_set common-changed "$(common_changes)"
  if [ "$CMD" = sync ]; then require_effective_owner local; say "planned: whole-tree remote candidate and swap; owner local -> remote"
  else require_effective_owner remote; say "planned: whole-tree local candidate and swap; owner remote -> local"; fi
}

status_cmd() {
  say "local-root: $ROOT"; say "identity-kind: $IDENTITY_KIND"; say "identity: $IDENTITY_HASH"; say "address: $ADDRESS"; say "remote: $HOST:~/$REMOTE_DIR"
  say "local-git: $GIT_MODE $GIT_BRANCH $GIT_OID"
  if ! dest=$(remote_destination_state 2>/dev/null); then
    dest=unreachable
    say "remote-destination: $dest"
    if [ "$STATE_PRESENT" -eq 0 ]; then say "committed-owner: (uninitialized)"; else say "committed-owner: $ST_OWNER"; say "epoch: $ST_EPOCH"; fi
    say "effective-owner: unknown-conflict"; say "local-changed: (not compared)"; say "remote-changed: (not compared)"
    say "blocker: remote connectivity failed"; say "tmux: unknown $SESSION"; return 0
  fi
  say "remote-destination: $dest"
  if [ "$STATE_PRESENT" -eq 0 ]; then
    say "committed-owner: (uninitialized)"; say "effective-owner: unknown-conflict"; print_policy
    if [ "$dest" = absent ]; then say "blocker: run ompup sync"; else say "blocker: remote destination collision: $dest"; fi
    return 0
  fi
  if [ "$dest" != marked ]; then
    say "remote-git: (not inspected)"; say "committed-owner: $ST_OWNER"; say "effective-owner: unknown-conflict"; say "epoch: $ST_EPOCH"
    say "local-changed: (not compared)"; say "remote-changed: (not compared)"
    say "blocker: remote destination/marker mismatch: $dest"; say "tmux: unknown $SESSION"; return 0
  fi
  if ! ssh_read "$(remote_validate_tree_script "$REMOTE_DIR")" >/dev/null 2>&1; then
    say "remote-git: (not inspected)"; say "committed-owner: $ST_OWNER"; say "effective-owner: unknown-conflict"; say "epoch: $ST_EPOCH"
    say "local-changed: (not compared)"; say "remote-changed: (not compared)"
    say "blocker: remote tree validation failed"; say "tmux: unknown $SESSION"; return 0
  fi
  if ! marker=$(ssh_read "cd \"\$HOME\"; cat $(sq "$REMOTE_CONTROL/marker") 2>/dev/null"); then
    say "remote-git: (not inspected)"; say "committed-owner: $ST_OWNER"; say "effective-owner: unknown-conflict"; say "epoch: $ST_EPOCH"
    say "local-changed: (not compared)"; say "remote-changed: (not compared)"
    say "blocker: remote marker missing"; say "tmux: unknown $SESSION"; return 0
  fi
  if ! validate_marker_text "$marker"; then
    say "remote-git: (not inspected)"; say "committed-owner: $ST_OWNER"; say "effective-owner: unknown-conflict"; say "epoch: $ST_EPOCH"
    say "local-changed: (not compared)"; say "remote-changed: (not compared)"
    say "blocker: remote marker invalid: $MARKER_ERROR"; say "tmux: unknown $SESSION"; return 0
  fi
  if ! tuple=$(ssh_read "$(remote_git_tuple_script "$REMOTE_DIR")" 2>/dev/null); then
    say "remote-git: (invalid)"; say "committed-owner: $ST_OWNER"; say "effective-owner: unknown-conflict"; say "epoch: $ST_EPOCH"
    say "local-changed: (not compared)"; say "remote-changed: (not compared)"
    say "blocker: ${tuple:-remote Git validation failed}"; say "tmux: unknown $SESSION"; return 0
  fi
  IFS=$'\t' read -r REMOTE_GIT_MODE REMOTE_GIT_BRANCH REMOTE_GIT_OID extra <<< "$tuple"
  if [ -n "${extra:-}" ] || [ -z "$REMOTE_GIT_MODE" ]; then
    say "remote-git: (malformed)"; say "committed-owner: $ST_OWNER"; say "effective-owner: unknown-conflict"; say "epoch: $ST_EPOCH"
    say "local-changed: (not compared)"; say "remote-changed: (not compared)"
    say "blocker: malformed remote Git tuple"; say "tmux: unknown $SESSION"; return 0
  fi
  say "remote-git: $REMOTE_GIT_MODE $REMOTE_GIT_BRANCH $REMOTE_GIT_OID"
  if [ "$REMOTE_GIT_MODE/$REMOTE_GIT_BRANCH/$REMOTE_GIT_OID" != "$GIT_MODE/$GIT_BRANCH/$GIT_OID" ]; then
    say "committed-owner: $ST_OWNER"; say "effective-owner: unknown-conflict"; say "epoch: $ST_EPOCH"
    say "local-changed: (not compared)"; say "remote-changed: (not compared)"
    say "blocker: Git tuple diverged"; say "tmux: unknown $SESSION"; return 0
  fi
  load_frozen_filters
  if ! LOCAL_CHANGES=$(compare_local "$BASELINES/$ST_BASELINE_EPOCH/tree" "$ROOT"); then
    say "committed-owner: $ST_OWNER"; say "effective-owner: unknown-conflict"; say "epoch: $ST_EPOCH"
    say "local-changed: (comparison failed)"; say "remote-changed: (not compared)"
    say "blocker: local change comparison failed"; say "tmux: unknown $SESSION"; return 0
  fi
  if ! REMOTE_CHANGES=$(compare_remote "$BASELINES/$ST_BASELINE_EPOCH/tree" "$REMOTE_DIR"); then
    say "committed-owner: $ST_OWNER"; say "effective-owner: unknown-conflict"; say "epoch: $ST_EPOCH"
    print_change_set local-changed "$LOCAL_CHANGES"; say "remote-changed: (comparison failed)"
    say "blocker: remote connectivity/change comparison failed"; say "tmux: unknown $SESSION"; return 0
  fi
  blocker=none; effective=$ST_OWNER; common=$(common_changes)
  if [ -n "$LOCAL_CHANGES" ] && [ -n "$REMOTE_CHANGES" ]; then blocker='both sides changed'; effective=unknown-conflict
  elif [ "$ST_OWNER" = remote ] && [ -n "$LOCAL_CHANGES" ]; then blocker='non-owning local side changed'; effective=unknown-conflict
  elif [ "$ST_OWNER" = local ] && [ -n "$REMOTE_CHANGES" ]; then blocker='non-owning remote side changed'; effective=unknown-conflict
  fi
  if pending=$(ssh_read "cd \"\$HOME\"; { [ -d $(sq "$REMOTE_LOCK") ] && echo lock; find $(sq "$REMOTE_CONTROL/txn") -type f -name journal -print 2>/dev/null || true; }" 2>/dev/null); then
    [ -z "$pending" ] || { blocker="pending transaction or lock: $pending"; effective=unknown-conflict; }
  else
    blocker='remote connectivity failed while inspecting transactions'; effective=unknown-conflict
  fi
  say "committed-owner: $ST_OWNER"; say "effective-owner: $effective"; say "epoch: $ST_EPOCH"
  print_change_set local-changed "$LOCAL_CHANGES"; print_change_set remote-changed "$REMOTE_CHANGES"; print_change_set common-changed "$common"
  say "filter-digest: $ST_FILTER_DIGEST"; say "exclude-ack-digest: $ST_ACK_DIGEST"; say "blocker: $blocker"
  if ssh_read "tmux has-session -t $(sq "=$SESSION") 2>/dev/null" >/dev/null 2>&1; then say "tmux: running $SESSION"; else say "tmux: absent $SESSION"; fi
}

effective_owner() {
  require_marker; require_git_match; compute_changes
  if [ -n "$LOCAL_CHANGES" ] && [ -n "$REMOTE_CHANGES" ]; then
    print_change_set local-changed "$LOCAL_CHANGES"; print_change_set remote-changed "$REMOTE_CHANGES"; die "ownership is unknown-conflict"
  fi
  if [ "$ST_OWNER" = remote ] && [ -n "$LOCAL_CHANGES" ]; then
    print_change_set local-changed "$LOCAL_CHANGES"; die "non-owning local side changed; ownership is unknown-conflict"
  fi
  if [ "$ST_OWNER" = local ] && [ -n "$REMOTE_CHANGES" ]; then
    print_change_set remote-changed "$REMOTE_CHANGES"; die "non-owning remote side changed; ownership is unknown-conflict"
  fi
  printf '%s' "$ST_OWNER"
}
attach_cmd() {
  [ "$STATE_PRESENT" -eq 1 ] || die "project is not initialized; run ompup sync"
  owner=$(effective_owner); [ "$owner" = remote ] || die "remote does not own the tree; run ompup sync"
  ssh_read "cd \"\$HOME\"; [ ! -d $(sq "$REMOTE_LOCK") ] && [ -z \"\$(find $(sq "$REMOTE_CONTROL/txn") -type f -name journal -print -quit 2>/dev/null || true)\" ]" >/dev/null 2>&1 || die "data lock or transaction is active; attach refused"
  ssh_run "command -v tmux >/dev/null && command -v bash >/dev/null" || die "required remote command not found: tmux or bash"
  if [ "$1" = shell ]; then command_text='exec "${SHELL:-/bin/sh}"'
  else command_text="$LAUNCH; exec \"\${SHELL:-/bin/sh}\""; fi
  tmux_command="bash -lc $(sq "$command_text")"
  exec ssh -t "$HOST" "tmux new-session -A -s $(sq "$SESSION") -c \"\$HOME/$REMOTE_DIR\" $(sq "$tmux_command")"
}

case "$CMD" in
  status) status_cmd ;;
  sync) if [ "$DRY_RUN" -eq 1 ]; then dry_run; else sync_real; fi ;;
  pull) if [ "$DRY_RUN" -eq 1 ]; then dry_run; else pull_real; fi ;;
  attach) attach_cmd omp ;;
  shell)
    if [ "$STATE_PRESENT" -eq 1 ]; then
      owner=$(effective_owner)
      [ "$owner" != remote ] || die "remote already owns the tree; run ompup attach"
    fi
    sync_real
    attach_cmd shell ;;
  up)
    if [ "$STATE_PRESENT" -eq 1 ]; then
      owner=$(effective_owner)
      [ "$owner" != remote ] || die "remote already owns the tree; run ompup attach"
    fi
    sync_real
    attach_cmd omp ;;
esac
