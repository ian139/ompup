#!/usr/bin/env python3
"""Safely enter a project-specific OMP session on a remote development box.

Git history is bundled only when a remote checkout is first created; later
committed-history changes travel through Git. Uncommitted working state is
synchronized as a Git tree snapshot, guarded by the exact HEAD and tree
recorded after the last successful transfer.
"""

from __future__ import annotations

import argparse

import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tarfile
import tempfile

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from ompup.hosts import (  # noqa: E402
    HostChoice,
    HostProbe,
    HostSelectionError,
    choose_host,
    find_host,
    format_probe,
    load_hosts,
    pin_host,
    pinned_host,
    probe_hosts,
    project_profile,
    resolve_project,
    unpin_host,
)

VERSION = "0.4.0"
LEGACY_HOST = os.environ.get("OMPUP_HOST", "")
REMOTE_ROOT = os.environ.get("OMPUP_REMOTE_ROOT", "Projects").strip("/")
LAUNCH_OVERRIDE = os.environ.get("OMPUP_CMD", "")
LAUNCH = ""
REMOTE = ""
PRESERVED_DIRS = {
    "node_modules",
    ".venv",
    "venv",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    "target",
    "dist",
    "build",
    ".next",
    ".turbo",
    ".cache",
}
SENSITIVE_NAMES = {".env", ".envrc", ".npmrc", ".pypirc"}

REMOTE_STATE_SCRIPT = r"""
set -euo pipefail
repo="$HOME/$1"
git_dir=$(git -C "$repo" rev-parse --absolute-git-dir)
idx=$(mktemp)
rm -f "$idx"
trap 'rm -f "$idx"' EXIT
if [ -f "$git_dir/index" ]; then cp "$git_dir/index" "$idx"; fi
GIT_INDEX_FILE="$idx" git -C "$repo" add -A -- . >/dev/null
head=$(git -C "$repo" rev-parse --verify HEAD 2>/dev/null || printf '0000000000000000000000000000000000000000')
tree=$(GIT_INDEX_FILE="$idx" git -C "$repo" write-tree)
printf '%s:%s\n' "$head" "$tree"
"""

READ_BASELINE_SCRIPT = r"""
set -euo pipefail
path="$HOME/.local/state/ompup/$1.state"
[ -f "$path" ] || exit 3
cat "$path"
"""

WRITE_BASELINE_SCRIPT = r"""
set -euo pipefail
umask 077
dir="$HOME/.local/state/ompup"
mkdir -p "$dir"
tmp=$(mktemp "$dir/.state.XXXXXX")
trap 'rm -f "$tmp"' EXIT
printf '%s\n%s\n' "$2" "$3" > "$tmp"
mv "$tmp" "$dir/$1.state"
trap - EXIT
"""

BOOTSTRAP_SCRIPT = r"""
set -euo pipefail
target="$HOME/$1"
bundle="$2"
branch="$3"
origin="$4"
[ ! -e "$target" ] || { echo 'remote project path already exists' >&2; exit 4; }
mkdir -p "$(dirname "$target")"
cleanup() { rm -rf "$target"; [ -z "$bundle" ] || rm -f "$HOME/$bundle"; }
trap cleanup ERR INT TERM
if [ -n "$bundle" ]; then
  git clone -q --branch "$branch" "$HOME/$bundle" "$target"
  git -C "$target" remote remove origin
  rm -f "$HOME/$bundle"
else
  git init -q -b "$branch" "$target"
fi
if [ -n "$origin" ]; then git -C "$target" remote add origin "$origin"; fi
trap - ERR INT TERM
"""

ARCHIVE_SCRIPT = r"""
set -euo pipefail
exec git -C "$HOME/$1" archive --format=tar "$2"
"""

FAST_FORWARD_REMOTE_SCRIPT = r"""
set -euo pipefail
repo="$HOME/$1"
bundle="$HOME/$2"
branch="$3"
cleanup() { rm -f "$bundle"; }
trap cleanup EXIT
current_branch=$(git -C "$repo" symbolic-ref --quiet --short HEAD)
if [ "$current_branch" != "$branch" ]; then
  printf 'branch mismatch: remote=%s local=%s\n' "$current_branch" "$branch" >&2
  exit 6
fi
git -C "$repo" fetch -q "$bundle" "refs/heads/$branch"
incoming=$(git -C "$repo" rev-parse FETCH_HEAD)
current=$(git -C "$repo" rev-parse --verify HEAD 2>/dev/null || true)
if [ -n "$current" ]; then
  git -C "$repo" merge-base --is-ancestor "$current" "$incoming"
fi
git -C "$repo" reset --hard -q "$incoming"
"""

CREATE_REMOTE_BUNDLE_SCRIPT = r"""
set -euo pipefail
repo="$HOME/$1"
bundle="$HOME/$2"
branch=$(git -C "$repo" symbolic-ref --quiet --short HEAD)
git -C "$repo" bundle create "$bundle" "refs/heads/$branch" >/dev/null
printf '%s\n' "$branch"
"""

PREPARE_HANDOFF_SCRIPT = r"""
set -euo pipefail
target="$HOME/$1"
umask 077
rm -rf "$target"
mkdir -p "$target"
chmod 700 "$target"
"""

VERIFY_HANDOFF_SCRIPT = r"""
set -euo pipefail
target="$HOME/$1"
expected="$2"
launch="$3"
session_file="$target/session.jsonl"
case "$launch" in
  '$HOME/'*) launch="$HOME/${launch#\$HOME/}" ;;
  '~/'*) launch="$HOME/${launch#\~/}" ;;
esac
actual=$(python3 - "$session_file" <<'PY'
import hashlib
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
digest = hashlib.sha256()
with path.open("rb") as handle:
    for chunk in iter(lambda: handle.read(1024 * 1024), b""):
        digest.update(chunk)
print(digest.hexdigest())
PY
)
[ "$actual" = "$expected" ] || {
  printf 'session checksum mismatch: expected=%s actual=%s\n' "$expected" "$actual" >&2
  exit 5
}
chmod 600 "$session_file"
[ ! -d "$target/session" ] || chmod -R go-rwx "$target/session"
validation_dir=$(mktemp -d "$target/.validate.XXXXXX")
trap 'rm -rf "$validation_dir"' EXIT
(
  cd "$validation_dir"
  "$launch" --export "$session_file" >/dev/null
)
"""

START_HANDOFF_SCRIPT = r"""
set -euo pipefail
repo="$HOME/$1"
session="$2"
session_file="$HOME/$3"
launch="$4"
case "$launch" in
  '$HOME/'*) launch="$HOME/${launch#\$HOME/}" ;;
  '~/'*) launch="$HOME/${launch#\~/}" ;;
esac
tmux has-session -t "=$session" 2>/dev/null && {
  printf 'tmux session already exists: %s\n' "$session" >&2
  exit 4
}
printf -v command '%q ' "$launch" --cwd "$repo" --resume "$session_file"
tmux new-session -d -s "$session" -c "$repo" "$command"
sleep 2
tmux has-session -t "=$session" 2>/dev/null || {
  printf 'remote OMP exited before becoming attachable\n' >&2
  exit 6
}
"""

CLEANUP_HANDOFF_SCRIPT = r"""
set -euo pipefail
if [ "$3" = 1 ]; then tmux kill-session -t "=$1" 2>/dev/null || true; fi
rm -rf "$HOME/$2"
"""


def die(message: str) -> "NoReturn":
    print(f"ompup: {message}", file=sys.stderr)
    raise SystemExit(1)


def run(
    args: list[str],
    *,
    cwd: Path | None = None,
    env: dict[str, str] | None = None,
    check: bool = True,
    capture: bool = False,
    text: bool = True,
) -> subprocess.CompletedProcess:
    return subprocess.run(
        args,
        cwd=cwd,
        env=env,
        check=check,
        capture_output=capture,
        text=text,
    )


def ssh_command(command: str, *, check: bool = True, capture: bool = False) -> subprocess.CompletedProcess:
    return run(["ssh", REMOTE, command], check=check, capture=capture)


def ssh_script(
    script: str,
    *args: str,
    check: bool = True,
    capture: bool = False,
) -> subprocess.CompletedProcess:
    command = "bash -s -- " + " ".join(shlex.quote(arg) for arg in args)
    return subprocess.run(
        ["ssh", REMOTE, command],
        input=script,
        text=True,
        check=check,
        capture_output=capture,
    )


def git(root: Path, *args: str, env: dict[str, str] | None = None, capture: bool = True) -> str:
    result = run(["git", "-C", str(root), *args], env=env, capture=capture)
    return result.stdout.strip() if capture else ""




def project_identity(root: Path) -> tuple[str, str]:
    result = run(
        ["git", "-C", str(root), "remote", "get-url", "origin"],
        check=False,
        capture=True,
    )
    origin = result.stdout.strip() if result.returncode == 0 else ""
    material = f"origin\0{origin}" if origin else f"path\0{root}"
    identity = hashlib.sha256(material.encode()).hexdigest()

    # Never copy credential-bearing or machine-local origins to the remote box.
    remote_origin = origin
    if re.match(r"https?://[^/@]+@", origin) or (origin and origin.startswith(("/", "file:"))):
        remote_origin = ""
    return identity, remote_origin


def prepare_index(root: Path) -> tuple[Path, str, list[str]]:
    git_dir = Path(git(root, "rev-parse", "--absolute-git-dir"))
    handle = tempfile.NamedTemporaryFile(prefix="ompup-index-", delete=False)
    index = Path(handle.name)
    handle.close()
    index.unlink()
    if (git_dir / "index").is_file():
        shutil.copy2(git_dir / "index", index)

    env = os.environ.copy()
    env["GIT_INDEX_FILE"] = str(index)
    try:
        git(root, "add", "-A", "--", ".", env=env, capture=False)
        tree = git(root, "write-tree", env=env)
        entries = git(root, "ls-files", "-z", env=env).split("\0")
    except Exception:
        index.unlink(missing_ok=True)
        raise
    return index, tree, [entry for entry in entries if entry]


def repository_head(root: Path) -> str:
    result = run(
        ["git", "-C", str(root), "rev-parse", "--verify", "HEAD"],
        check=False,
        capture=True,
    )
    return result.stdout.strip() if result.returncode == 0 else "0" * 40


def local_state(root: Path) -> str:
    index, tree, _ = prepare_index(root)
    index.unlink(missing_ok=True)
    return f"{repository_head(root)}:{tree}"


def remote_exists(remote_dir: str) -> bool:
    command = f"test -d {shlex.quote(remote_dir)}"
    return ssh_command(command, check=False).returncode == 0


def remote_state(remote_dir: str) -> str:
    result = ssh_script(REMOTE_STATE_SCRIPT, remote_dir, capture=True)
    return result.stdout.strip()


def session_exists(session: str) -> bool:
    result = ssh_script('tmux has-session -t "=$1" 2>/dev/null', session, check=False)
    return result.returncode == 0


def read_baseline(state_key: str) -> tuple[str, str] | None:
    result = ssh_script(READ_BASELINE_SCRIPT, state_key, check=False, capture=True)
    if result.returncode == 3:
        return None
    if result.returncode != 0:
        die("could not read remote synchronization state")
    lines = result.stdout.splitlines()
    if len(lines) != 2 or not re.fullmatch(r"[0-9a-f]{64}", lines[0]):
        die("remote synchronization state is malformed")
    return lines[0], lines[1]


def write_baseline(state_key: str, identity: str, state: str) -> None:
    ssh_script(WRITE_BASELINE_SCRIPT, state_key, identity, state)


def validate_snapshot_paths(entries: list[str]) -> None:
    for entry in entries:
        path = Path(entry)
        if any(part in PRESERVED_DIRS for part in path.parts):
            die(f"unignored dependency/build path would transfer: {entry}")
        name = path.name
        if name in SENSITIVE_NAMES or name.startswith(".env.") or name.endswith((".pem", ".key")):
            die(f"sensitive path requires explicit handling and will not transfer: {entry}")


def scan_snapshot(path: Path) -> None:
    result = run(
        ["gitleaks", "dir", "--no-banner", "--redact", "--log-level", "error", str(path)],
        check=False,
        capture=True,
    )
    if result.returncode != 0:
        die("secret scan rejected the working snapshot; review it locally with gitleaks")


def scan_history(root: Path) -> None:
    result = run(
        ["gitleaks", "git", "--no-banner", "--redact", "--log-level", "error", str(root)],
        check=False,
        capture=True,
    )
    if result.returncode != 0:
        die("secret scan rejected reachable Git history; review it locally with gitleaks")


def make_local_stage(root: Path, stage: Path) -> str:
    index, tree, entries = prepare_index(root)
    try:
        validate_snapshot_paths(entries)
        env = os.environ.copy()
        env["GIT_INDEX_FILE"] = str(index)
        prefix = str(stage) + os.sep
        git(root, "checkout-index", "--all", "--force", f"--prefix={prefix}", env=env, capture=False)
    finally:
        index.unlink(missing_ok=True)
    scan_snapshot(stage)
    return f"{repository_head(root)}:{tree}"


def rsync_stage(stage: Path, destination: str) -> None:
    args = ["rsync", "-a", "--delete", "--exclude", ".git/"]
    for directory in sorted(PRESERVED_DIRS):
        args.extend(["--exclude", f"{directory}/"])
    args.extend([str(stage) + os.sep, destination])
    run(args)


def bootstrap(
    root: Path,
    project: str,
    state_key: str,
    remote_dir: str,
    identity: str,
    origin: str,
) -> str:
    branch = git(root, "symbolic-ref", "--short", "HEAD")
    with tempfile.TemporaryDirectory(prefix="ompup-stage-") as stage_name, tempfile.TemporaryDirectory(
        prefix="ompup-bundle-"
    ) as bundle_dir:
        stage = Path(stage_name)
        expected = make_local_stage(root, stage)
        head = expected.split(":", 1)[0]
        remote_bundle = ""
        if head != "0" * 40:
            scan_history(root)
            bundle = Path(bundle_dir) / f"{project}.bundle"
            git(root, "bundle", "create", str(bundle), f"refs/heads/{branch}", capture=False)
            remote_bundle = f".cache/ompup/{project}.{os.getpid()}.bundle"
            ssh_command("mkdir -p ~/.cache/ompup")
            run(["rsync", "-a", str(bundle), f"{REMOTE}:{remote_bundle}"])
        ssh_script(BOOTSTRAP_SCRIPT, remote_dir, remote_bundle, branch, origin)
        rsync_stage(stage, f"{REMOTE}:{remote_dir}/")

    actual = remote_state(remote_dir)
    if actual != expected:
        die("remote checkout did not match the prepared snapshot; synchronization state was not recorded")
    write_baseline(state_key, identity, actual)
    print(f"ompup: bootstrapped {REMOTE}:~/{remote_dir}")
    return actual

def is_ancestor(root: Path, ancestor: str, descendant: str) -> bool:
    if ancestor == "0" * 40:
        return True
    result = run(
        ["git", "-C", str(root), "merge-base", "--is-ancestor", ancestor, descendant],
        check=False,
    )
    return result.returncode == 0


def fast_forward_remote(root: Path, project: str, remote_dir: str, remote_head: str) -> None:
    local_head = repository_head(root)
    if not is_ancestor(root, remote_head, local_head):
        die("local commit history is not a fast-forward of the remote; reconcile it with Git")
    branch = git(root, "symbolic-ref", "--short", "HEAD")
    scan_history(root)
    with tempfile.TemporaryDirectory(prefix="ompup-commit-bundle-") as bundle_dir:
        bundle = Path(bundle_dir) / f"{project}.bundle"
        git(root, "bundle", "create", str(bundle), f"refs/heads/{branch}", capture=False)
        remote_bundle = f".cache/ompup/{project}.{os.getpid()}.ff.bundle"
        ssh_command("mkdir -p ~/.cache/ompup")
        run(["rsync", "-a", str(bundle), f"{REMOTE}:{remote_bundle}"])
        result = ssh_script(
            FAST_FORWARD_REMOTE_SCRIPT,
            remote_dir,
            remote_bundle,
            branch,
            check=False,
            capture=True,
        )
        if result.returncode != 0:
            detail = result.stderr.strip().splitlines()[-1] if result.stderr.strip() else "remote Git rejected the update"
            die(f"could not fast-forward remote commits: {detail}")
    print(f"ompup: fast-forwarded remote commits to {local_head[:10]}")


def fast_forward_local(root: Path, project: str, remote_dir: str, remote_head: str) -> None:
    local_head = repository_head(root)
    remote_bundle = f".cache/ompup/{project}.{os.getpid()}.pull.bundle"
    ssh_command("mkdir -p ~/.cache/ompup")
    result = ssh_script(
        CREATE_REMOTE_BUNDLE_SCRIPT,
        remote_dir,
        remote_bundle,
        check=False,
        capture=True,
    )
    if result.returncode != 0:
        die("could not create a Git bundle from the remote branch")
    branch = result.stdout.strip()
    local_branch = run(
        ["git", "-C", str(root), "symbolic-ref", "--quiet", "--short", "HEAD"],
        check=False,
        capture=True,
    )
    if local_branch.returncode != 0 or local_branch.stdout.strip() != branch:
        ssh_command(f"rm -f {shlex.quote(remote_bundle)}", check=False)
        die(f"branch mismatch: local={local_branch.stdout.strip() or 'detached'} remote={branch}")
    with tempfile.TemporaryDirectory(prefix="ompup-pull-bundle-") as bundle_dir:
        bundle = Path(bundle_dir) / f"{project}.bundle"
        try:
            run(["rsync", "-a", f"{REMOTE}:{remote_bundle}", str(bundle)])
        finally:
            ssh_command(f"rm -f {shlex.quote(remote_bundle)}", check=False)
        git(root, "fetch", "-q", str(bundle), f"refs/heads/{branch}")
        incoming = git(root, "rev-parse", "FETCH_HEAD")
        if incoming != remote_head or not is_ancestor(root, local_head, incoming):
            die("remote commit history is not a fast-forward of local; reconcile it with Git")
        temp_ref = "refs/ompup/incoming"
        git(root, "update-ref", temp_ref, incoming, capture=False)
        try:
            scan_history(root)
        finally:
            git(root, "update-ref", "-d", temp_ref, capture=False)
        git(root, "reset", "--hard", "-q", incoming, capture=False)
    print(f"ompup: fast-forwarded local commits to {incoming[:10]}")


def assert_identity(state_key: str, remote_dir: str, identity: str, local: str, remote: str) -> str:
    baseline = read_baseline(state_key)
    if baseline is None:
        if local != remote:
            die("existing remote checkout predates safe sync and differs locally; reconcile it with Git first")
        write_baseline(state_key, identity, remote)
        return remote
    recorded_identity, recorded_state = baseline
    if recorded_identity != identity:
        die(f"~/{remote_dir} maps to a different local repository; choose a distinct project name")
    return recorded_state


def sync_up(
    root: Path,
    project: str,
    state_key: str,
    remote_dir: str,
    identity: str,
    origin: str,
) -> None:
    local = local_state(root)
    if not remote_exists(remote_dir):
        bootstrap(root, project, state_key, remote_dir, identity, origin)
        return

    remote = remote_state(remote_dir)
    baseline = assert_identity(state_key, remote_dir, identity, local, remote)
    if local == remote:
        write_baseline(state_key, identity, remote)
        print("ompup: local and remote snapshots already match")
        return
    if remote != baseline:
        die("remote working state changed since the last sync; run `ompup pull` or resolve the conflict")
    local_head, remote_head = local.split(":", 1)[0], remote.split(":", 1)[0]
    if local_head != remote_head:
        fast_forward_remote(root, project, remote_dir, remote_head)

    with tempfile.TemporaryDirectory(prefix="ompup-stage-") as stage_name:
        expected = make_local_stage(root, Path(stage_name))
        if expected != local:
            die("local checkout changed while its snapshot was being prepared; retry")
        rsync_stage(Path(stage_name), f"{REMOTE}:{remote_dir}/")

    actual = remote_state(remote_dir)
    if actual != local:
        die("remote verification did not match the local snapshot; synchronization state was not advanced")
    write_baseline(state_key, identity, actual)
    print("ompup: synchronized local working state to remote")


def download_remote_stage(remote_dir: str, tree: str, stage: Path) -> None:
    command = "bash -s -- " + " ".join(shlex.quote(value) for value in (remote_dir, tree))
    with tempfile.NamedTemporaryFile(prefix="ompup-archive-", suffix=".tar") as archive:
        process = subprocess.Popen(
            ["ssh", REMOTE, command],
            stdin=subprocess.PIPE,
            stdout=archive,
            stderr=subprocess.PIPE,
        )
        _, stderr = process.communicate(ARCHIVE_SCRIPT.encode())
        if process.returncode != 0:
            die(f"could not archive remote working state: {stderr.decode(errors='replace').strip()}")
        archive.flush()
        archive.seek(0)
        with tarfile.open(fileobj=archive, mode="r:") as tar:
            for member in tar.getmembers():
                target = (stage / member.name).resolve()
                if not target.is_relative_to(stage.resolve()):
                    die("remote archive contains an unsafe path")
            tar.extractall(stage, filter="data")
    scan_snapshot(stage)


def sync_down(root: Path, project: str, state_key: str, remote_dir: str, identity: str) -> None:
    if not remote_exists(remote_dir):
        die(f"nothing at {REMOTE}:~/{remote_dir}")
    local = local_state(root)
    remote = remote_state(remote_dir)
    baseline = assert_identity(state_key, remote_dir, identity, local, remote)
    if local == remote:
        write_baseline(state_key, identity, remote)
        print("ompup: local and remote snapshots already match")
        return
    if local != baseline:
        if remote == baseline:
            die("remote has no changes to download; local working state changed")
        die("both local and remote working states changed since the last sync; resolve the conflict")
    local_head, remote_head = local.split(":", 1)[0], remote.split(":", 1)[0]
    if local_head != remote_head:
        fast_forward_local(root, project, remote_dir, remote_head)

    tree = remote.split(":", 1)[1]
    with tempfile.TemporaryDirectory(prefix="ompup-stage-") as stage_name:
        stage = Path(stage_name)
        download_remote_stage(remote_dir, tree, stage)
        rsync_stage(stage, str(root) + os.sep)

    actual = local_state(root)
    if actual != remote:
        die("local verification did not match the remote snapshot; synchronization state was not advanced")
    write_baseline(state_key, identity, actual)
    print("ompup: synchronized remote working state to local")
    run(["git", "-C", str(root), "status", "--short"], check=False)


def show_status(
    root: Path,
    state_key: str,
    remote_dir: str,
    identity: str,
    session: str,
) -> None:
    local = local_state(root)
    print(f"== local ({root})")
    run(["git", "-C", str(root), "status", "--short", "--branch"], check=False)
    if not remote_exists(remote_dir):
        print(f"== remote ({REMOTE}:~/{remote_dir})\n(no checkout)\n== tmux\n(no session {session})")
        return
    remote = remote_state(remote_dir)
    baseline_data = read_baseline(state_key)
    print(f"== remote ({REMOTE}:~/{remote_dir})")
    ssh_command(f"git -C {shlex.quote(remote_dir)} status --short --branch", check=False)
    print("== sync")
    if baseline_data is None:
        print("unregistered existing checkout")
    elif baseline_data[0] != identity:
        print("project identity mismatch")
    elif local == remote:
        print("local and remote match")
    elif local.split(":", 1)[0] != remote.split(":", 1)[0]:
        print("commits differ; synchronize with Git before transferring working state")
    elif local == baseline_data[1]:
        print("remote changed; `ompup pull` is safe")
    elif remote == baseline_data[1]:
        print("local changed; `ompup sync` is safe")
    else:
        print("both sides changed; manual resolution required")
    print("== tmux")
    print(f"session {session} is {'running' if session_exists(session) else 'not running'}")


def attach(session: str, remote_dir: str, launch: str) -> None:
    command = (
        f"tmux new-session -A -s {shlex.quote(session)} "
        f'-c \"$HOME/{remote_dir}\"'
    )
    if launch:
        command += " " + shlex.quote(f'{launch}; exec \"$SHELL\"')
    os.execvp("ssh", ["ssh", "-t", REMOTE, command])


def add_project_arguments(parser: argparse.ArgumentParser, *, cmux: bool = False) -> None:
    parser.add_argument("project", nargs="?", help="project name or path; defaults to the current Git repository")
    parser.add_argument("--pick", action="store_true", help="choose interactively from the projects directory")
    parser.add_argument("--host", default="", help="configured host name or SSH destination")
    parser.add_argument(
        "--profile",
        default="auto",
        help="host capability role (auto detects macos; custom configured roles are accepted)",
    )
    if cmux:
        parser.add_argument("--cmux", action="store_true", help="open or reuse a cmux workspace")


def create_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="ompup",
        description="Safely continue a local Git project inside persistent OMP on a remote machine.",
    )
    parser.add_argument("--version", action="version", version=f"ompup {VERSION}")
    commands = parser.add_subparsers(dest="command", required=True)
    for name, help_text in (
        ("up", "bootstrap or sync when needed, then attach OMP"),
        ("shell", "bootstrap or sync when needed, then attach a shell"),
        ("sync", "transfer local commits and working state without attaching"),
        ("pull", "transfer remote commits and working state to local"),
        ("status", "show selected host, synchronization, and tmux state"),
        ("doctor", "probe configured hosts and explain selection"),
    ):
        subparser = commands.add_parser(name, help=help_text)
        add_project_arguments(subparser, cmux=name in {"up", "shell"})
    handoff_parser = commands.add_parser(
        "handoff",
        help="move a live local OMP session into remote tmux and replace its cmux surface",
    )
    add_project_arguments(handoff_parser)
    handoff_parser.add_argument("--session-file", required=True, help=argparse.SUPPRESS)
    handoff_parser.add_argument("--artifacts-dir", default="", help=argparse.SUPPRESS)
    handoff_parser.add_argument("--session-id", required=True, help=argparse.SUPPRESS)
    handoff_parser.add_argument(
        "--prepare-only",
        action="store_true",
        help="prepare and verify remote OMP without replacing the local terminal",
    )
    hosts_parser = commands.add_parser("hosts", help="probe every configured host")
    hosts_parser.add_argument("--json", action="store_true", help="emit probe data as JSON")
    pin_parser = commands.add_parser("pin", help="pin a project to one configured host")
    pin_parser.add_argument("host")
    pin_parser.add_argument("project", nargs="?")
    pin_parser.add_argument("--pick", action="store_true")
    unpin_parser = commands.add_parser("unpin", help="remove a project's host pin")
    unpin_parser.add_argument("project", nargs="?")
    unpin_parser.add_argument("--pick", action="store_true")
    return parser


def parse_args() -> argparse.Namespace:
    argv = sys.argv[1:]
    commands = {"up", "shell", "sync", "pull", "status", "doctor", "hosts", "pin", "unpin", "handoff"}
    if not argv:
        argv = ["up"]
    elif argv[0] not in commands and argv[0] not in {"-h", "--help", "--version"}:
        argv.insert(0, "up")
    return create_parser().parse_args(argv)


def validate_local_requirements() -> None:
    if not REMOTE_ROOT or not re.fullmatch(r"[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*", REMOTE_ROOT):
        die("OMPUP_REMOTE_ROOT must be a relative path of safe directory names")
    if any(part in {".", ".."} for part in REMOTE_ROOT.split("/")):
        die("OMPUP_REMOTE_ROOT cannot contain . or ..")
    if os.environ.get("OMPUP_EXCLUDES"):
        die("OMPUP_EXCLUDES is no longer supported; use .gitignore or .git/info/exclude")
    for executable in ("git", "ssh", "rsync", "gitleaks"):
        if shutil.which(executable) is None:
            die(f"required local command not found: {executable}")


def host_context(
    root: Path,
    project: str,
    requested_host: str,
    requested_profile: str,
    *,
    persist: bool = True,
    probe_all: bool = False,
) -> tuple[HostChoice, list[HostProbe], str, str, str]:
    global LAUNCH, REMOTE
    remote_dir = f"{REMOTE_ROOT}/{project}"
    session = re.sub(r"[^a-z0-9_.:-]", "", project.lower().replace(" ", "-"))
    hosts = load_hosts(LEGACY_HOST)
    profile = project_profile(root, requested_profile)
    explicit = requested_host or (LEGACY_HOST if LEGACY_HOST not in {"", "auto"} else "")
    requested = explicit or pinned_host(root)
    probe_targets = hosts if probe_all or not requested else [find_host(hosts, requested)]
    probes = probe_hosts(probe_targets, remote_dir, session)
    choice = choose_host(hosts, probes, root, profile, explicit)
    REMOTE = choice.host.ssh
    LAUNCH = LAUNCH_OVERRIDE or choice.host.launch
    if persist and not pinned_host(root):
        pin_host(root, choice.host.name)
    state_key = f"{hashlib.sha256(remote_dir.encode()).hexdigest()[:16]}-{project}"
    return choice, probes, remote_dir, session, state_key


def print_banner(root: Path, project: str, choice: HostChoice, profile: str) -> None:
    status = git(root, "status", "--porcelain")
    branch_result = run(
        ["git", "-C", str(root), "symbolic-ref", "--quiet", "--short", "HEAD"],
        check=False,
        capture=True,
    )
    branch = branch_result.stdout.strip() or "detached"
    dirty = len(status.splitlines()) if status else 0
    probe = choice.probe
    print(
        f"ompup: {project} -> {choice.host.name} ({choice.reason}); "
        f"{probe.system}/{probe.arch}, {probe.free_gb:.0f} GB free, "
        f"load {probe.load1:.2f}/{probe.cpu_count} CPU; "
        f"{branch}, {dirty} changed path{'s' if dirty != 1 else ''}; profile {profile}"
    )


def show_hosts(as_json: bool = False) -> None:
    hosts = load_hosts(LEGACY_HOST)
    probes = probe_hosts(hosts, f"{REMOTE_ROOT}/.ompup-probe", ".ompup-probe")
    if as_json:
        print(
            json.dumps(
                [
                    {
                        "name": probe.host.name,
                        "ssh": probe.host.ssh,
                        "roles": probe.host.roles,
                        "reachable": probe.reachable,
                        "tools_ok": probe.tools_ok,
                        "system": probe.system,
                        "arch": probe.arch,
                        "cpu_count": probe.cpu_count,
                        "load1": probe.load1,
                        "memory_available": probe.memory_available,
                        "disk_free": probe.disk_free,
                        "latency_ms": probe.latency_ms,
                        "error": probe.error,
                    }
                    for probe in probes
                ],
                indent=2,
            )
        )
        return
    for probe in probes:
        print(format_probe(probe))


def open_cmux(root: Path, project: str, host_name: str, command: str) -> None:
    if shutil.which("cmux") is None:
        die("cmux is not installed")
    if run(["cmux", "ping"], check=False, capture=True).returncode != 0:
        die("cmux is installed but no live runtime is reachable")
    title = f"ompup:{project}@{host_name}"
    result = run(["cmux", "workspace", "list", "--json"], capture=True)
    payload = json.loads(result.stdout)
    existing = next(
        (
            workspace
            for workspace in payload.get("workspaces", [])
            if workspace.get("custom_title") == title or workspace.get("title") == title
        ),
        None,
    )
    if existing:
        run(["cmux", "workspace", "select", existing["ref"]])
        print(f"ompup: selected existing cmux workspace {title}")
        return
    executable = str(Path(__file__).resolve())
    launch_command = " ".join(
        shlex.quote(part)
        for part in (executable, command, str(root), "--host", host_name)
    )
    run(
        [
            "cmux",
            "workspace",
            "create",
            "--name",
            title,
            "--description",
            f"Persistent remote OMP on {host_name}",
            "--cwd",
            str(root),
            "--command",
            launch_command,
            "--focus",
            "true",
        ]
    )

def file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def validate_handoff_launch(launch: str) -> None:
    if not re.fullmatch(r"(?:\$HOME/|~/|/)?[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*", launch):
        die("handoff requires the selected host launch setting to be one executable path")


def ensure_cmux_runtime() -> None:
    if shutil.which("cmux") is None:
        die("session handoff requires cmux")
    if run(["cmux", "ping"], check=False, capture=True).returncode != 0:
        die("session handoff requires a live cmux runtime")


def cmux_caller() -> tuple[str, str] | None:
    result = run(["cmux", "identify"], check=False, capture=True)
    if result.returncode != 0:
        return None
    try:
        caller = json.loads(result.stdout).get("caller")
    except json.JSONDecodeError:
        return None
    if not caller or caller.get("surface_type") != "terminal":
        return None
    window = caller.get("window_ref")
    surface = caller.get("surface_ref")
    if not isinstance(window, str) or not isinstance(surface, str):
        return None
    return window, surface


def handoff_attach_command(session: str) -> str:
    remote_command = f"tmux attach-session -t {shlex.quote('=' + session)}"
    ssh = " ".join(shlex.quote(part) for part in ("ssh", "-t", REMOTE, remote_command))
    return f'{ssh}; exec "$SHELL" -l'


def replace_or_open_cmux(root: Path, project: str, host_name: str, session: str) -> str:
    command = handoff_attach_command(session)
    caller = cmux_caller()
    if caller:
        window, surface = caller
        result = run(
            [
                "cmux",
                "respawn-pane",
                "--window",
                window,
                "--surface",
                surface,
                "--command",
                command,
            ],
            check=False,
            capture=True,
        )
        if result.returncode == 0:
            return "replaced current cmux surface"

    run(
        [
            "cmux",
            "workspace",
            "create",
            "--name",
            f"ompup:{project}@{host_name}",
            "--description",
            f"Handed-off OMP session on {host_name}",
            "--cwd",
            str(root),
            "--command",
            command,
            "--focus",
            "true",
        ]
    )
    if caller:
        window, surface = caller
        closed = run(
            ["cmux", "close-surface", "--window", window, "--surface", surface],
            check=False,
            capture=True,
        )
        if closed.returncode == 0:
            return "opened fallback cmux workspace and closed the local surface"
    return "opened fallback cmux workspace"


def cleanup_handoff(session: str, handoff_dir: str, *, kill_session: bool) -> None:
    ssh_script(CLEANUP_HANDOFF_SCRIPT, session, handoff_dir, "1" if kill_session else "0", check=False)


def handoff_session(
    root: Path,
    project: str,
    remote_dir: str,
    session: str,
    state_key: str,
    identity: str,
    origin: str,
    choice: HostChoice,
    args: argparse.Namespace,
) -> None:
    session_file = Path(args.session_file).expanduser().resolve()
    if not session_file.is_file() or session_file.suffix != ".jsonl":
        die("active OMP session file is missing or is not JSONL")
    if not re.fullmatch(r"[A-Za-z0-9_-]+", args.session_id):
        die("active OMP session ID is not safe for remote storage")
    artifacts_dir = Path(args.artifacts_dir).expanduser().resolve() if args.artifacts_dir else None
    if artifacts_dir and artifacts_dir.exists() and (not artifacts_dir.is_dir() or artifacts_dir.is_symlink()):
        die("active OMP artifact path is not a regular directory")
    validate_handoff_launch(LAUNCH)
    if not args.prepare_only:
        ensure_cmux_runtime()
    if session_exists(session):
        die(f"remote tmux session {session!r} already exists; attach it or choose another host")

    sync_up(root, project, state_key, remote_dir, identity, origin)
    if session_exists(session):
        die(f"remote tmux session {session!r} appeared during synchronization; local OMP was preserved")

    handoff_dir = f".local/state/ompup/handoffs/{project}/{args.session_id}"
    remote_session_file = f"{handoff_dir}/session.jsonl"
    source_hash = file_sha256(session_file)
    ssh_script(PREPARE_HANDOFF_SCRIPT, handoff_dir)
    remote_started = False
    try:
        run(["rsync", "-a", str(session_file), f"{REMOTE}:{remote_session_file}"])
        if artifacts_dir and artifacts_dir.is_dir():
            run(["rsync", "-a", str(artifacts_dir) + os.sep, f"{REMOTE}:{handoff_dir}/session/"])
        if file_sha256(session_file) != source_hash:
            die("local OMP session changed during transfer; local OMP was preserved")

        verified = ssh_script(
            VERIFY_HANDOFF_SCRIPT,
            handoff_dir,
            source_hash,
            LAUNCH,
            check=False,
            capture=True,
        )
        if verified.returncode != 0:
            detail = verified.stderr.strip().splitlines()[-1] if verified.stderr.strip() else "remote export failed"
            die(f"remote OMP could not load the transferred session: {detail}")

        started = ssh_script(
            START_HANDOFF_SCRIPT,
            remote_dir,
            session,
            remote_session_file,
            LAUNCH,
            check=False,
            capture=True,
        )
        if started.returncode != 0:
            detail = started.stderr.strip().splitlines()[-1] if started.stderr.strip() else "remote OMP did not stay running"
            die(f"remote OMP did not become attachable: {detail}")
        remote_started = True

        if args.prepare_only:
            print(
                f"ompup: remote session ready on {choice.host.name}; "
                f"attach with `ssh -t {REMOTE} {shlex.quote(f'tmux attach-session -t ={session}')}`"
            )
            return
        mode = replace_or_open_cmux(root, project, choice.host.name, session)
        print(f"ompup: {mode}; remote session {args.session_id} verified")
    except BaseException:
        cleanup_handoff(session, handoff_dir, kill_session=remote_started)
        raise


def run_doctor(root: Path, project: str, args: argparse.Namespace) -> None:
    choice, probes, remote_dir, session, _ = host_context(
        root, project, args.host, args.profile, persist=False, probe_all=True
    )
    for probe in probes:
        marker = "*" if probe.host.name == choice.host.name else " "
        print(f"{marker} {format_probe(probe)}")
    print(f"selected {choice.host.name}: {choice.reason}")
    print(f"remote path ~/{remote_dir}; tmux session {session}")


def main() -> None:
    global LAUNCH, REMOTE
    args = parse_args()
    validate_local_requirements()
    try:
        if args.command == "hosts":
            show_hosts(args.json)
            return
        root = resolve_project(getattr(args, "project", "") or "", getattr(args, "pick", False))
        project = root.name
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", project):
            die(f"project name {project!r} is not safe for remote paths")
        hosts = load_hosts(LEGACY_HOST)
        if args.command == "pin":
            host = find_host(hosts, args.host)
            pin_host(root, host.name)
            print(f"ompup: pinned {project} to {host.name}")
            return
        if args.command == "unpin":
            unpin_host(root)
            print(f"ompup: removed host pin for {project}")
            return
        if args.command == "doctor":
            run_doctor(root, project, args)
            return

        choice, _, remote_dir, session, state_key = host_context(
            root,
            project,
            args.host,
            args.profile,
            persist=args.command != "status",
        )
        profile = project_profile(root, args.profile)
        identity, origin = project_identity(root)
        print_banner(root, project, choice, profile)
        if getattr(args, "cmux", False):
            open_cmux(root, project, choice.host.name, args.command)
            return
        if args.command == "handoff":
            handoff_session(
                root,
                project,
                remote_dir,
                session,
                state_key,
                identity,
                origin,
                choice,
                args,
            )
            return
        if args.command == "status":
            show_status(root, state_key, remote_dir, identity, session)
            return
        if args.command == "pull":
            sync_down(root, project, state_key, remote_dir, identity)
            return
        if args.command == "sync":
            sync_up(root, project, state_key, remote_dir, identity, origin)
            return

        if choice.probe.project_exists and choice.probe.session_exists:
            print("ompup: existing tmux session found; attaching without changing its checkout")
        else:
            sync_up(root, project, state_key, remote_dir, identity, origin)
        attach(session, remote_dir, "" if args.command == "shell" else LAUNCH)
    except HostSelectionError as error:
        die(str(error))


if __name__ == "__main__":
    main()
