{
  "name": "ompup",
  "version": "0.2.0",
  "description": "Explicit local/remote handoff for Oh My Pi sessions",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/wolfiesch/ompup.git" },
  "type": "module",
  "files": ["bin/ompup", "extension/index.ts", "CHANGELOG.md", "LICENSE", "README.md"],
  "bin": { "ompup": "./bin/ompup" },
  "omp": { "extensions": ["./extension/index.ts"] },
  "keywords": ["oh-my-pi", "omp", "tmux", "ssh", "rsync", "remote-development"],
  "scripts": { "typecheck": "tsc --noEmit", "test:extension": "bun test tests/extension.test.ts" },
  "peerDependencies": { "@oh-my-pi/pi-coding-agent": ">=17.3.4" },
  "devDependencies": { "@oh-my-pi/pi-coding-agent": "17.3.4", "@oh-my-pi/pi-tui": "17.3.4", "@types/bun": "1.3.14", "typescript": "5.9.3" },
  "engines": { "bun": ">=1.3.14" },
  "packageManager": "bun@1.3.14"
}
