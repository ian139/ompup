#!/bin/sh
set -eu
cwd=$(pwd -P)
if [ "${OMPUP_FAKE_CP_REPLACE_CONTAINER:-0}" = 1 ] && [ ! -e "$OMPUP_FAKE_CP_REPLACE_STAMP" ]; then
  replace_kind=${OMPUP_FAKE_CP_REPLACE_KIND:-candidate}
  case "$cwd" in
    */.ompup-"$replace_kind"-*/tree)
      container=${cwd%/tree}
      displaced="$container.displaced"
      : > "$OMPUP_FAKE_CP_REPLACE_STAMP"
      /bin/mv "$container" "$displaced"
      ln -s "$OMPUP_FAKE_CP_REPLACE_TARGET" "$container" ;;
  esac
fi
case "$cwd" in
  */.ompup-backup-*/tree)
    if [ -n "${OMPUP_FAKE_MV_MUTATE_BEFORE_BACKUP:-}" ]; then
      printf 'concurrent\n' > "$OMPUP_FAKE_MV_MUTATE_BEFORE_BACKUP"
    fi
    /bin/cp "$@"
    [ "${OMPUP_FAKE_CP_FAIL_AFTER_BACKUP:-0}" != 1 ] || exit 99
    exit 0 ;;
esac
exec /bin/cp "$@"
